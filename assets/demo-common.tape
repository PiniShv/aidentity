# The settings both demos share. assets/record-demo.sh puts these lines in
# front of each tape before it records, so a tape holds only what is its own:
# its output file, its font size and its steps.

Set Shell bash
Set FontFamily "ui-monospace, Menlo"
Set LineHeight 1.3
Set Width 1280
Set Height 800
Set Padding 48
Set Framerate 30
Set CursorBlink false
Set Theme { "name": "aidentity", "background": "#161617", "foreground": "#F5F5F7", "cursor": "#F5F5F7", "black": "#161617", "red": "#FF453A", "green": "#30D158", "yellow": "#FFD60A", "blue": "#2997FF", "magenta": "#FF9F0A", "cyan": "#64D2FF", "white": "#F5F5F7", "brightBlack": "#98989D", "brightRed": "#FF453A", "brightGreen": "#30D158", "brightYellow": "#FFD60A", "brightBlue": "#64B5FF", "brightMagenta": "#FF9F0A", "brightCyan": "#64D2FF", "brightWhite": "#FFFFFF" }
Set TypingSpeed 40ms
