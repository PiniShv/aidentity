"""Optional, loopback-only dashboard; all operations use the existing CLI."""
import argparse
import hmac
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import mimetypes
import os
from pathlib import Path
import re
import secrets
import signal
import subprocess
import sys
import threading
from urllib.parse import urlsplit


MAX_BODY = 5 * 1024 * 1024
MAX_DOCUMENT = 4 * 1024 * 1024
MAX_OUTPUT = 4 * 1024 * 1024
ANSI = re.compile(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07]*(?:\x07|\x1b\\))")
URL_CREDENTIALS = re.compile(r"\b([a-zA-Z][a-zA-Z0-9+.-]{0,31}://)[^\s/\"']*@")
PROXY_ARGUMENT = re.compile(r"(--proxy-server=)([^\s\"']+)")


class RequestError(Exception):
    def __init__(self, message, status=400):
        super().__init__(message)
        self.status = status


def text(value, field, maximum=1024, option_value=False, allow_path=False):
    if not isinstance(value, str) or not value or len(value) > maximum:
        raise RequestError(field + " must be nonempty text within the size limit.")
    if any(ord(ch) < 32 or 127 <= ord(ch) <= 159 for ch in value):
        raise RequestError(field + " contains a control character.")
    if not option_value and value.startswith("-"):
        raise RequestError(field + " cannot begin with a dash.")
    # The CLI recognizes these tokens globally, even as an option's value.
    if value in ("-h", "--help"):
        raise RequestError(field + " cannot be a help option.")
    if not allow_path and ("/" in value or "\\" in value):
        raise RequestError(field + " cannot contain a path separator.")
    return value


def flag(payload, key):
    value = payload.get(key, False)
    if type(value) is not bool:
        raise RequestError(key + " must be true or false.")
    return value


def redact(value, hidden=()):
    value = ANSI.sub("", value)
    for secret_value in sorted(set(hidden), key=len, reverse=True):
        if secret_value:
            value = value.replace(secret_value, "[hidden]")
    value = URL_CREDENTIALS.sub(r"\1[hidden]@", value)

    def proxy(match):
        segments = []
        for segment in match[2].split(";"):
            if "@" in segment:
                prefix = ""
                if "=" in segment:
                    prefix, segment = segment.split("=", 1)
                    prefix += "="
                if "://" in segment:
                    scheme, segment = segment.split("://", 1)
                    prefix += scheme + "://"
                segment = prefix + "[hidden]@" + segment.rsplit("@", 1)[1]
            segments.append(segment)
        return match[1] + ";".join(segments)

    return PROXY_ARGUMENT.sub(proxy, value)


def parse_port(value):
    try:
        port = int(value)
    except (TypeError, ValueError):
        raise argparse.ArgumentTypeError("port must be a number from 0 to 65535")
    if not 0 <= port <= 65535:
        raise argparse.ArgumentTypeError("port must be a number from 0 to 65535")
    return port


def terminate(process):
    """Give the CLI's rollback traps time to run before forcing cancellation."""
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        pass
    # A child may ignore TERM even after the CLI itself has exited.
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def same_user_peer(peer, local):
    """Verify the client-side TCP endpoint belongs to this macOS account.

    Loopback restricts the network address, but other users of this Mac can
    still connect. The reverse endpoint is owned by this server, so accepting
    its UID would accidentally authorize every local user.
    """
    if sys.platform != "darwin" or peer[0] != "127.0.0.1" or local[0] != "127.0.0.1":
        return False
    forward = "n{}:{}->{}:{}".format(peer[0], peer[1], local[0], local[1])
    try:
        result = subprocess.run(
            ["/usr/sbin/lsof", "-nP", "-a", "-iTCP:" + str(peer[1]),
             "-sTCP:ESTABLISHED", "-Fpun"],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            text=True, timeout=2, shell=False, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return False
    if result.returncode != 0 or len(result.stdout) > MAX_OUTPUT:
        return False
    uid = None
    matches = set()
    for field in result.stdout.splitlines():
        if field.startswith("p"):
            uid = None
        elif field.startswith("u"):
            value = field[1:]
            uid = int(value) if value.isascii() and value.isdecimal() else None
        elif field == forward:
            if uid is None:
                return False
            matches.add(uid)
    return matches == {os.getuid()}


class Dashboard:
    def __init__(self, cli, env=None, timeout=120):
        self.cli = os.path.abspath(cli)
        self.env = dict(os.environ if env is None else env)
        self.timeout = timeout
        self.csrf_token = secrets.token_urlsafe(32)
        self.lock = threading.RLock()
        self.process_lock = threading.Lock()
        self.processes = set()
        self.stopped = False

    def stop(self):
        """A terminal interrupt must also stop detached CLI operations."""
        with self.process_lock:
            self.stopped = True
            active = list(self.processes)
        for process in active:
            terminate(process)

    def run(self, argv, stdin=None):
        """Bound output and kill the complete CLI process group on timeout."""
        try:
            with self.process_lock:
                if self.stopped:
                    return {"ok": False, "exit_code": None, "stdout": "", "stderr": "",
                            "error": "The dashboard is shutting down."}
                process = subprocess.Popen(
                    [self.cli] + argv, stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL,
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=self.env,
                    start_new_session=True, shell=False)
                self.processes.add(process)
        except OSError:
            return {"ok": False, "exit_code": None, "stdout": "", "stderr": "",
                    "error": "Could not start aidentity. Restart the dashboard from an installed CLI."}
        chunks = [bytearray(), bytearray()]
        overflow = threading.Event()

        def stop():
            terminate(process)

        def collect(pipe, index):
            try:
                while True:
                    piece = pipe.read(8192)
                    if not piece:
                        break
                    room = MAX_OUTPUT - len(chunks[index])
                    chunks[index].extend(piece[:room])
                    if len(piece) > room:
                        overflow.set()
                        stop()
                        break
            finally:
                pipe.close()

        readers = [
            threading.Thread(target=collect, args=(process.stdout, 0), daemon=True),
            threading.Thread(target=collect, args=(process.stderr, 1), daemon=True)]
        for reader in readers:
            reader.start()

        def feed():
            try:
                process.stdin.write(stdin)
                process.stdin.flush()
            except (BrokenPipeError, OSError):
                pass
            finally:
                process.stdin.close()

        writer = None
        if stdin is not None:
            writer = threading.Thread(target=feed, daemon=True)
            writer.start()
        error = None
        try:
            code = process.wait(timeout=self.timeout)
        except subprocess.TimeoutExpired:
            stop()
            code = process.wait()
            error = "The aidentity command timed out. Refresh the inventory before trying again."
        finally:
            with self.process_lock:
                self.processes.discard(process)
        for reader in readers:
            reader.join(timeout=2)
        if writer is not None:
            writer.join(timeout=2)
        if overflow.is_set():
            error = "The command produced too much output. Run it in the terminal for the full result."
        result = {"ok": code == 0 and error is None, "exit_code": code,
                  "stdout": chunks[0].decode("utf-8", errors="replace"),
                  "stderr": chunks[1].decode("utf-8", errors="replace")}
        if error:
            result["error"] = error
        return result

    def state(self):
        with self.lock:
            listing = self.run(["list", "--json"])
            apps = self.run(["__complete", "apps"])
            restorable = self.run(["__complete", "restorable"])
            version = self.run(["version"])
        errors = []
        for label, result in (("Profiles", listing), ("Installed apps", apps),
                              ("Restorable profiles", restorable), ("Version", version)):
            if not result["ok"]:
                errors.append(label + ": " + redact(result.get("error") or result["stderr"] or
                                                     "aidentity could not read this inventory."))
        profiles = []
        if listing["ok"]:
            try:
                profiles = json.loads(listing["stdout"])
                if not isinstance(profiles, list) or any(not isinstance(p, dict) for p in profiles):
                    raise ValueError()
                for profile in profiles:
                    profile["args"] = [redact(str(arg)) for arg in profile.get("args", [])]
                    # Defense in depth if an older or modified CLI returns assignments.
                    profile["env"] = [str(entry).split("=", 1)[0] for entry in profile.get("env", [])]
            except (ValueError, TypeError):
                profiles = []
                errors.append("Profiles: aidentity returned invalid profile JSON.")
        home = self.env.get("HOME", os.path.expanduser("~"))
        return {
            "ok": True, "csrf_token": self.csrf_token,
            "version": redact(version["stdout"]).strip().removeprefix("aidentity "),
            "profiles": profiles,
            "apps": [{"name": name} for name in apps["stdout"].splitlines() if name] if apps["ok"] else [],
            "restorable": [{"name": name} for name in restorable["stdout"].splitlines() if name] if restorable["ok"] else [],
            "paths": {
                "launchers": os.path.abspath(self.env.get("AIDENTITY_APPS_DIR") or os.path.join(home, "Applications")),
                "data": os.path.abspath(self.env.get("AIDENTITY_DATA_ROOT") or os.path.join(home, "Library/Application Support/aidentity/profiles")),
            }, "errors": errors,
        }

    def command(self, payload):
        if not isinstance(payload, dict):
            raise RequestError("The request must be a JSON object.")
        action = payload.get("action")
        common_settings = {"badge", "color", "no_badge", "args", "env", "own_extensions"}
        allowed = {
            "add": {"app", "profile", "main", "seed"} | common_settings,
            "set": {"name", "clear_args", "clear_env", "shared_extensions"} | common_settings,
            "open": {"name"}, "quit": {"name"}, "rename": {"name", "new_name"},
            "remove": {"name", "purge", "confirmed"},
            "restore": {"name", "all"}, "rebuild": {"name", "all"},
            "prune": {"confirmed"}, "doctor": {"fix"}, "export": set(),
            "import": {"document", "confirmed"}, "update": {"check"},
            "help": {"command"}, "completion": {"shell"},
        }
        if not isinstance(action, str) or action not in allowed:
            raise RequestError("Unknown dashboard action.")
        if set(payload) - allowed[action] - {"action"}:
            raise RequestError("The action contains an unsupported field.")
        argv = [action]
        stdin = None
        hidden = []
        if action in {"add", "set"}:
            if action == "add":
                argv.append(text(payload.get("app"), "app", maximum=4096, allow_path=True))
                main = flag(payload, "main")
                profile = payload.get("profile", "Main" if main else None)
                argv += ["--profile", text(profile, "profile", maximum=255)]
            else:
                argv.append(text(payload.get("name"), "name", maximum=255))
            if payload.get("no_badge") is True and payload.get("badge"):
                raise RequestError("Choose a badge or no badge, not both.")
            for key in ("badge", "color"):
                if key in payload:
                    argv += ["--" + key, text(payload[key], key, maximum=64, option_value=True)]
            options = ("no_badge", "seed", "main", "own_extensions") if action == "add" else (
                "no_badge", "clear_args", "clear_env", "own_extensions", "shared_extensions")
            if flag(payload, "own_extensions") and action == "set" and flag(payload, "shared_extensions"):
                raise RequestError("Choose own or shared extensions, not both.")
            for key in options:
                if flag(payload, key):
                    argv.append("--" + key.replace("_", "-"))
            for key, option in (("args", "--arg"), ("env", "--env")):
                values = payload.get(key, [])
                if not isinstance(values, list) or len(values) > 32:
                    raise RequestError(key + " must be a list of at most 32 entries.")
                for value in values:
                    value = text(value, key, option_value=True, allow_path=True)
                    if key == "env":
                        if "=" not in value:
                            raise RequestError("Each environment setting must use NAME=value.")
                        hidden.append(value.split("=", 1)[1])
                    argv += [option, value]
        elif action in {"open", "quit", "rename", "remove"}:
            argv.append(text(payload.get("name"), "name", maximum=255))
            if action == "rename":
                argv.append(text(payload.get("new_name"), "new_name", maximum=255))
            if action == "remove":
                if flag(payload, "purge"):
                    argv.append("--purge")
                if not flag(payload, "confirmed"):
                    raise RequestError("Confirm removal before continuing.")
                argv[0] = "rm"
                argv.append("--yes")
        elif action in {"restore", "rebuild"}:
            if flag(payload, "all"):
                if "name" in payload:
                    raise RequestError("Choose one profile or all profiles, not both.")
                argv.append("--all")
            else:
                argv.append(text(payload.get("name"), "name", maximum=255))
        elif action == "prune":
            if not flag(payload, "confirmed"):
                raise RequestError("Confirm pruning before continuing.")
            argv.append("--yes")
        elif action == "doctor":
            if flag(payload, "fix"):
                argv.append("--fix")
        elif action == "import":
            if not flag(payload, "confirmed"):
                raise RequestError("Confirm import before continuing.")
            document = payload.get("document")
            if isinstance(document, str):
                try:
                    document = json.loads(document)
                except ValueError:
                    raise RequestError("The import document is not valid JSON.")
            if not isinstance(document, dict):
                raise RequestError("The import document must be an exported JSON object.")
            stdin = json.dumps(document, ensure_ascii=False, allow_nan=False).encode("utf-8")
            if len(stdin) > MAX_DOCUMENT:
                raise RequestError("The import document exceeds the 4 MB limit.", 413)
            for launcher in document.get("launchers", []) if isinstance(document.get("launchers"), list) else []:
                if isinstance(launcher, dict) and isinstance(launcher.get("env"), list):
                    hidden += [value.split("=", 1)[1] for value in launcher["env"]
                               if isinstance(value, str) and "=" in value]
            argv += ["/dev/stdin", "--yes"]
        elif action == "update":
            if flag(payload, "check"):
                argv.append("--check")
        elif action == "help":
            if "command" in payload:
                argv.append(text(payload["command"], "command", maximum=64))
        elif action == "completion":
            shell = payload.get("shell")
            if shell not in ("bash", "zsh", "fish"):
                raise RequestError("Choose bash, zsh or fish.")
            argv.append(shell)
        return action, argv, stdin, hidden

    def action(self, payload):
        action, argv, stdin, hidden = self.command(payload)
        with self.lock:
            result = self.run(argv, stdin)
        result["action"] = action
        # The deliberate export download retains the CLI's complete recipe.
        if action != "export":
            result["stdout"] = redact(result["stdout"], hidden)
        result["stderr"] = redact(result["stderr"], hidden)
        return result


def make_server(dashboard, port=0, assets=None):
    registered = dict(assets or {})

    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.0"

        def setup(self):
            super().setup()
            self.connection.settimeout(10)

        def log_message(self, format, *args):
            # Request bodies, query strings and command output may contain secrets.
            pass

        def headers_safe(self, mime, length):
            self.send_header("Content-Type", mime)
            self.send_header("Content-Length", str(length))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("X-Frame-Options", "DENY")
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("Content-Security-Policy",
                             "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; "
                             "img-src 'self' data:; font-src 'self'; connect-src 'self'; "
                             "object-src 'none'; base-uri 'none'; frame-ancestors 'none'")
            self.end_headers()

        def respond(self, status, data, mime="application/json; charset=utf-8"):
            if mime.startswith("application/json"):
                body = json.dumps(data, ensure_ascii=False, allow_nan=False).encode("utf-8")
            else:
                body = data.encode("utf-8") if isinstance(data, str) else data
            self.send_response(status)
            self.headers_safe(mime, len(body))
            self.wfile.write(body)

        def check_request(self, write=False):
            current_port = self.server.server_address[1]
            hosts = {"127.0.0.1:" + str(current_port), "localhost:" + str(current_port)}
            if self.headers.get("Host", "").lower() not in hosts:
                raise RequestError("The dashboard only accepts requests for its loopback address.", 403)
            origin = self.headers.get("Origin")
            if origin is not None and origin not in {"http://" + host for host in hosts}:
                raise RequestError("Requests from another origin are not allowed.", 403)
            if self.headers.get("Sec-Fetch-Site") == "cross-site":
                raise RequestError("Requests from another website are not allowed.", 403)
            if write:
                token = self.headers.get("X-AIdentity-CSRF", "")
                if not token.isascii() or not hmac.compare_digest(token, dashboard.csrf_token):
                    raise RequestError("This dashboard session has expired. Refresh the page.", 403)

        def check_owner(self):
            if not same_user_peer(self.client_address, self.connection.getsockname()):
                raise RequestError(
                    "Open this dashboard from the same macOS account that launched aidentity. "
                    "The connection's owner could not be verified.", 403)

        def do_GET(self):
            try:
                self.check_request()
                path = urlsplit(self.path).path
                if path == "/api/state":
                    self.check_owner()
                    self.respond(200, dashboard.state())
                elif path in registered:
                    mime = "text/html" if path == "/" else mimetypes.guess_type(path)[0] or "text/plain"
                    self.respond(200, registered[path], mime + "; charset=utf-8")
                else:
                    self.respond(404, {"ok": False, "error": "This dashboard page does not exist."})
            except RequestError as exc:
                self.respond(exc.status, {"ok": False, "error": str(exc)})
            except (BrokenPipeError, ConnectionResetError):
                pass
            except Exception:
                self.respond(500, {"ok": False, "error": "Could not read the dashboard inventory."})

        def do_POST(self):
            try:
                self.check_request(write=True)
                if urlsplit(self.path).path != "/api/action":
                    raise RequestError("This dashboard action endpoint does not exist.", 404)
                self.check_owner()
                if self.headers.get("Content-Type", "").split(";", 1)[0].strip().lower() != "application/json":
                    raise RequestError("Actions require application/json.", 415)
                if self.headers.get("Transfer-Encoding"):
                    raise RequestError("Transfer encoding is not supported.")
                try:
                    length = int(self.headers.get("Content-Length", ""))
                except ValueError:
                    raise RequestError("A valid Content-Length is required.")
                if length < 1:
                    raise RequestError("The request body is empty.")
                if length > MAX_BODY:
                    raise RequestError("The request body is too large.", 413)
                body = self.rfile.read(length)
                if len(body) != length:
                    raise RequestError("The request body was incomplete.")
                try:
                    payload = json.loads(body.decode("utf-8"),
                                         parse_constant=lambda value: (_ for _ in ()).throw(ValueError()))
                except (ValueError, UnicodeError):
                    raise RequestError("The request body is not valid JSON.")
                self.respond(200, dashboard.action(payload))
            except RequestError as exc:
                self.respond(exc.status, {"ok": False, "error": str(exc)})
            except (BrokenPipeError, ConnectionResetError):
                pass
            except TimeoutError:
                self.respond(408, {"ok": False, "error": "The request body timed out."})
            except Exception:
                self.respond(500, {"ok": False, "error": "Could not complete the dashboard action."})

        def do_OPTIONS(self):
            self.respond(405, {"ok": False, "error": "Cross-origin requests are not supported."})

    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    server.daemon_threads = True
    return server


def main(argv=None, assets=None):
    parser = argparse.ArgumentParser(description="Run the optional aidentity localhost dashboard.")
    parser.add_argument("cli", help="Path to the installed aidentity executable")
    parser.add_argument("--port", type=parse_port, default=0)
    parser.add_argument("--no-open", action="store_true")
    options = parser.parse_args(argv)
    if not os.path.isfile(options.cli) or not os.access(options.cli, os.X_OK):
        parser.error("the aidentity executable is not available")
    if assets is None:
        assets = globals().get("ASSETS")
    if assets is None:
        folder = Path(__file__).resolve().parent
        assets = {"/": (folder / "index.html").read_text(encoding="utf-8")}
        for filename in ("app.js", "styles.css", "experience.js", "experience.css"):
            if (folder / filename).is_file():
                assets["/" + filename] = (folder / filename).read_text(encoding="utf-8")
    try:
        dashboard = Dashboard(options.cli)
        server = make_server(dashboard, options.port, assets)
    except OSError:
        parser.exit(1, "The dashboard port is unavailable. Choose another --port or use --port 0.\n")
    url = "http://127.0.0.1:" + str(server.server_address[1])
    print("aidentity dashboard: " + url, flush=True)
    print("Keep this terminal open. Press Ctrl-C to stop the dashboard.", flush=True)
    if not options.no_open:
        try:
            subprocess.run(["open", url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=10, check=False)
        except (OSError, subprocess.TimeoutExpired):
            print("Open the dashboard address above in your browser.", flush=True)
    try:
        server.serve_forever(poll_interval=0.25)
    except KeyboardInterrupt:
        print("\nDashboard stopped.", flush=True)
    finally:
        dashboard.stop()
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
AIDENTITY_DASHBOARD_PY
}

# ---------------------------------------------------------- command table --

# Every command, one row each:
#
#   name | other spellings | its first argument | options | summary
#
# The first argument is apps, launchers, restorable, shells or commands (what
# Tab offers for it), or - for none. An option lists its spellings joined by /,
# the one Tab offers first, and ends in = when it takes the next word as its
# value. A name that starts with __ is hidden: it has no help page and is never
# listed or offered by Tab, but it and its other spellings still run, and a -h
# or --help after it is not read as a request for help. Dispatch, help, the
# overview and completion all read this table, so a command, spelling or option
# added here reaches all of them. The command runs as the function cmd_ and its
# name, without the __: cmd_add, cmd_overview.
COMMANDS='setup|init wizard|-||Guided walkthrough that sets up accounts (start here)
ui||-||Full-screen menu over your profiles
dashboard||-|--port= --no-open|Open the visual account manager in your browser
add||apps|--profile/-p= --badge/-b= --color/--colour/-c= --no-badge --seed --main --arg= --env= --own-extensions|Create a profile for an app
list|ls|-|--json|Show every profile and what is running
open||launchers||Open a profile
quit||launchers||Quit one profile; other copies of the app keep running
rename|mv|launchers||Rename a profile and keep it signed in
set|modify edit|launchers|--badge/-b= --color/--colour/-c= --no-badge --arg= --env= --clear-args --clear-env --own-extensions --shared-extensions|Change how a profile looks or starts
prune||-|--yes/-y|Move profile data that no launcher uses to the Trash
restore||restorable|--all/-a|Rebuild a launcher that was deleted
rebuild|repair|launchers|--all/-a|Rebuild launchers after an app moved or updated
rm|remove delete|launchers|--purge --yes/-y|Remove a launcher
export||-||Print every launcher as JSON, for import
import||-|--yes/-y|Build launchers from a file made by export
apps||-||List apps that can have extra accounts
doctor||-|--fix|Check the setup and every profile
update||-|--check|Install the latest release
completion||shells||Print a tab-completion script
version|--version -v|-||Print the version
help||commands||Show help for all commands or for one
__overview|-h --help|-||List every command
__complete||-||Print what Tab can offer'

# command_row WORD: find the row whose name or other spelling is WORD, and set
# CMD_NAME, CMD_ALIASES, CMD_ARG, CMD_OPTS and CMD_SUMMARY from it. Returns 1,
# with all five empty, when there is none.
command_row() {
  local w
  while IFS='|' read -r CMD_NAME CMD_ALIASES CMD_ARG CMD_OPTS CMD_SUMMARY; do
    for w in "$CMD_NAME" $CMD_ALIASES; do
      [ "$1" = "$w" ] && return 0
    done
  done <<EOF
$COMMANDS
EOF
  CMD_NAME=""; CMD_ALIASES=""; CMD_ARG=""; CMD_OPTS=""; CMD_SUMMARY=""
  return 1
}

# The words that name a command, a line each: the word, a tab and what it does.
# Every name and other spelling that is not hidden, or with "-" only those that
# start with a dash. Another spelling is "Same as" its command, unless that
# command is hidden.
command_words() {
  local n a p o s d w
  while IFS='|' read -r n a p o s; do
    d="$s"
    for w in $n $a; do
      case "$w:${1:-}" in
        __*) ;;
        -*:-|[!-]*:) printf '%s\t%s\n' "$w" "$d" ;;
      esac
      case "$n" in __*) ;; *) d="Same as $n" ;; esac
    done
  done <<EOF
$COMMANDS
EOF
}

# --------------------------------------------------------- command help --

# The help of one command, by its name. The first line, the "Also spelled"
# line and the -h, --help line come from the command table; help_text has the
# rest. "Also spelled" goes before the first OPTIONS, EXAMPLES or SET UP
# heading. The -h, --help line closes the OPTIONS block, at its first blank
# line, so an OPTIONS block must have no blank line inside and one after it. A
# page with no OPTIONS gets a short one, so every page has the -h line.
command_help() {
  local line also="" w stage=0 h='  -h, --help           Show this help'
  command_row "$1" || return 1
  for w in $CMD_ALIASES; do also="${also:+$also, }$w"; done
  printf '%saidentity %s%s — %s\n\n' "$C_BOLD" "$CMD_NAME" "$C_RESET" "$CMD_SUMMARY"
  while IFS= read -r line; do
    case "$stage:$line" in
      0:OPTIONS|0:EXAMPLES|"0:SET UP")
        [ -z "$also" ] || printf 'Also spelled: %s\n\n' "$also"
        printf '%sOPTIONS%s\n' "$C_BOLD" "$C_RESET"
        stage=1
        [ "$line" = OPTIONS ] && continue
        printf '%s\n\n' "$h"; stage=2 ;;
      1:) printf '%s\n' "$h"; stage=2 ;;
    esac
    case "$line" in
      USAGE|OPTIONS|EXAMPLES|"SET UP") printf '%s%s%s\n' "$C_BOLD" "$line" "$C_RESET" ;;
      *) printf '%s\n' "$line" ;;
    esac
  done <<EOF
$(help_text "$CMD_NAME")
EOF
}

# What each command's help says beyond the command table: usage, what it does,
# its options and examples.
help_text() {
  case "$1" in
    dashboard) cat <<'EOF'
USAGE
  aidentity dashboard [options]

Starts the visual account manager at 127.0.0.1 and opens your browser. It uses
the same profiles and operations as the CLI. Keep this terminal open; Ctrl+C
stops the server. The server is reachable only from this Mac.

Python 3.9 or newer is required for the dashboard. No Python packages are
needed. Other aidentity commands work without Python.

OPTIONS
  --port PORT         Port from 0 to 65535 (default: 0, choose a free port)
  --no-open           Print the address without opening a browser

EXAMPLES
  aidentity dashboard
  aidentity dashboard --port 8765
  aidentity dashboard --no-open
EOF
    ;;
    setup) cat <<'EOF'
USAGE
  aidentity setup

Asks which app to use and what to call each account, then builds all the
launchers in one pass. It needs a terminal. Without one, use 'aidentity add'.

EXAMPLES
  aidentity setup
EOF
    ;;
    add) cat <<'EOF'
USAGE
  aidentity add [APP] [options]

APP is the name of an installed Chromium or Electron app, such as Claude, or the
path to its .app. Run 'aidentity apps' to see which apps work. With no APP or no
--profile, add asks for them. That needs a terminal.

OPTIONS
  -p, --profile NAME   Name for this account, e.g. Work
  -b, --badge X        One character for the icon badge (default: first letter)
  -c, --color NAME     Badge colour: blue green orange purple teal pink red
                       yellow gray graphite, or a hex value like 2E7DF6
  --no-badge           Use the app's own icon, with your name
  --seed               Copy Claude Desktop's MCP server config into the profile
  --main               Build a launcher for your ORIGINAL account (name: Main).
                       While a profile runs, macOS treats it as the app, so
                       the app's own icon only switches to that profile.
  --arg SWITCH         Pass a switch on every launch: a proxy, language,
                       display scale or GPU switch. Repeat to add more.
  --env NAME=VALUE     Set a proxy variable, LANG, LC_ALL, LC_CTYPE, LC_MESSAGES
                       or TZ on every launch. Repeat to add more.
  --own-extensions     VS Code, Cursor, Kiro: a separate extensions folder

EXAMPLES
  aidentity add Claude --profile Work
  aidentity add Claude --profile Work --color blue --seed
  aidentity add Claude --main
EOF
    ;;
    rename) cat <<'EOF'
USAGE
  aidentity rename OLD NEW

OLD is the launcher name that 'aidentity list' shows. NEW is the new profile
name, without the app name. The profile's data folder moves with it, so the
account stays signed in. It stops if the profile is running.

EXAMPLES
  aidentity rename "Claude Work" Client
EOF
    ;;
    set) cat <<'EOF'
USAGE
  aidentity set NAME [options]

NAME is the launcher name that 'aidentity list' shows. Give at least one option.
The account and its data are not touched.

OPTIONS
  -c, --color NAME     New badge colour
  -b, --badge X        New badge character
  --no-badge           Use the app's own icon, unchanged
  --arg SWITCH         Add a launch switch, as on add (repeatable)
  --env NAME=VALUE     Add a launch variable, as on add (repeatable)
  --clear-args         Remove every launch switch
  --clear-env          Remove every launch variable
  --own-extensions     VS Code, Cursor, Kiro: a separate extensions folder
  --shared-extensions  Go back to the app's own extensions folder

EXAMPLES
  aidentity set "Claude Work" --color purple
  aidentity set "Claude Work" --arg --lang=de
EOF
    ;;
    prune) cat <<'EOF'
USAGE
  aidentity prune [options]

Finds profile folders that no launcher points at. They are left when a launcher
is deleted in Finder, or removed with 'rm' without --purge. It lists them, asks
first, then moves them to the Trash. To keep an account instead, rebuild its
launcher with 'aidentity restore': this works for the folders the list marks
"can be restored". For one without that mark, add the profile again with the
same app and profile name, and add uses the folder. A folder moved back from
the Trash comes back in the same way.

OPTIONS
  -y, --yes            Skip the confirmation prompt

EXAMPLES
  aidentity prune
EOF
    ;;
    restore) cat <<'EOF'
USAGE
  aidentity restore [NAME | --all]

Each profile folder keeps a small record of its launcher. restore reads it and
rebuilds the launcher, still signed in. With no NAME and no --all, it lists the
profiles that can be restored.

OPTIONS
  -a, --all            Restore every one of them

EXAMPLES
  aidentity restore
  aidentity restore "Claude Work"
  aidentity restore --all
EOF
    ;;
    rebuild) cat <<'EOF'
USAGE
  aidentity rebuild NAME
  aidentity rebuild --all

Writes the launcher again from what it records. Profile data is not touched,
so every account stays signed in.

OPTIONS
  -a, --all            Rebuild every profile

EXAMPLES
  aidentity rebuild "Claude Work"
  aidentity rebuild --all
EOF
    ;;
    list) cat <<'EOF'
USAGE
  aidentity list [options]

For each profile it shows the app, the profile name, where its data lives and
its status: running, in use, signed out / new, app missing or not running.

OPTIONS
  --json               Print one JSON array instead, with an object for each
                       launcher, for scripts. Variables are listed by name,
                       never by value.

EXAMPLES
  aidentity list
  aidentity ls --json
EOF
    ;;
    open) cat <<'EOF'
USAGE
  aidentity open NAME

NAME is the launcher name that 'aidentity list' shows. Put it in quotes when it
has a space.

EXAMPLES
  aidentity open "Claude Work"
EOF
    ;;
    quit) cat <<'EOF'
USAGE
  aidentity quit NAME

NAME is the launcher name that 'aidentity list' shows. It quits the copy of the
app that runs on that profile, and every other copy keeps running. For a main
launcher, that is the copy on your original account. The app is asked to quit
the way its Quit menu item does, so it can still ask about unsaved work. If it
does not take the request, it is sent SIGTERM, which these apps also treat as
quit. It waits up to 10 seconds, and exits 1 if the app is still running then.

Only an app is asked to quit. A process that is not an app is left alone: an
app's helpers, or a command line tool that runs the app's program, such as
'code --wait'. If only such processes still use the profile, quit names them
and exits 1, as 'aidentity list' still shows the profile as running.

EXAMPLES
  aidentity quit "Claude Work"
EOF
    ;;
    rm) cat <<'EOF'
USAGE
  aidentity rm NAME [options]

Removes the launcher and keeps its data, so 'aidentity restore' can bring it
back. It asks you to type yes first. It stops if the profile is running, and it
only removes launchers that aidentity built.

OPTIONS
  --purge              Also move the profile's data to the Trash. To undo, move
                       it back and run 'aidentity restore'. A main launcher
                       has no profile data, so nothing more is moved for it.
  -y, --yes            Skip the confirmation prompt

EXAMPLES
  aidentity rm "Claude Work"
  aidentity rm "Claude Work" --purge
EOF
    ;;
    export) cat <<'EOF'
USAGE
  aidentity export

Prints every launcher as JSON: its app (by bundle ID), profile name, badge,
colour and launch settings. Save it to a file and give that file to
'aidentity import', on this Mac or another, to build the launchers again. The
file holds no account data and no folder paths, so no account goes with it.
It does hold the launch settings in full. A proxy setting can carry a user
name and password, in a variable or in a switch such as --proxy-server, so
export warns when the file holds a variable's value or a switch with a user
name in it. Keep the file private.

EXAMPLES
  aidentity export > profiles.json
EOF
    ;;
    import) cat <<'EOF'
USAGE
  aidentity import FILE [options]

FILE is a file made by 'aidentity export'. import finds each launcher's app by
its bundle ID among the apps installed here, and checks every value as add
does. It shows what it will create and what it skips and why, then asks you
to type yes. A launcher that exists already is skipped, never changed. A new
profile starts signed out, unless its profile folder is still here: then it
uses that folder, as add does, and the plan says so. A file may list up to 200
launchers.

The launch settings, such as a proxy, come from the file. The plan shows each
new launcher's switches, the server each proxy variable names (never a
password), and its other variables by name. Check them when the file is from
someone else: a proxy setting sends that profile's traffic through the server
it names. A launcher that lists a setting twice is skipped.

OPTIONS
  -y, --yes            Skip the confirmation prompt

EXAMPLES
  aidentity import profiles.json
  aidentity import profiles.json --yes
EOF
    ;;
    apps) cat <<'EOF'
USAGE
  aidentity apps

Lists the Chromium and Electron apps found in /Applications and ~/Applications.
Only these apps can run more than one account.

EXAMPLES
  aidentity apps
EOF
    ;;
    doctor) cat <<'EOF'
USAGE
  aidentity doctor [options]

Shows the macOS, aidentity and bash versions, whether the launcher folder can be
written, and any problem it finds in a profile. It only reports, unless you give
--fix.

OPTIONS
  --fix                Repair what can be repaired: rebuild stale launchers
                       and make profile folders owner-only

EXAMPLES
  aidentity doctor
  aidentity doctor --fix
EOF
    ;;
    update) cat <<'EOF'
USAGE
  aidentity update [options]

Asks GitHub for the latest release. If it is newer, downloads it, checks it
against the release's checksum, and replaces this copy in one step. This is the
only command that uses the network, and only when you run it. It never uses
sudo. A copy installed with Homebrew is updated with: brew upgrade aidentity

OPTIONS
  --check              Only say whether a newer release is out

EXAMPLES
  aidentity update --check
  aidentity update
EOF
    ;;
    ui) cat <<'EOF'
USAGE
  aidentity ui

A full-screen menu in Terminal: every profile, what is running, and keys to
open, stop (quit a profile), add, rename, recolour, change the badge, remove,
and run doctor. Each key runs the same command you would type, with the same
checks. It needs a terminal; in a script, use the commands themselves or
aidentity list --json. Press ? in the menu for its keys, and q to leave.

EXAMPLES
  aidentity ui
EOF
    ;;
    completion) cat <<'EOF'
USAGE
  aidentity completion SHELL

SHELL is bash, zsh or fish. The script goes to standard output. It completes
commands, options, profile names, app names and colours. A name with a space
is quoted for you. Homebrew installs these scripts for you.

SET UP
  bash   eval "$(aidentity completion bash)"     in ~/.bashrc
  zsh    eval "$(aidentity completion zsh)"      in ~/.zshrc, after compinit
  fish   aidentity completion fish | source      in ~/.config/fish/config.fish

EXAMPLES
  aidentity completion zsh
EOF
    ;;
    version) cat <<'EOF'
USAGE
  aidentity version

EXAMPLES
  aidentity version
EOF
    ;;
    help) cat <<'EOF'
USAGE
  aidentity help [COMMAND]
  aidentity COMMAND --help

With no COMMAND it shows every command. With one it shows that command's
options and examples. aidentity -h and aidentity --help show the same overview
as aidentity help, and ignore what comes after them. After a command, -h or
--help shows that command's help and does nothing else.

EXAMPLES
  aidentity help
  aidentity help rm
  aidentity rm --help
EOF
    ;;
  esac
}

# aidentity help [command]
cmd_help() {
  [ $# -le 1 ] || die "Usage: aidentity help [command]"
  if [ $# -eq 0 ]; then cmd_overview; return 0; fi
  command_row "$1" && [ "${CMD_NAME#__}" = "$CMD_NAME" ] \
    || die "No help for '$1'. Run 'aidentity help' to see the commands."
  command_help "$CMD_NAME"
}

# aidentity on its own, aidentity help, -h and --help: every command in a line.
cmd_overview() {
  local n a p o s
  cat <<EOF
${C_BOLD}aidentity${C_RESET} — run several accounts of the same Mac app at the same time.

${C_BOLD}USAGE${C_RESET}
  aidentity <command> [options]

${C_BOLD}COMMANDS${C_RESET}
EOF
  while IFS='|' read -r n a p o s; do
    case "$n" in __*) ;; *) printf '  %-12s %s\n' "$n" "$s" ;; esac
  done <<EOF
$COMMANDS
EOF
  cat <<EOF

Run 'aidentity help COMMAND' or 'aidentity COMMAND --help' for its options.

${C_BOLD}EXAMPLES${C_RESET}
  aidentity setup
  aidentity ui
  aidentity add Claude --profile Work --color blue --seed
  aidentity add ChatGPT --profile Personal
  aidentity add Claude --main
  aidentity list
  aidentity quit "Claude Work"
  aidentity rename "Claude Work" Client
  aidentity set "Claude Work" --color purple
  aidentity rebuild --all
  aidentity doctor --fix
  aidentity restore "Claude Work"
  aidentity prune
  aidentity rm "Claude Work" --purge
  aidentity export > profiles.json
  aidentity help rm
  aidentity completion zsh
  aidentity update --check

${C_BOLD}ENVIRONMENT${C_RESET}
  AIDENTITY_APPS_DIR    Where launchers are written (default: ~/Applications)
  AIDENTITY_DATA_ROOT   Where profile data lives (default:
                        ~/Library/Application Support/aidentity/profiles)
  AIDENTITY_APP_DIRS    Folders searched for apps, colon-separated
                        (default: /Applications:~/Applications)

${C_BOLD}HOW IT WORKS${C_RESET}
  Chromium and Electron apps keep their single-instance lock inside their data
  directory. Point a second instance at a different directory and the two never
  see each other's lock, so both run at once — each signed into its own account.

  aidentity builds a small launcher app that does exactly that. Your real app is
  never copied, patched or re-signed, so its signature, keychain access and
  auto-update all keep working.

${C_BOLD}MORE${C_RESET}
  https://github.com/PiniShv/aidentity
EOF
}

# -------------------------------------------------------------- completion --

# `aidentity __complete SHELL CWORD WORD...` prints what Tab can offer for the
# words typed so far, in the form SHELL's script reads (see complete_words).
# `aidentity __complete WHAT` prints the names of one kind (launchers,
# restorable or apps), the form that scripts saved from 1.4.0 use. The scripts
# call it on every Tab, so it prints nothing on stderr and always exits 0,
# whatever is wrong with the folders it reads.
cmd_complete() {
  case "${1:-}" in
    bash|zsh|fish) ( complete_words "$@" ) 2>/dev/null ;;
    *) ( complete_candidates "${1:-}" ) 2>/dev/null ;;
  esac
  return 0
}

complete_candidates() {
  local app name dir label i=0
  case "$1" in
    launchers)   # the names open, rm, set, rename and rebuild take
      launcher_rows names
      while [ "$i" -lt "$LR_N" ]; do
        case "${LR_NAME[$i]}" in *[[:cntrl:]]*) ;; *) printf '%s\n' "${LR_NAME[$i]}" ;; esac
        i=$((i + 1))
      done ;;
    restorable)  # the names restore takes: profiles whose launcher is gone
      while IFS= read -r dir; do
        [ -n "$dir" ] || continue
        label=$(restore_label "$dir") || continue
        printf '%s\n' "$label"
      done <<EOF
$(orphan_dirs)
EOF
      ;;
    apps)        # the names add takes
      while IFS= read -r app; do
        [ -n "$app" ] || continue
        name=$(bundle_name "$app")
        case "$name" in *[[:cntrl:]]*) continue ;; esac
        printf '%s\n' "$name"
      done <<EOF | awk '!seen[$0]++'
$(list_compatible_apps)
EOF
      ;;
  esac
}

# complete_words SHELL CWORD WORD...: what Tab can offer. WORD 0 is the name
# aidentity was typed as, and CWORD is the index of the word under the cursor.
# It turns another spelling into its command, skips the value of an option,
# then offers a command, an option, a colour or the command's first argument,
# all from the command table. bash gets the words that match, quoted for it.
# zsh gets "describe" or "plain" on the first line, then every candidate, as
# word:description after describe. fish gets every candidate, with a tab and
# its description when it has one. zsh and fish match the typed word
# themselves, so their own matching rules (ignoring case, say) keep working.
complete_words() {
  local shell="$1" cword="$2" cur w x i=2 npos=0 valopt="" values="" list="" mode=plain n a p o s
  local -a words
  shift 2
  case "$cword" in ''|*[!0-9]*) return 0 ;; esac
  words=("$@")
  cur="${words[cword]:-}"
  if [ "$cword" -le 1 ]; then
    mode=describe
    case "$cur" in -*) list=$(command_words -) ;; *) list=$(command_words) ;; esac
  elif command_row "${words[1]:-}" && [ "${CMD_NAME#__}" = "$CMD_NAME" ]; then
    # Count the arguments typed so far. The value of an option is not one.
    while IFS='|' read -r n a p o s; do
      for x in $o; do case "$x" in *=) values="$values/${x%=}" ;; esac; done
    done <<EOF
$COMMANDS
EOF
    values="${values//\// } "
    while [ "$i" -lt "$cword" ]; do
      w="${words[i]:-}"
      case "$values" in
        *" $w "*) [ $((i + 1)) -eq "$cword" ] && valopt="$w"; i=$((i + 1)) ;;
        *) case "$w" in -*) ;; *) npos=$((npos + 1)) ;; esac ;;
      esac
      i=$((i + 1))
    done
    if [ -n "$valopt" ]; then
      # Of all the values, only a colour has a list to offer.
      for x in $CMD_OPTS; do
        case "$x" in --color/*) ;; *) continue ;; esac
        # shellcheck disable=SC2086  # a fixed list of words, split on purpose
        case "/${x%=}/" in *"/$valopt/"*) list=$(printf '%s\n' $COLOR_NAMES) ;; esac
      done
    elif [ "${cur#-}" != "$cur" ]; then
      list=$(for x in $CMD_OPTS --help; do printf '%s\n' "${x%%[/=]*}"; done)
    elif [ "$npos" -eq 0 ]; then
      case "$CMD_ARG" in
        apps|launchers|restorable) list=$(complete_candidates "$CMD_ARG") ;;
        shells) list=$(printf '%s\n' bash zsh fish) ;;
        commands) list=$(command_words) ;;
      esac
    fi
  fi
  case "$shell" in
    bash) complete_bash_reply "$cur" <<EOF
$list
EOF
      return 0 ;;
    zsh) printf '%s\n' "$mode" ;;
  esac
  while IFS="$TAB" read -r w x; do
    [ -n "$w" ] || continue
    case "$shell:$mode" in
      zsh:describe) printf '%s:%s\n' "$w" "$x" ;;
      zsh:*) printf '%s\n' "$w" ;;
      *) printf '%s%s\n' "$w" "${x:+$TAB$x}" ;;
    esac
  done <<EOF
$list
EOF
}

# complete_bash_reply WORD: of the candidates on stdin (a line each, maybe with
# a tab and a description), print those that start with WORD, quoted for bash.
# When WORD starts with a quote mark, a name is escaped for that quote instead,
# so a $ or a quote mark in a folder name is never read by the shell as code.
complete_bash_reply() {
  local word="$1" line quote=""
  case "$word" in
    \"*) quote='"'; word="${word#\"}" ;;
    \'*) quote="'"; word="${word#\'}" ;;
    *)   word="${word//\\/}" ;;
  esac
  if [ -n "$quote" ]; then complete_unescape "$quote" "$word"; word="$REPLY"; fi
  while IFS= read -r line; do
    line="${line%%"$TAB"*}"
    [ -n "$line" ] || continue
    case "$line" in
      "$word"*)
        if [ -z "$quote" ]; then
          printf '%q\n' "$line"
        elif complete_escape "$quote" "$line"; then
          printf '%s\n' "$REPLY"
        fi ;;
    esac
  done
}

# complete_escape QUOTE TEXT: set REPLY to TEXT as it can sit inside a QUOTE
# (" or ') the user has already opened. Inside double quotes ! cannot be
# escaped, so a name with one fails (returns 1) and is left out.
complete_escape() {
  local q="$1" s="$2" c i=0
  REPLY=""
  while [ "$i" -lt "${#s}" ]; do
    c="${s:i:1}"
    if [ "$q" = "'" ]; then
      if [ "$c" = "'" ]; then c="'\\''"; fi
    else
      case "$c" in
        '!') REPLY=""; return 1 ;;
        \\|'"'|'$'|'`') c="\\$c" ;;
      esac
    fi
    REPLY="$REPLY$c"
    i=$((i + 1))
  done
}

# complete_unescape QUOTE TEXT: the reverse, for the part of the word that is
# typed already. Sets REPLY.
complete_unescape() {
  local q="$1" s="$2" c i=0 n
  REPLY=""
  while [ "$i" -lt "${#s}" ]; do
    c="${s:i:1}"
    n=$((i + 1))
    if [ "$q" = "'" ]; then
      if [ "${s:i:4}" = "'\\''" ]; then c="'"; i=$((i + 3)); fi
    elif [ "$c" = "\\" ]; then
      case "${s:n:1}" in
        \\|'"'|'$'|'`') c="${s:n:1}"; i=$n ;;
        '') c="" ;;   # a backslash with nothing after it yet
      esac
    fi
    REPLY="$REPLY$c"
    i=$((i + 1))
  done
}

# aidentity completion SHELL. The script goes to stdout. It is a short shim
# that asks `aidentity __complete` on every Tab, so it holds no list of its
# own: a new command, spelling or option reaches all three shells at once.
cmd_completion() {
  local shell=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) die "Unknown option for completion: $1" ;;
      *) [ -z "$shell" ] && shell="$1" || die "Unexpected argument: $1"; shift ;;
    esac
  done
  [ -n "$shell" ] || die "Usage: aidentity completion bash|zsh|fish"
  case "$shell" in
    bash) cat <<'EOF'
# bash completion for aidentity
#
#   eval "$(aidentity completion bash)"     # in ~/.bashrc
#
# On every Tab it asks 'aidentity __complete' what fits, already quoted for
# bash. That command is not meant to be run by hand.
_aidentity() {
  local line
  COMPREPLY=()
  while IFS= read -r line; do
    [ -n "$line" ] && COMPREPLY+=("$line")
  done <<< "$(command aidentity __complete bash "$COMP_CWORD" "${COMP_WORDS[@]}" 2>/dev/null)"
  return 0
}
complete -F _aidentity aidentity
EOF
      ;;
    zsh) cat <<'EOF'
#compdef aidentity
# zsh completion for aidentity
#
#   eval "$(aidentity completion zsh)"      # in ~/.zshrc, after compinit
#
# Or save the output as a file named _aidentity in a folder on your fpath.
# On every Tab it asks 'aidentity __complete' what fits. That command is not
# meant to be run by hand.
_aidentity() {
  local -a cands
  cands=("${(@f)$(command aidentity __complete zsh $(( CURRENT - 1 )) "${words[@]}" 2>/dev/null)}")
  case $cands[1] in
    describe) cands=("${(@)cands[2,-1]}"); _describe -t commands 'aidentity command' cands ;;
    plain) cands=("${(@)cands[2,-1]}"); compadd -a cands ;;
  esac
}

if [[ $funcstack[1] == _aidentity ]]; then
  _aidentity "$@"
else
  compdef _aidentity aidentity
fi
EOF
      ;;
    fish) cat <<'EOF'
# fish completion for aidentity
#
#   aidentity completion fish | source      # in ~/.config/fish/config.fish
#
# Or save the output as ~/.config/fish/completions/aidentity.fish.
# On every Tab it asks 'aidentity __complete' what fits. That command is not
# meant to be run by hand.
complete -c aidentity -f -a '(command aidentity __complete fish (count (commandline -opc)) (commandline -opc) (commandline -ct) 2>/dev/null)'
EOF
      ;;
    *) die "Unknown shell '$shell'. Use bash, zsh or fish." ;;
  esac
}

# -------------------------------------------------------------- dispatch --

main() {
  local a
  # No command at all is the overview, as it always was.
  if ! command_row "${1:-help}"; then
    printf '%sUnknown command: %s%s\n\n' "$C_RED" "${1:-}" "$C_RESET" >&2; cmd_overview >&2; exit 1
  fi
  [ $# -gt 0 ] && shift
  # -h or --help anywhere after a command shows that command's help and runs
  # nothing else, whatever else was typed: `rm Work --help` removes nothing.
  # This runs before the command reads its arguments. A profile name cannot
  # start with a hyphen, so no real value is ever taken for it. A hidden
  # command has no help: the overview ignores what follows it, and __complete
  # is handed the words typed so far, a -h among them.
  case "$CMD_NAME" in
    __*) ;;
    *) for a in "$@"; do
         case "$a" in -h|--help) command_help "$CMD_NAME"; return 0 ;; esac
       done ;;
  esac
  # Each command reads its own arguments and refuses what it does not take.
  # setup, apps and version take none and ignore extra words on purpose, as
  # they always have: a script that passes one keeps working.
  "cmd_${CMD_NAME#__}" "$@"
}

# Never change this line, and keep it last. Installed copies of 1.4.0 refuse
# an update that does not end on it, with their own fixed copy of the check:
# a new last line would stop all of them from updating. scripts/guards.sh
# (check 7) pins the exact text.
main "$@"
