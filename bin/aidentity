#!/usr/bin/env bash
#
# aidentity — run several accounts of the same Mac app at the same time.
#
# Builds a small launcher app per profile. The launcher opens the app you already
# have installed, pointed at its own data directory, so every account stays signed
# in simultaneously. The original app is never copied, patched or re-signed.
#
#   aidentity add                 # interactive
#   aidentity add Claude --profile Work
#   aidentity list
#   aidentity ui                  # full-screen menu
#   aidentity rm "Claude Work" --purge
#   aidentity update --check
#
# Environment (all optional):
#   AIDENTITY_APPS_DIR    where launchers are written (default: ~/Applications)
#   AIDENTITY_DATA_ROOT   where profile data lives
#                         (default: ~/Library/Application Support/aidentity/profiles)
#   AIDENTITY_APP_DIRS    colon-separated folders searched for apps
#                         (default: /Applications:~/Applications)
#   AIDENTITY_UPDATE_URL  for tests only: where `update` looks for releases
#                         instead of GitHub. HTTPS only, and always announced.
#
# The network is used by one command only: `aidentity update`, which asks
# GitHub for the latest release over HTTPS. Nothing else connects anywhere.
#
# https://github.com/PiniShv/aidentity
#
# MIT licensed. Requires macOS. No dependencies beyond what ships with the OS.

set -uo pipefail

AIDENTITY_VERSION="1.4.0"

# Every launcher we build carries this key in its Info.plist. It is the ONLY way
# we recognise our own bundles, and nothing is ever deleted without it. That makes
# `rm` safe even if a profile is named after an app you already have installed.
MARKER_KEY="AIdentityProfile"

APPS_DIR="${AIDENTITY_APPS_DIR:-$HOME/Applications}"
DATA_ROOT="${AIDENTITY_DATA_ROOT:-$HOME/Library/Application Support/aidentity/profiles}"

# Make a path absolute and drop ".", "..", "//" and a trailing "/", on paper
# only — nothing on disk is read. Both directories below are overridable, and a
# relative value was recorded verbatim in a launcher's Info.plist, where it
# later resolved against whatever directory the tool ran from. Anchoring alone
# was not enough: "../profiles" became ".../sub/../profiles", which the purge
# guard rightly refuses (no dot segments), so purge, rename and prune refused
# every profile made with it.
normpath() {
  local p="$1" out="" seg oldifs="$IFS"
  case "$p" in /*) ;; *) p="$PWD/$p" ;; esac
  IFS='/'; set -f
  for seg in $p; do
    case "$seg" in
      ''|.) ;;
      ..) out="${out%/*}" ;;
      *) out="$out/$seg" ;;
    esac
  done
  set +f; IFS="$oldifs"
  printf '%s' "${out:-/}"
}

APPS_DIR=$(normpath "$APPS_DIR")
DATA_ROOT=$(normpath "$DATA_ROOT")

# This file, as it was started, made absolute on paper. `update` replaces it.
# BASH_SOURCE, not $0: when the script arrives on stdin (`curl … | bash`), $0
# is "bash", and following that would aim the update at the shell itself.
# BASH_SOURCE is empty then, and update refuses.
SELF_PATH="${BASH_SOURCE[0]:-}"
case "$SELF_PATH" in ''|/*) ;; *) SELF_PATH="$PWD/$SELF_PATH" ;; esac

# ---------------------------------------------------------------- output --

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'
else
  C_RESET=''; C_DIM=''; C_BOLD=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_BLUE=''
fi

info() { printf '%s\n' "$*"; }
ok()   { printf '%s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }

# Ask a question and echo the answer.
#
# stdin first, so the tool behaves like every other Unix command: a terminal
# types the answer, and `printf 'yes\n' | aidentity rm …` still works.
# /dev/tty is only a fallback for when stdin is exhausted or absent — which is
# what happens if this ever runs with the script itself arriving on stdin.
# The prompt goes to stderr on purpose. Callers capture the answer with $(…),
# which swallows stdout — printing the prompt there would make it part of the
# answer ("Type yes to confirm: yes" never equals "yes").
ask() {
  local prompt="$1" reply=""
  printf '%s' "$prompt" >&2
  # `|| [ -n "$reply" ]`: read fails at end of input even after filling the
  # variable, so `printf yes | aidentity rm …` (no newline) read as "Cancelled".
  if IFS= read -r reply || [ -n "$reply" ]; then
    printf '%s' "$reply"; return 0
  fi
  # Only when stdin is NOT the terminal. Ctrl-D at a terminal prompt means "no
  # answer"; reading /dev/tty then would just ask the same terminal again.
  if [ ! -t 0 ] && tty_opens; then
    IFS= read -r reply 2>/dev/null < /dev/tty || [ -n "$reply" ] || return 1
    printf '%s' "$reply"; return 0
  fi
  return 1
}

# Yes/no with a default. $2 is "y" or "n".
confirm() {
  local prompt="$1" def="${2:-y}" hint reply
  case "$def" in y) hint="[Y/n]" ;; *) hint="[y/N]" ;; esac
  reply=$(ask "$prompt $hint ") || return 1
  reply=$(printf '%s' "$reply" | tr '[:upper:]' '[:lower:]')
  [ -z "$reply" ] && reply="$def"
  case "$reply" in y|yes) return 0 ;; *) return 1 ;; esac
}

# Whether /dev/tty can actually be opened. Its mode is crw-rw-rw- on every Mac,
# so `[ -r /dev/tty ]` was true with no controlling terminal at all (cron,
# launchd, CI) and the "needs a terminal" guards built on it never fired.
tty_opens() { ( : < /dev/tty ) 2>/dev/null; }
have_tty() { [ -t 0 ] || tty_opens; }

# Fail unless an option got a real value. `shift 2 || die` only caught a value
# missing at the very end: `--profile --seed` created a profile literally named
# "--seed" and silently dropped the flag.
need_value() {
  case "${2:-}" in
    ''|-*) die "$1 needs a value." ;;
  esac
}

# The first character of a badge, whatever the caller's locale. Under LC_ALL=C,
# `cut -c1` cut "é" to half a character, the Info.plist became invalid UTF-8,
# and the build was refused.
first_char() { printf '%s' "$1" | LC_ALL=en_US.UTF-8 cut -c1 2>/dev/null; }

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# A profile's default badge: its first letter, upper-cased. Names are ASCII.
first_upper() { printf '%s' "$1" | cut -c1 | tr '[:lower:]' '[:upper:]'; }

# ---------------------------------------------------------------- guards --

[ "$(uname)" = "Darwin" ] || die "aidentity is macOS only (this is $(uname))."

# ------------------------------------------------------------ validation --

# A profile name becomes a directory name, a bundle name and a shell string.
# Restricting it up front is what lets everything downstream stay simple.
# Returns non-zero and explains, rather than exiting. The wizard needs to
# re-prompt on a bad name, and the old exit-based version forced it to spawn a
# subshell and throw the message away — so the user saw a generic rule that did
# not match the actual reason their name was refused.
validate_profile_name() {
  local name="$1"
  [ -n "$name" ] || { warn "Profile name cannot be empty."; return 1; }
  case "$name" in
    *[!A-Za-z0-9\ _-]*)
      warn "Profile name may only contain letters, numbers, spaces, hyphens and underscores.
    Got: '$name'"; return 1 ;;
  esac
  [ "${#name}" -le 40 ] || { warn "Profile name is too long (max 40 characters)."; return 1; }
  case "$name" in
    " "*|*" ") warn "Profile name cannot start or end with a space."; return 1 ;;
    .*) warn "Profile name cannot start with a dot."; return 1 ;;
    -*) warn "Profile name cannot start with a hyphen — it would read as an option."; return 1 ;;
  esac
  return 0
}

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr ' _' '-' | tr -cd 'a-z0-9-'
}

# Quote an arbitrary string as a single-quoted shell literal, so it can be
# embedded in the generated launcher without any escaping ambiguity.
shquote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Escape a string for use as XML character data in the generated Info.plist.
# Profile names are validated, but APP names are whatever is on disk — and
# "Barnes & Noble.app" or any name containing < or > produced a plist that
# plutil rejects, leaving a bundle the tool could no longer read or remove.
xmlescape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
}

# A string as a JSON string, quotes included, for `list --json`. App names and
# paths are whatever is on disk, so a quote, a backslash or a control
# character must not end the string early. Quote and backslash get a
# backslash, \n \r \t their short forms, every other control character
# \u00XX. Anything else, UTF-8 included, is valid JSON as it is. A loop in the
# shell, not sed: sed works a line at a time and never sees a newline.
JSON_CTRL=$'\001\002\003\004\005\006\007\010\011\012\013\014\015\016\017\020\021\022\023\024\025\026\027\030\031\032\033\034\035\036\037'

json_str() {
  local s="$1" out="" c u i=0 n=${#1}
  while [ "$i" -lt "$n" ]; do
    c=${s:$i:1}
    case "$c" in
      '"')   out="$out\\\"" ;;
      \\)    out="$out\\\\" ;;
      $'\n') out="$out\\n" ;;
      $'\r') out="$out\\r" ;;
      $'\t') out="$out\\t" ;;
      *) case "$JSON_CTRL" in
           *"$c"*) printf -v u '\\u%04x' "'$c"; out="$out$u" ;;
           *) out="$out$c" ;;
         esac ;;
    esac
    i=$((i+1))
  done
  printf '"%s"' "$out"
}

# The same, but null for an empty value: a key that was never recorded.
json_str_or_null() { if [ -n "$1" ]; then json_str "$1"; else printf 'null'; fi; }

# One value per line -> a JSON array of strings. Blank lines are skipped.
json_lines() {
  local v sep=""
  printf '['
  while IFS= read -r v; do
    [ -n "$v" ] || continue
    printf '%s%s' "$sep" "$(json_str "$v")"; sep=","
  done <<EOF
$1
EOF
  printf ']'
}

# --------------------------------------------------------- app discovery --

# True if the bundle is Chromium- or Electron-based, i.e. it understands
# --user-data-dir. Two structural signals, both just directory probes:
#   1. an Electron Framework                        (Claude, Slack, VS Code, Notion…)
#   2. a *.framework with Versions/*/Helpers/*.app  (Chromium forks: ChatGPT, Edge…)
#
# Deliberately no binary scanning here — this runs across every installed app,
# and grepping frameworks for the flag turned a listing into a 30-second wait.
is_chromium_app() {
  local app="$1" fw helper

  [ -d "$app/Contents/Frameworks/Electron Framework.framework" ] && return 0

  # A plain glob, not `compgen -G "$fw/…"`: compgen reads the whole argument as
  # a pattern, so an app at a path containing [ ] * or ? was never detected.
  for fw in "$app"/Contents/Frameworks/*.framework; do
    [ -d "$fw" ] || continue
    for helper in "$fw"/Versions/*/Helpers/*.app; do
      [ -d "$helper" ] && return 0
    done
  done

  return 1
}

# Same question, but allowed to be slow. Used only when the user names one
# specific app, so an unusual bundle layout still gets a fair hearing.
is_chromium_app_deep() {
  local app="$1" fw bin

  is_chromium_app "$app" && return 0
  command -v strings >/dev/null 2>&1 || return 1

  for fw in "$app"/Contents/Frameworks/*.framework; do
    [ -d "$fw" ] || continue
    bin="${fw%.framework}"; bin="$fw/Versions/Current/${bin##*/}"
    [ -f "$bin" ] || continue
    # No -q: grep -q stops at the first match, strings dies of SIGPIPE, and
    # pipefail turns that into "no match" — so this check could never succeed
    # on a binary big enough to matter.
    if strings -a "$bin" 2>/dev/null | grep -x -- "--user-data-dir" >/dev/null; then return 0; fi
  done

  return 1
}

bundle_id()   { /usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "$1/Contents/Info.plist" 2>/dev/null; }
bundle_name() { basename "$1" .app; }

# Resolve a user-supplied app name or path to a bundle path.
# Always returns an ABSOLUTE path. A relative one ("Claude.app", typed from
# /Applications) was embedded verbatim in the launcher, which then resolved
# against the Finder's working directory of / and could never start the app.
# Only relative paths are rewritten. An absolute path is passed through as the
# user gave it, symlinks and all — resolving those too would silently repoint a
# launcher away from a deliberately symlinked app.
abs_bundle() {
  local p="${1%/}" d b
  case "$p" in /*) printf '%s' "$p"; return 0 ;; esac
  d=$(dirname "$p"); b=$(basename "$p")
  d=$(command cd -P "$d" 2>/dev/null && pwd) || return 1
  printf '%s/%s' "${d%/}" "$b"
}

resolve_app() {
  local q="$1" cand
  q="${q%/}"
  if [ -d "$q" ] && [ "${q##*.}" = "app" ]; then abs_bundle "$q"; return $?; fi
  local dir
  while IFS= read -r dir; do
    for cand in "$dir/$q.app" "$dir/$q"; do
      [ -d "$cand" ] && { printf '%s' "${cand%/}"; return 0; }
    done
  done <<EOF
$(app_search_dirs)
/System/Applications
EOF

  # Case-insensitive fallback over the same search path.
  local want; want=$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]')
  while IFS= read -r dir; do
    [ -d "$dir" ] || continue
    for cand in "$dir"/*.app; do
      [ -d "$cand" ] || continue
      local n; n=$(bundle_name "$cand")
      if [ "$(printf '%s' "$n" | tr '[:upper:]' '[:lower:]')" = "$want" ]; then
        printf '%s' "$cand"; return 0
      fi
    done
  done <<EOF
$(app_search_dirs)
EOF
  return 1
}

# Where to look for installed apps, colon-separated.
#
# Overridable so the test suite and the documentation recording run against
# fixtures instead of whatever is really installed. Without this the suite
# scans the developer's own /Applications — which weakens its isolation claim —
# and any recorded demo would publish the operator's full app list.
app_search_dirs() {
  local raw="${AIDENTITY_APP_DIRS:-/Applications:$HOME/Applications}" d
  local oldifs="$IFS"; IFS=':'
  for d in $raw; do [ -n "$d" ] && printf '%s\n' "${d%/}"; done
  IFS="$oldifs"
}

# Every Chromium/Electron app installed, one path per line.
list_compatible_apps() {
  local dir app
  while IFS= read -r dir; do
    [ -d "$dir" ] || continue
    for app in "$dir"/*.app; do
      [ -d "$app" ] || continue
      is_our_launcher "$app" && continue
      is_chromium_app "$app" && printf '%s\n' "$app"
    done
  done <<EOF
$(app_search_dirs)
EOF
}

# Path of an app's .icns icon, if it declares one.
app_icns() {
  local icon_name
  icon_name=$(/usr/libexec/PlistBuddy -c "Print :CFBundleIconFile" "$1/Contents/Info.plist" 2>/dev/null) || return 1
  [ -n "$icon_name" ] || return 1
  [ -f "$1/Contents/Resources/${icon_name%.icns}.icns" ] || return 1
  printf '%s' "$1/Contents/Resources/${icon_name%.icns}.icns"
}

copy_plain_icon() {
  local src
  src=$(app_icns "$1") || return 1
  cp "$src" "$2"
}

# Show a numbered menu of compatible apps and echo the chosen bundle path.
# The menu is drawn on stderr so that only the chosen path reaches stdout,
# which is what the caller captures.
pick_app() {
  local apps=() a i=1 choice
  while IFS= read -r a; do [ -n "$a" ] && apps+=("$a"); done <<EOF
$(list_compatible_apps)
EOF
  if [ "${#apps[@]}" -eq 0 ]; then
    warn "No compatible apps found on this Mac."
    return 1
  fi
  {
    printf '%sWhich app needs another account?%s\n\n' "$C_BOLD" "$C_RESET"
    for a in "${apps[@]}"; do printf '  %2d) %s\n' "$i" "$(bundle_name "$a")"; i=$((i+1)); done
    printf '\n'
  } >&2
  # Ask again on a typo. Returning on bad input ended the whole `setup`
  # walkthrough, because its loop cannot tell a typo from the end of input.
  # Only end of input (or q) gives up.
  while :; do
    choice=$(ask 'Number: ') || return 1
    choice=$(printf '%s' "$choice" | tr -d '[:space:]')
    case "$choice" in
      q|Q|quit) return 1 ;;
      # Five digits or more is never a menu number, and a long enough string
      # wraps bash's 64-bit arithmetic back into range.
      ''|*[!0-9]*|?????*) warn "Please enter a number from 1 to ${#apps[@]} (or q to stop)."; continue ;;
    esac
    if [ "$((10#$choice))" -lt 1 ] || [ "$((10#$choice))" -gt "${#apps[@]}" ]; then
      warn "Please enter a number from 1 to ${#apps[@]} (or q to stop)."; continue
    fi
    break
  done
  # 10# forces base 10. Plain $((choice-1)) reads a leading zero as octal, so
  # "010" selected the 8th app and "08"/"09" aborted the wizard outright.
  printf '%s' "${apps[$((10#$choice - 1))]}"
}

# ---------------------------------------------------------------- colours --

color_hex() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    blue)   printf '2E7DF6' ;; green)  printf '2FB344' ;; red)    printf 'E5484D' ;;
    orange) printf 'F76B15' ;; purple) printf '8E4EC6' ;; pink)   printf 'D6409F' ;;
    teal)   printf '12A594' ;; yellow) printf 'F5B400' ;; gray|grey) printf '6B7280' ;;
    graphite|black) printf '1F2430' ;;
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) printf '%s' "$1" ;;
    *) return 1 ;;
  esac
}

# Every name color_hex accepts, used in the "unknown colour" error so it cannot
# claim a smaller set than the code takes. (help and the README list the main
# spellings and leave out the aliases grey and black.) auto_color only picks from
# the first eight — the neutrals are opt-in, never assigned automatically.
COLOR_NAMES="blue green orange purple teal pink red yellow gray grey graphite black"
AUTO_COLOR_NAMES="blue green orange purple teal pink red yellow"

# Stable colour per profile name, so a profile always looks the same.
auto_color() {
  local sum n i
  sum=$(printf '%s' "$1" | cksum | awk '{print $1}')
  n=$(printf '%s' "$AUTO_COLOR_NAMES" | wc -w | tr -d ' ')
  i=$(( sum % n + 1 ))
  printf '%s' "$AUTO_COLOR_NAMES" | awk -v i="$i" '{print $i}'
}

# ------------------------------------------------------------------ icons --

# Composite a coloured badge with a letter onto the source app's icon.
# Uses only what ships with macOS: iconutil for icns<->png, and JXA/Cocoa to draw.
# If anything here fails we fall back to the app's plain icon — never fatal.
build_icon() {
  local tmp rc
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/aidentity.XXXXXX") || return 1
  _build_icon_in "$1" "$2" "$3" "$4" "$tmp"
  rc=$?
  rm -rf "$tmp"
  return $rc
}

_build_icon_in() {
  local src_app="$1" letter="$2" hex="$3" out_icns="$4" tmp="$5"
  local src_icns

  src_icns=$(app_icns "$src_app") || return 1

  iconutil -c iconset "$src_icns" -o "$tmp/base.iconset" >/dev/null 2>&1 || return 1

  cat > "$tmp/badge.jxa" <<'JXA'
ObjC.import('Cocoa');
// argv: letter, hex, then one or more image paths, each badged in place.
// Spinning a separate osascript per size cost ~60ms of interpreter boot each;
// batching cut a badged `add` from ~805ms to ~331ms with identical output.
function run(argv) {
  var letter = argv[0], hex = argv[1];
  var failed = 0;
  for (var i = 2; i < argv.length; i++) {
    if (badge(argv[i], argv[i], letter, hex) !== 0) failed++;
  }
  return failed === 0 ? 0 : 1;
}

function badge(inPath, outPath, letter, hex) {
  var src = $.NSImage.alloc.initWithContentsOfFile(inPath);
  if (!src || src.isNil()) return 1;
  var W = src.size.width, H = src.size.height;
  if (W < 1) return 1;
  var out = $.NSImage.alloc.initWithSize({width: W, height: H});
  out.lockFocus;
  src.drawInRect($.NSMakeRect(0, 0, W, H));

  var d = W * 0.44, x = W - d - W * 0.03, y = W * 0.03;
  var r = parseInt(hex.substr(0,2),16)/255,
      g = parseInt(hex.substr(2,2),16)/255,
      b = parseInt(hex.substr(4,2),16)/255;

  // A light ring keeps the badge readable over any icon.
  $.NSColor.colorWithCalibratedRedGreenBlueAlpha(1,1,1,0.96).set;
  $.NSBezierPath.bezierPathWithOvalInRect(
    $.NSMakeRect(x - W*0.022, y - W*0.022, d + W*0.044, d + W*0.044)).fill;
  $.NSColor.colorWithCalibratedRedGreenBlueAlpha(r,g,b,1).set;
  $.NSBezierPath.bezierPathWithOvalInRect($.NSMakeRect(x, y, d, d)).fill;

  var attrs = $.NSMutableDictionary.dictionary;
  attrs.setObjectForKey($.NSFont.boldSystemFontOfSize(d * 0.60), "NSFont");
  attrs.setObjectForKey($.NSColor.whiteColor, "NSColor");
  var s = $.NSString.alloc.initWithUTF8String(letter);
  var ts = s.sizeWithAttributes(attrs);
  s.drawAtPointWithAttributes({x: x + (d - ts.width)/2, y: y + (d - ts.height)/2}, attrs);

  out.unlockFocus;
  var rep = $.NSBitmapImageRep.imageRepWithData(out.TIFFRepresentation);
  rep.representationUsingTypeProperties(4, $.NSDictionary.dictionary)
     .writeToFileAtomically(outPath, true);
  return 0;
}
JXA

  # Badge only the sizes where a letter is legible; leave 16/32 as-is. All of
  # them go to ONE osascript call — the Cocoa runtime costs far more to start
  # than the drawing costs to run.
  local f base targets=()
  for f in "$tmp/base.iconset"/*.png; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    case "$base" in
      icon_16x16.png|icon_16x16@2x.png|icon_32x32.png) continue ;;
    esac
    targets+=("$f")
  done
  if [ "${#targets[@]}" -gt 0 ]; then
    osascript -l JavaScript "$tmp/badge.jxa" "$letter" "$hex" "${targets[@]}" >/dev/null 2>&1 || true
  fi

  iconutil -c icns "$tmp/base.iconset" -o "$out_icns" >/dev/null 2>&1 || return 1
  [ -f "$out_icns" ]
}

# -------------------------------------------------------------- launcher --

is_our_launcher() {
  [ -d "$1" ] || return 1
  /usr/libexec/PlistBuddy -c "Print :$MARKER_KEY" "$1/Contents/Info.plist" >/dev/null 2>&1
}

plist_get() { /usr/libexec/PlistBuddy -c "Print :$2" "$1/Contents/Info.plist" 2>/dev/null; }

# A launcher made with `add --main` opens the app's own, original account. It
# records no data directory, and nothing ever deletes or moves the app's data.
is_main_launcher() { [ "$(plist_get "$1" AIdentityMain)" = "true" ]; }

# The badge and colour a launcher was built with. 1.0.0 recorded neither key,
# and an empty badge means "no badge" — so reading a missing key as empty
# stripped the badge from every 1.0.0 launcher on its first rebuild or rename.
# For those, rebuild 1.0.0's defaults: the profile's first letter, unless the
# icon is the app's own byte for byte, which is what 1.0.0's --no-badge wrote.
is_legacy_launcher() {
  ! /usr/libexec/PlistBuddy -c "Print :AIdentityBadge" "$1/Contents/Info.plist" >/dev/null 2>&1
}

launcher_badge() { # launcher, target app, profile
  local src
  if ! is_legacy_launcher "$1"; then plist_get "$1" AIdentityBadge; return 0; fi
  if src=$(app_icns "$2") && cmp -s "$src" "$1/Contents/Resources/icon.icns"; then
    return 0
  fi
  first_upper "$3"
}

launcher_color() { # launcher, label
  local hex
  hex=$(plist_get "$1" AIdentityColor)
  [ -n "$hex" ] || hex=$(color_hex "$(auto_color "$2")")
  printf '%s' "$hex"
}

# A directory's identity, so two spellings of one directory compare equal: a
# symlinked root, "//", a trailing slash, /var against /private/var.
# /usr/bin/stat by full path: a GNU stat earlier on PATH reads -f as "file
# system" and prints one value for every directory, which made every
# directory look claimed. -L: the directory a symlink points at, not the link
# itself — or a profile whose recorded path is a symlink read as unclaimed,
# and prune deleted what it pointed to.
dir_id() { [ -d "$1" ] && /usr/bin/stat -L -f '%d:%i' "$1" 2>/dev/null; }

# Refuse to touch a bundle unless it is demonstrably one of ours.
assert_ours() {
  local app="$1"
  case "$app" in
    */*.app) ;;
    *) die "Refusing to operate on '$app' — not an .app bundle." ;;
  esac
  is_our_launcher "$app" || die "Refusing to touch '$app' — it was not created by aidentity."
}

# Two traps here, both of which produced a wrong answer in testing:
#
#   1. On macOS `pgrep -a` means "include ancestors", not "print the command
#      line" as it does on Linux: -l is what prints argv. -a alone gives bare
#      PIDs and the match below can never succeed; -afl prints argv AND keeps
#      the caller's own ancestors in the list.
#   2. The list must be captured BEFORE matching. Piping pgrep straight into
#      grep starts both at once, and the grep's own argv contains the path we
#      are searching for — so pgrep matches the grep and every profile looks
#      like it is running.
# The match is anchored on purpose. A bare substring test made ".../claude-work"
# match a process running ".../claude-work-2", so one profile reported another
# as running and refused to remove or rebuild it. The flag is always followed by
# a space or the end of the argument list, so require one of those.
#
# The match runs in the shell, never as `printf … | grep -q`. grep -q exits at
# the first match; real Electron helpers make this list 100 KB, so printf then
# died of SIGPIPE and pipefail turned the pipeline into "no match". A running
# profile read as stopped exactly when its line came early — fail OPEN, on a
# guard whose whole job is to stop a delete. Quoting "$1" inside the pattern
# keeps [ * ? in a path literal.
running_on_profile() {
  local list rc nl=$'\n'
  [ -n "$1" ] || return 1
  # pgrep exits 1 for "no match" but >=2 for a real failure. Treating those the
  # same made a data-loss guard fail OPEN — a broken pgrep read as "nothing is
  # running" and the delete went ahead. Anything but 0 or 1 is reported as
  # running, so the caller refuses to delete.
  # -a: on macOS pgrep leaves out the caller's own ancestors unless asked.
  list=$(pgrep -afl "user-data-dir=" 2>/dev/null); rc=$?
  if [ "$rc" -gt 1 ]; then
    warn "Could not check which profiles are running (pgrep exited $rc); assuming they are."
    return 0
  fi
  [ "$rc" -eq 0 ] && [ -n "$list" ] || return 1
  case "$list$nl" in
    *"user-data-dir=$1 "*|*"user-data-dir=$1$nl"*) return 0 ;;
  esac
  # The same directory under another spelling — a symlinked root, "//", a
  # trailing slash — is the same profile. Compare each path a process names
  # (up to the next " --" or the end of its line) by directory identity.
  local want line rest path seen="|"
  want=$(/usr/bin/stat -L -f '%d:%i' "$1" 2>/dev/null) || return 1
  while IFS= read -r line; do
    rest=$line
    while :; do
      case "$rest" in *user-data-dir=*) rest=${rest#*user-data-dir=} ;; *) break ;; esac
      path=${rest%% --*}
      case "$seen" in *"|$path|"*) continue ;; esac
      seen="$seen$path|"
      [ "$(/usr/bin/stat -L -f '%d:%i' "$path" 2>/dev/null)" = "$want" ] && return 0
    done
  done <<EOF
$list
EOF
  return 1
}

# The same question for the menu, which asks about every profile on each
# refresh: the answer comes from a process list read once, and from the
# identities of the paths it names (proc_dir_ids), so no profile reads the list
# or looks at a path again. $2 is pgrep's exit status and $3 its list. It
# answers as running_on_profile does, including "running" when pgrep failed.
# Keep the two in step; the tests ask both the same questions.
running_in_list() { # data dir, pgrep status, its list, proc_dir_ids of it
  local nl=$'\n' want
  [ -n "$1" ] || return 1
  [ "$2" -le 1 ] || return 0
  [ "$2" -eq 0 ] && [ -n "$3" ] || return 1
  case "$3$nl" in
    *"user-data-dir=$1 "*|*"user-data-dir=$1$nl"*) return 0 ;;
  esac
  want=$(/usr/bin/stat -L -f '%d:%i' "$1" 2>/dev/null) || return 1
  case "$4" in *"|$want|"*) return 0 ;; esac
  return 1
}

# The identity (device:inode) of each path a process in the list names with
# --user-data-dir, up to the next " --" or the end of its line, as "|id|id|".
# Each distinct path is looked at once.
proc_dir_ids() { # process list
  local line rest path id seen="|" ids="|"
  while IFS= read -r line; do
    rest=$line
    while :; do
      case "$rest" in *user-data-dir=*) rest=${rest#*user-data-dir=} ;; *) break ;; esac
      path=${rest%% --*}
      case "$seen" in *"|$path|"*) continue ;; esac
      seen="$seen$path|"
      id=$(/usr/bin/stat -L -f '%d:%i' "$path" 2>/dev/null) && ids="$ids$id|"
    done
  done <<EOF
$1
EOF
  printf '%s' "$ids"
}

# The app's main executable, from its Info.plist.
app_exe() {
  local exe
  exe=$(/usr/libexec/PlistBuddy -c "Print :CFBundleExecutable" "$1/Contents/Info.plist" 2>/dev/null) || return 1
  [ -n "$exe" ] || return 1
  printf '%s' "$1/Contents/MacOS/$exe"
}

# Whether any copy of the app is running, on any account.
app_running() {
  local exe list line
  exe=$(app_exe "$1") || return 1
  list=$(ps -axww -o command= 2>/dev/null) || return 1
  while IFS= read -r line; do
    case "$line" in "$exe"|"$exe "*) return 0 ;; esac
  done <<EOF
$list
EOF
  return 1
}

# Whether the app is running on its own account, with no --user-data-dir: the
# instance a --main launcher opens. Matched in the shell for the same reason as
# above — a pipe into grep -q fails open on a long process list. The menu reads
# the list once for all its rows and passes it in as $2.
main_running() { # app [, process list]
  local exe list line
  exe=$(/usr/libexec/PlistBuddy -c "Print :CFBundleExecutable" "$1/Contents/Info.plist" 2>/dev/null) || return 1
  exe="$1/Contents/MacOS/$exe"
  if [ $# -ge 2 ]; then
    list=$2
  else
    list=$(ps -axww -o command= 2>/dev/null) || return 1
  fi
  while IFS= read -r line; do
    case "$line" in
      *--user-data-dir=*) ;;
      "$exe"|"$exe "*) return 0 ;;
    esac
  done <<EOF
$list
EOF
  return 1
}

# A recorded data directory is ours only if it sits genuinely inside the data
# root. This is the last thing standing between a hand-edited Info.plist and
# `rm -rf`, so it resolves the path rather than pattern-matching the string.
#
# Three ways a string test alone was shown to fail:
#   "$DATA_ROOT/../elsewhere"  — traversal
#   "$DATA_ROOT//"             — matches "$DATA_ROOT"/?* yet IS the root, so
#                                rm -rf took every profile with it
#   "$DATA_ROOT/link/x"        — link is a symlink out of the root, and rm -rf
#                                follows it
# Resolving both sides with `cd -P` collapses all three: a path that resolves
# to the root itself, or to anywhere outside it, is rejected.
data_is_ours() {
  local d="$1" real root head tail
  [ -n "$d" ] || return 1

  # Absolute only. A relative path also made the walk-up loop below spin
  # forever: "${head%/*}" reaches a fixed point that never equals the input,
  # so the guard never fired and `tail` grew without bound.
  case "$d" in /*) ;; *) return 1 ;; esac

  # No dot segments at all. The tail is re-attached lexically further down, so
  # a ".." inside it would never be resolved and the answer would be wrong.
  case "$d" in
    *"/../"*|*"/.."|*"/./"*|*"/."|*"/") return 1 ;;
  esac

  root=$(command cd -P "$DATA_ROOT" 2>/dev/null && pwd -P) || return 1
  [ -n "$root" ] || return 1

  # Resolve the deepest existing ancestor, then re-attach the rest, so a
  # not-yet-created directory is still judged by where it would land. This
  # terminates because the path is absolute: head shrinks one component per
  # pass and bottoms out at "/", which always exists.
  head="$d"; tail=""
  while [ ! -d "$head" ]; do
    tail="${head##*/}${tail:+/$tail}"
    head="${head%/*}"
    [ -z "$head" ] && head="/"
  done
  real=$(command cd -P "$head" 2>/dev/null && pwd -P) || return 1
  [ -n "$tail" ] && real="${real%/}/$tail"

  # Must be strictly below the root — never the root itself.
  [ "$real" = "$root" ] && return 1
  case "$real" in
    "$root"/?*) return 0 ;;
    *) return 1 ;;
  esac
}

# A launcher is built in a hidden staging directory beside its final place and
# moved in only once it is complete, so a failed `set`, `rebuild` or `rename`
# leaves the working launcher exactly as it was. The old code deleted the
# launcher first and then died half way, which left the profile with no
# launcher — and its signed-in data looking orphaned to `prune`. If we are
# interrupted mid-build, the staging directory is removed on the way out.
BUILD_STAGE=""
# While a launcher is being swapped, the old one sits in the staging directory
# under SWAP_PREV. If anything stops us there — an interrupt, a failed second
# move — it goes back to SWAP_DST before the stage is removed. Deleting the
# stage blindly deleted the only copy of the launcher.
SWAP_DST=""
SWAP_PREV=""
# Set by rename between moving a profile's data and finishing its launcher, as
# "new path|old path": an interrupt in that window moves the data back, so the
# old launcher still finds it.
RENAME_UNDO=""

# Returns non-zero when something in the staging directory could not be
# removed (a locked file), so a caller can say so instead of claiming success.
_cleanup_stage() {
  local rc=0
  if [ -n "$SWAP_PREV" ] && [ -e "$SWAP_PREV" ] && [ ! -e "$SWAP_DST" ]; then
    if ! mv "$SWAP_PREV" "$SWAP_DST" 2>/dev/null; then
      warn "Interrupted while replacing a launcher. The old one is still at:
    $SWAP_PREV
    Move it back to: $SWAP_DST"
      SWAP_PREV=""; SWAP_DST=""; BUILD_STAGE=""
      return 1
    fi
  fi
  SWAP_PREV=""; SWAP_DST=""
  if [ -n "$BUILD_STAGE" ]; then
    rm -rf "$BUILD_STAGE" 2>/dev/null
    [ -e "$BUILD_STAGE" ] && rc=1
    BUILD_STAGE=""
  fi
  return "$rc"
}

_undo_rename() {
  local from to
  [ -n "$RENAME_UNDO" ] || return 0
  from=${RENAME_UNDO%%|*}; to=${RENAME_UNDO#*|}
  RENAME_UNDO=""
  if [ -d "$from" ] && [ ! -e "$to" ] && mv "$from" "$to" 2>/dev/null; then
    warn "Interrupted: the profile was moved back to $to; nothing was renamed."
  else
    warn "Interrupted during rename. The profile data is at: $from"
  fi
}

# Set by update while it holds a download folder and a staged copy of the new
# script beside the old one. Both go on the way out, finished or not, so a
# failed or interrupted update leaves nothing behind.
UPDATE_TMP=""
UPDATE_STAGED=""

_cleanup_update() {
  [ -n "$UPDATE_STAGED" ] && rm -f "$UPDATE_STAGED" 2>/dev/null
  # Only ever a folder update made itself with mktemp.
  case "$UPDATE_TMP" in */aidentity-update.?*) rm -rf "$UPDATE_TMP" 2>/dev/null ;; esac
  UPDATE_STAGED=""; UPDATE_TMP=""
  return 0
}

_on_exit() { _cleanup_stage; _undo_rename; _cleanup_update; return 0; }
trap '_on_exit' EXIT
trap '_on_exit; exit 130' INT
trap '_on_exit; exit 143' TERM
trap '_on_exit; exit 129' HUP

# Build or replace a launcher. On failure it warns and returns non-zero; it
# never exits. Every caller has a recovery path — rename moves the data back,
# setup carries on with the next account, rebuild --all counts the failure —
# and the die() calls that used to live here skipped every one of them.
# kind is "main" for a launcher that opens the app's own account (no data dir).
build_launcher() {
  local src_app="$1" profile="$2" data_dir="$3" label="$4" letter="$5" hex="$6" kind="${7:-}"
  local extras="${8:-}"
  local dst="$APPS_DIR/$label.app" rc

  # Only ever replace a bundle that is ours.
  if [ -e "$dst" ] && ! is_our_launcher "$dst"; then
    warn "Refusing to replace '$dst' — it was not created by aidentity."
    return 1
  fi
  # Without a data directory a launcher opens the app's own account. That must
  # only ever happen on purpose, never because a plist lost its key.
  if [ "$kind" != "main" ] && [ -z "$data_dir" ]; then
    warn "No profile directory recorded for '$label'. Refusing to build a launcher
    that would open the app's original account instead."
    return 1
  fi

  # Every launch setting is checked here, wherever it came from: the command
  # line, a launcher's own Info.plist, or a restore record someone could edit.
  validate_extras "$extras" "$src_app" "$kind" || return 1

  mkdir -p "$APPS_DIR" 2>/dev/null || { warn "Could not create $APPS_DIR"; return 1; }
  if [ "$kind" != "main" ]; then
    # Owner-only, like the directories the apps create for themselves. Only
    # directories made here are affected; an existing root keeps its mode.
    ( umask 077 && mkdir -p "$data_dir" ) 2>/dev/null \
      || { warn "Could not create $data_dir"; return 1; }
  fi

  BUILD_STAGE=$(mktemp -d "$APPS_DIR/.aidentity-build.XXXXXX" 2>/dev/null) \
    || { BUILD_STAGE=""; warn "Could not write to $APPS_DIR"; return 1; }

  _assemble_launcher "$BUILD_STAGE/$label.app" "$src_app" "$profile" "$data_dir" \
      "$label" "$letter" "$hex" "$kind" "$extras" \
    && _swap_in "$BUILD_STAGE/$label.app" "$dst" "$BUILD_STAGE"
  rc=$?
  _cleanup_stage
  [ "$rc" -eq 0 ] || return 1

  if [ "$kind" != "main" ]; then
    write_restore_record "$data_dir" "$profile" "$src_app" "$letter" "$hex" "$extras" \
      || warn "Could not write the restore record in $data_dir. The launcher works; 'aidentity restore' will not know this profile."
  fi

  # Nudge Launch Services so the icon and name appear immediately.
  local lsreg="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
  [ -x "$lsreg" ] && "$lsreg" -f "$dst" >/dev/null 2>&1
  touch "$dst"
  return 0
}

# A small record inside each profile directory of what its launcher was:
# profile name, target app, badge, colour. The directory outlives the launcher —
# a launcher deleted in Finder, or removed with `rm` without --purge — and with
# this record `aidentity restore` can rebuild the launcher instead of `prune`
# only offering to delete a signed-in session. Chromium and Electron ignore a
# file they do not know in their data directory. Written to a temporary name
# and moved into place, owner-only like the rest of the directory.
RESTORE_RECORD=".aidentity-profile.plist"

write_restore_record() { # data_dir, profile, target app, badge, colour, [extras]
  local dir="$1" tmp bid extras="${6:-}"
  [ -d "$dir" ] || return 1
  bid=$(bundle_id "$3")
  tmp=$(mktemp "$dir/.aidentity-record.XXXXXX" 2>/dev/null) || return 1
  cat > "$tmp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>$MARKER_KEY</key><string>$(xmlescape "$2")</string>
	<key>AIdentityTargetApp</key><string>$(xmlescape "$3")</string>
	<key>AIdentityTargetBundleID</key><string>$(xmlescape "$bid")</string>
	<key>AIdentityBadge</key><string>$(xmlescape "$4")</string>
	<key>AIdentityColor</key><string>$(xmlescape "$5")</string>
	$(extras_plist_xml "$extras")
	<key>AIdentityVersion</key><string>$AIDENTITY_VERSION</string>
</dict>
</plist>
PLIST
  if plutil -lint "$tmp" >/dev/null 2>&1 && chmod 600 "$tmp" && mv -f "$tmp" "$dir/$RESTORE_RECORD"; then
    return 0
  fi
  rm -f "$tmp"
  return 1
}

record_get() { /usr/libexec/PlistBuddy -c "Print :$2" "$1/$RESTORE_RECORD" 2>/dev/null; }

# ------------------------------------------------- per-profile launch settings
#
# Extra switches and environment variables a launcher hands its app, and
# whether a VS Code-family app gets its own extensions folder. They travel as
# one text value, a line per setting: "arg<TAB>--lang=de", "env<TAB>NAME=value",
# "ext<TAB>1". validate_extras refuses a tab or line break inside a value, so
# the format cannot be confused.
TAB=$'\t'

extras_lines() { # kind (arg, env or ext), extras -> that kind's values
  local line
  while IFS= read -r line; do
    case "$line" in "$1$TAB"*) printf '%s\n' "${line#*"$TAB"}" ;; esac
  done <<EOF
$2
EOF
}

plist_array_get() { # plist file, key -> one value per line
  local i=0 v
  while v=$(/usr/libexec/PlistBuddy -c "Print :$2:$i" "$1" 2>/dev/null); do
    printf '%s\n' "$v"; i=$((i+1))
  done
}

# The settings a launcher's Info.plist (or a restore record) was built with.
extras_of() { # plist file
  local v
  while IFS= read -r v; do [ -n "$v" ] && printf 'arg%s%s\n' "$TAB" "$v"; done <<EOF
$(plist_array_get "$1" AIdentityArgs)
EOF
  while IFS= read -r v; do [ -n "$v" ] && printf 'env%s%s\n' "$TAB" "$v"; done <<EOF
$(plist_array_get "$1" AIdentityEnv)
EOF
  [ "$(/usr/libexec/PlistBuddy -c 'Print :AIdentityOwnExtensions' "$1" 2>/dev/null)" = "true" ] \
    && printf 'ext%s1\n' "$TAB"
  return 0
}

extras_plist_xml() { # extras -> the <key>…</key> entries that record them
  local v
  printf '<key>AIdentityArgs</key><array>'
  while IFS= read -r v; do [ -n "$v" ] && printf '<string>%s</string>' "$(xmlescape "$v")"; done <<EOF
$(extras_lines arg "$1")
EOF
  printf '</array><key>AIdentityEnv</key><array>'
  while IFS= read -r v; do [ -n "$v" ] && printf '<string>%s</string>' "$(xmlescape "$v")"; done <<EOF
$(extras_lines env "$1")
EOF
  printf '</array>'
  [ -n "$(extras_lines ext "$1")" ] && printf '<key>AIdentityOwnExtensions</key><true/>'
  return 0
}

# Launch settings are an allowlist. Many Chromium and Electron switches and
# variables can hand the app to another program or switch off its protections,
# and a launcher is one click for anyone at this Mac. Only settings with a
# plain job pass, and each value must have the exact shape that job needs.
ALLOWED_SWITCHES="--proxy-server --proxy-bypass-list --no-proxy-server --lang --locale --force-device-scale-factor --disable-gpu --disable-lcd-text"
ALLOWED_ENV="HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy LANG LC_ALL LC_CTYPE LC_MESSAGES TZ"

# A language tag: 2-3 lower-case letters, optionally "-" and 2-8 letters or
# digits (de, pt-BR, zh-Hant).
is_lang_tag() {
  local base="${1%%-*}" rest=""
  case "$1" in *-*) rest="${1#*-}" ;; esac
  case "$base" in [a-z][a-z]|[a-z][a-z][a-z]) ;; *) return 1 ;; esac
  case "$1" in *-) return 1 ;; esac
  [ -z "$rest" ] && return 0
  case "$rest" in *[!A-Za-z0-9]*) return 1 ;; esac
  [ "${#rest}" -ge 2 ] && [ "${#rest}" -le 8 ]
}

# A proxy server or bypass list: the characters those lists use, nothing else.
is_proxy_value() {
  [ -n "$1" ] && [ "${#1}" -le 512 ] || return 1
  case "$1" in *[!A-Za-z0-9:/._\;=*,\<\>@+-]*) return 1 ;; esac
  return 0
}

validate_switch() {
  local s="$1" name val=""
  case "$s" in *[[:cntrl:]]*) warn "A switch cannot contain a tab, a line break or another control character."; return 1 ;; esac
  case "$s" in
    --[a-z]*) ;;
    *) warn "'$s' is not a switch. A switch looks like --lang=de or --disable-gpu."; return 1 ;;
  esac
  name=${s#--}
  case "$name" in *=*) val=${name#*=}; name=${name%%=*} ;; esac
  case "$name" in
    proxy-server|proxy-bypass-list)
      is_proxy_value "$val" || { warn "--$name needs a proxy value, e.g. --$name=socks5://127.0.0.1:1080"; return 1; } ;;
    no-proxy-server|disable-gpu|disable-lcd-text)
      case "$s" in *=*) warn "--$name takes no value."; return 1 ;; esac ;;
    lang|locale)
      is_lang_tag "$val" || { warn "--$name needs a language code, e.g. --$name=de or --$name=pt-BR."; return 1; } ;;
    force-device-scale-factor)
      if ! printf '%s' "$val" | grep -Eq '^[0-9]{1,2}(\.[0-9]{1,3})?$' \
         || ! awk -v v="$val" 'BEGIN { exit !(v >= 0.5 && v <= 4) }'; then
        warn "--force-device-scale-factor needs a number from 0.5 to 4."; return 1
      fi ;;
    *)
      warn "--$name is not one aidentity passes on. Allowed: $ALLOWED_SWITCHES."
      return 1 ;;
  esac
  return 0
}

validate_env() {
  local kv="$1" name val
  case "$kv" in *[[:cntrl:]]*) warn "An environment value cannot contain a tab, a line break or another control character."; return 1 ;; esac
  case "$kv" in
    *=*) ;;
    *) warn "'$kv' must look like NAME=value."; return 1 ;;
  esac
  name=${kv%%=*}; val=${kv#*=}
  case "$name" in
    ''|[0-9]*|*[!A-Za-z0-9_]*) warn "'$name' is not a variable name."; return 1 ;;
  esac
  case " $ALLOWED_ENV " in
    *" $name "*) ;;
    *) warn "$name is not one aidentity passes on. Allowed: $ALLOWED_ENV."; return 1 ;;
  esac
  case "$name" in
    *_PROXY|*_proxy)
      is_proxy_value "$val" || { warn "$name needs a proxy value, e.g. $name=http://proxy.example:8080"; return 1; } ;;
    LANG|LC_*)
      case "$val" in ''|*[!A-Za-z0-9_.@-]*) warn "$name needs a locale, e.g. $name=de_DE.UTF-8"; return 1 ;; esac ;;
    TZ)
      case "$val" in ''|*..*|*[!A-Za-z0-9_+:/-]*) warn "TZ needs a time zone, e.g. TZ=Europe/Berlin"; return 1 ;; esac ;;
  esac
  return 0
}

# VS Code and its forks keep extensions outside --user-data-dir, so profiles
# share them unless each gets its own --extensions-dir. A fork is recognised by
# its product.json naming the same bundle identifier as the app itself.
is_vscode_family() {
  local pj="$1/Contents/Resources/app/product.json" bid pbid
  [ -f "$pj" ] || return 1
  bid=$(/usr/bin/plutil -extract CFBundleIdentifier raw -o - "$1/Contents/Info.plist" 2>/dev/null) || return 1
  pbid=$(/usr/bin/plutil -extract darwinBundleIdentifier raw -o - "$pj" 2>/dev/null) || return 1
  [ -n "$bid" ] && [ "$bid" = "$pbid" ] && \
    /usr/bin/plutil -extract dataFolderName raw -o - "$pj" >/dev/null 2>&1
}

# VS Code and its forks open a socket in their --user-data-dir, named after the
# first four characters of their version: ".../1.14-main.sock". When that path
# does not fit in a macOS socket address, the app quits at start and no window
# opens. The address holds 104 bytes, and C code keeps the last one for a
# closing zero, so 103 is the longest safe path. The default data folder, a
# long app name and a 40-character profile name together go past it, so add,
# rename and restore check first.
SOCKET_PATH_MAX=103

socket_path_bytes() { # app, data dir -> bytes in the path of the app's socket
  local ver name=14
  ver=$(/usr/bin/plutil -extract version raw -o - "$1/Contents/Resources/app/product.json" 2>/dev/null) || ver=""
  # No version to read: assume four characters, the most the name takes.
  [ -n "$ver" ] && name=$(( $(printf '%s' "${ver:0:4}" | wc -c) + 10 ))
  # Bytes, not characters: a home folder's name can hold UTF-8.
  printf '%s' $(( $(printf '%s' "$2" | wc -c) + 1 + name ))
}

# The longest profile name the app can open in the data folder, where `add`
# and `rename` put its folder: "$DATA_ROOT/<app>-<name>". Each character of a
# profile name is one byte of that folder's name. Below 1, no name fits: the
# data folder itself is too deep, which a long user name alone can cause.
profile_name_room() { # app
  printf '%s' $(( SOCKET_PATH_MAX - $(socket_path_bytes "$1" "$DATA_ROOT/$(slugify "$(bundle_name "$1") ")") ))
}

# A number and its unit, in the singular when it is 1: "1 byte", "3 bytes".
count() { # number, unit
  if [ "$1" -eq 1 ]; then printf '1 %s' "$2"; else printf '%s %ss' "$1" "$2"; fi
}

# Warn and fail when a VS Code-family app could not open a profile kept in this
# data dir. What to do instead depends on the command: a new profile or a
# rename needs a shorter name, a profile that exists needs a rename, and a
# profile being restored keeps its folder, so that folder needs a shorter name.
socket_path_ok() { # app, data dir, label, new|existing|restore
  local n room fix
  is_vscode_family "$1" || return 0
  n=$(socket_path_bytes "$1" "$2")
  [ "$n" -gt "$SOCKET_PATH_MAX" ] || return 0
  if [ "$4" = "restore" ]; then
    room=$(( $(printf '%s' "${2##*/}" | wc -c) - (n - SOCKET_PATH_MAX) ))
  else
    room=$(profile_name_room "$1")
  fi
  if [ "$room" -lt 1 ]; then
    fix="Even a one-character name is too long in this data folder. Set
    AIDENTITY_DATA_ROOT to a folder whose path is at least $(count $((1 - room)) byte) shorter."
  else
    case "$4" in
      existing) fix="Rename it to a name of at most $(count "$room" character):
      aidentity rename \"$3\" \"<new name>\"" ;;
      restore) fix="Rename this folder to a name of at most $(count "$room" character), then run restore again:
      $2" ;;
      *) fix="Use a profile name of at most $(count "$room" character), or set AIDENTITY_DATA_ROOT
    to a shorter folder." ;;
    esac
  fi
  warn "$(bundle_name "$1") cannot open '$3': its profile folder path is too long.
    The app makes a socket in that folder. macOS allows a socket path of
    $SOCKET_PATH_MAX bytes, and this one would be $n.
    $fix"
  return 1
}

validate_extras() { # extras, target app, kind
  local v
  while IFS= read -r v; do [ -z "$v" ] || validate_switch "$v" || return 1; done <<EOF
$(extras_lines arg "$1")
EOF
  while IFS= read -r v; do [ -z "$v" ] || validate_env "$v" || return 1; done <<EOF
$(extras_lines env "$1")
EOF
  if [ -n "$(extras_lines ext "$1")" ]; then
    if [ "${3:-}" = "main" ]; then
      warn "--own-extensions applies to profiles, not to the original account."; return 1
    fi
    if ! is_vscode_family "$2"; then
      warn "--own-extensions only applies to VS Code and its forks (Cursor, Kiro)."; return 1
    fi
  fi
  return 0
}

# Stored settings that are no longer allowed — from an older version, a
# hand-edited file, or an app that stopped being a VS Code fork — are dropped
# with a note, so rebuild, restore and doctor --fix can still finish. New
# settings from the command line are checked strictly instead.
filter_extras() { # extras, target app, kind -> the allowed lines
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    if validate_extras "$line" "$2" "$3" 2>/dev/null; then
      printf '%s\n' "$line"
    else
      warn "Dropped a stored launch setting that is not allowed: ${line#*"$TAB"}"
    fi
  done <<EOF
$1
EOF
}

# Merge new settings into old ones, the newest winning: a switch replaces one
# with the same name (--lang=fr replaces --lang=de; the app would only use the
# last anyway), a variable replaces one with the same NAME, --proxy-server and
# --no-proxy-server replace each other, and "ext" follows the last word.
extras_merge() { # old extras, new extras (lines; "noext" clears ext)
  local line out="" name
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      "env$TAB"*)
        name=${line#*"$TAB"}; name=${name%%=*}
        out=$(printf '%s\n' "$out" | /usr/bin/grep -v "^env$TAB$name=" || true) ;;
      "arg$TAB"*)
        name=${line#*"$TAB"}; name=${name%%=*}
        case "$name" in
          --proxy-server|--no-proxy-server)
            out=$(printf '%s\n' "$out" | /usr/bin/grep -v -e "^arg$TAB--proxy-server=" -e "^arg$TAB--no-proxy-server\$" || true) ;;
          *)
            out=$(printf '%s\n' "$out" | /usr/bin/grep -v -e "^arg$TAB$name=" -e "^arg$TAB$name\$" || true) ;;
        esac ;;
      "ext$TAB"*|"noext")
        out=$(printf '%s\n' "$out" | /usr/bin/grep -v "^ext$TAB" || true)
        [ "$line" = "noext" ] && continue ;;
    esac
    out="${out:+$out
}$line"
  done <<EOF
$1
$2
EOF
  printf '%s' "$out" | /usr/bin/grep -v '^$' || true
}

# Move a finished bundle into place. The old one is set aside, not deleted, and
# put back if the new one cannot be moved in. Both moves are renames inside one
# directory, so nothing is copied and nothing is half-written.
_swap_in() { # new bundle, destination, staging dir
  if [ -e "$2" ]; then
    # Set aside under a name no launcher can have (no .app), so a launcher
    # that happens to be called "previous" cannot be moved inside its own
    # replacement.
    SWAP_DST="$2"; SWAP_PREV="$3/.previous"
    mv "$2" "$SWAP_PREV" 2>/dev/null \
      || { SWAP_DST=""; SWAP_PREV=""; warn "Could not replace $2 (is it locked?). Nothing was changed."; return 1; }
    if ! mv "$1" "$2" 2>/dev/null; then
      if mv "$SWAP_PREV" "$2" 2>/dev/null; then
        SWAP_DST=""; SWAP_PREV=""
        warn "Could not move the new launcher into place. The old one is unchanged."
      else
        warn "Could not move the new launcher into place, nor put the old one back. It is at:
    $SWAP_PREV
    Move it back to: $2"
        # Keep the stage: it holds the only copy of the launcher.
        SWAP_DST=""; SWAP_PREV=""; BUILD_STAGE=""
      fi
      return 1
    fi
    SWAP_DST=""; SWAP_PREV=""
  else
    mv "$1" "$2" 2>/dev/null || { warn "Could not create $2"; return 1; }
  fi
  return 0
}

_assemble_launcher() { # out, src_app, profile, data_dir, label, letter, hex, kind, extras
  local dst="$1" src_app="$2" profile="$3" data_dir="$4" label="$5" letter="$6" hex="$7" kind="$8"
  local extras="${9:-}" env_q="" args_q="" v exe_re=""
  # A pattern for any running copy of the app: its main executable, at the
  # start of the command line. Regex characters in the path are escaped.
  v=$(app_exe "$src_app") && exe_re="^$(printf '%s' "$v" | sed 's/[][\.*^$+?(){}|]/\\&/g')( |\$)"
  while IFS= read -r v; do [ -n "$v" ] && env_q="$env_q --env $(shquote "$v")"; done <<EOF
$(extras_lines env "$extras")
EOF
  while IFS= read -r v; do [ -n "$v" ] && args_q="$args_q $(shquote "$v")"; done <<EOF
$(extras_lines arg "$extras")
EOF
  if [ -n "$(extras_lines ext "$extras")" ]; then
    args_q="$args_q --extensions-dir=$(shquote "$data_dir/extensions")"
  fi

  mkdir -p "$dst/Contents/MacOS" "$dst/Contents/Resources" 2>/dev/null \
    || { warn "Could not create $dst"; return 1; }

  # The launcher is a plain shell script in a plain bundle. Every value it
  # carries is written with shquote, and the one AppleScript (the sign-in
  # guard) takes its words as arguments, never pasted into its source. -n
  # starts a new instance even
  # when the app is already running. For a main launcher that is the whole
  # point: Launch Services sees every profile as the same app, so opening the
  # app itself only switches to whichever profile is already running.
  {
    printf '#!/bin/sh\n'
    printf '# Generated by aidentity %s. Safe to delete.\n' "$AIDENTITY_VERSION"
    # `open` hands its own environment to the app, so a profile opened from a
    # terminal inherited NODE_OPTIONS, ELECTRON_* or VSCODE_* (which overrides
    # --extensions-dir). Drop those before opening. Names are read in the C
    # locale: under UTF-8, sed stops at the first value that is not valid text.
    cat <<'SCRUB'
set --
for name in $(/usr/bin/env | LC_ALL=C /usr/bin/sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'); do
  case "$name" in DYLD_*|LD_*|ELECTRON_*|NODE_*|VSCODE_*|CHROME_*|CHROMIUM_*|SSLKEYLOGFILE) set -- "$@" -u "$name" ;; esac
done
SCRUB
    if [ "$kind" != "main" ] && [ -n "$exe_re" ]; then
      # The sign-in guard. With several copies of one app running, macOS hands
      # an opened link to the copy that started first, and a browser sign-in
      # comes back as such a link. On a new profile's first open, while another
      # copy runs, say so once and offer to cancel. It only warns: if the
      # dialog cannot be shown, the profile opens anyway.
      printf 'data=%s\n' "$(shquote "$data_dir")"
      printf 'running=%s\n' "$(shquote "$exe_re")"
      printf 'label=%s\n' "$(shquote "$label")"
      printf 'name=%s\n' "$(shquote "$(bundle_name "$src_app")")"
      cat <<'GUARD'
if [ ! -e "$data/Local State" ] && [ ! -e "$data/Preferences" ] && [ ! -e "$data/Cookies" ] \
   && [ ! -d "$data/Default" ] && /usr/bin/pgrep -qf -U "$(/usr/bin/id -u)" "$running"; then
  answer=$(/usr/bin/osascript - "$label" "$name" 2>/dev/null <<'OSA'
on run argv
	set l to item 1 of argv
	set a to item 2 of argv
	try
		display dialog "Opening " & l & " for the first time." & return & return & "Another " & a & " is already open. If " & a & " signs you in through your browser, macOS returns the sign-in to the " & a & " that started first, not to this one." & return & return & "To be safe, quit the other " & a & " windows, sign in here, then open them again." buttons {"Cancel", "Open Anyway"} default button "Open Anyway" with title "aidentity" with icon caution
	on error number -128
		return "cancel"
	end try
	return "open"
end run
OSA
)
  [ "$answer" = "cancel" ] && exit 0
fi
GUARD
    fi
    if [ "$kind" = "main" ]; then
      printf 'exec /usr/bin/env "$@" /usr/bin/open -na %s%s%s\n' \
        "$(shquote "$src_app")" "$env_q" "${args_q:+ --args$args_q}"
    else
      printf 'exec /usr/bin/env "$@" /usr/bin/open -na %s%s --args --user-data-dir=%s%s\n' \
        "$(shquote "$src_app")" "$env_q" "$(shquote "$data_dir")" "$args_q"
    fi
  } > "$dst/Contents/MacOS/launcher" || { warn "Could not write the launcher script."; return 1; }
  chmod +x "$dst/Contents/MacOS/launcher"

  local bid
  bid="com.aidentity.$(slugify "$label")"

  local x_label x_profile x_src x_data
  x_label=$(xmlescape "$label")
  x_profile=$(xmlescape "$profile")
  x_src=$(xmlescape "$src_app")
  x_data=$(xmlescape "$data_dir")
  # Recorded so `set` and `rebuild` can regenerate the icon without asking the
  # user to remember what they picked. An empty badge means "no badge".
  local x_badge; x_badge=$(xmlescape "$letter")
  local x_main=""
  [ "$kind" = "main" ] && x_main="<key>AIdentityMain</key><true/>"

  cat > "$dst/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>$x_label</string>
	<key>CFBundleDisplayName</key><string>$x_label</string>
	<key>CFBundleIdentifier</key><string>$bid</string>
	<key>CFBundleExecutable</key><string>launcher</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$AIDENTITY_VERSION</string>
	<key>CFBundleVersion</key><string>$AIDENTITY_VERSION</string>
	<key>CFBundleIconFile</key><string>icon</string>
	<key>LSUIElement</key><true/>
	<key>$MARKER_KEY</key><string>$x_profile</string>
	<key>AIdentityTargetApp</key><string>$x_src</string>
	<key>AIdentityDataDir</key><string>$x_data</string>
	<key>AIdentityBadge</key><string>$x_badge</string>
	<key>AIdentityColor</key><string>$hex</string>
	$(extras_plist_xml "$extras")
	$x_main
</dict>
</plist>
PLIST

  # Never ship this. A bundle whose plist cannot be parsed is invisible to
  # is_our_launcher, which made it unremovable by rm and un-overwritable by add.
  # The staging directory is discarded, so nothing on disk changes.
  if ! plutil -lint "$dst/Contents/Info.plist" >/dev/null 2>&1; then
    warn "Generated a malformed Info.plist for '$label' — nothing was changed."
    return 1
  fi

  # An empty letter means the user asked for the app's own icon, untouched.
  local have_icon=1
  if [ -z "$letter" ]; then
    copy_plain_icon "$src_app" "$dst/Contents/Resources/icon.icns" || have_icon=0
  elif build_icon "$src_app" "$letter" "$hex" "$dst/Contents/Resources/icon.icns"; then
    :
  elif copy_plain_icon "$src_app" "$dst/Contents/Resources/icon.icns"; then
    warn "Could not badge the icon; using the app's own icon instead."
  else
    have_icon=0
  fi

  # Declaring an icon that is not there gives a broken-looking bundle. Drop the
  # key instead and say so, rather than claiming an icon we failed to write.
  if [ "$have_icon" -eq 0 ]; then
    /usr/libexec/PlistBuddy -c "Delete :CFBundleIconFile" "$dst/Contents/Info.plist" >/dev/null 2>&1 || true
    warn "$(bundle_name "$src_app") has no icon to copy; the launcher uses the default one."
  fi

  # Ad-hoc sign so the bundle is internally consistent. Not required to launch a
  # locally-built app, so a missing toolchain is a note, not an error.
  if command -v codesign >/dev/null 2>&1 && xcode-select -p >/dev/null 2>&1; then
    codesign --force --sign - "$dst" >/dev/null 2>&1 \
      || warn "Could not sign $label.app. It will still launch."
  fi
  # A proxy setting can carry a password: a launcher with settings is readable
  # by its owner only.
  if [ -n "$extras" ]; then
    chmod 600 "$dst/Contents/Info.plist" && chmod 700 "$dst/Contents/MacOS/launcher" \
      || { warn "Could not make $label.app owner-only."; return 1; }
  fi
  return 0
}

# -------------------------------------------------------------- commands --

cmd_apps() {
  local app n=0
  info "${C_BOLD}Apps on this Mac that aidentity can give extra accounts:${C_RESET}"
  info ""
  while IFS= read -r app; do
    [ -n "$app" ] || continue
    n=$((n+1))
    printf '  %-28s %s\n' "$(bundle_name "$app")" "$(dim "$(bundle_id "$app")")"
  done <<EOF
$(list_compatible_apps)
EOF
  info ""
  if [ "$n" -eq 0 ]; then
    warn "No compatible apps found."
    dim "  aidentity works with Chromium- and Electron-based apps."
  else
    dim "  $n app(s). Add one with:  aidentity add \"<name>\" --profile Work"
  fi
}

# Whether a profile directory has been used. Chromium browsers keep their
# profile in Default/, but Electron apps (Claude, Slack, VS Code, Notion) write
# straight into the root — so testing only for Default/ showed every signed-in
# Electron profile as "signed out / new".
profile_has_data() {
  local f
  for f in Default "Local State" Preferences Cookies "Local Storage"; do
    [ -e "$1/$f" ] && return 0
  done
  return 1
}

# What a launcher is doing, in the words list prints: running, in use,
# signed out / new, app missing, or not running (a main launcher). One place,
# so `list`, `list --json` and the menu can never disagree. Each argument is
# 1 or 0: a main launcher, the app is there, the profile is running, and its
# folder holds a signed-in session.
status_word() { # main, app present, running, has data
  local status
  if [ "$1" = "1" ]; then
    status="not running"
    [ "$3" = "1" ] && status="running"
  else
    status="signed out / new"
    [ "$4" = "1" ] && status="in use"
    [ "$3" = "1" ] && status="running"
  fi
  [ "$2" = "1" ] || status="app missing"
  printf '%s' "$status"
}

launcher_status() { # launcher, target app, data dir
  local main=0 present=0 run=0 has=0
  if is_main_launcher "$1"; then
    main=1
    main_running "$2" && run=1
  else
    profile_has_data "$3" && has=1
    running_on_profile "$3" && run=1
  fi
  [ -d "$2" ] && present=1
  status_word "$main" "$present" "$run" "$has"
}

cmd_list() {
  local json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -*) die "Unknown option for list: $1" ;;
      *) die "Unexpected argument: $1" ;;
    esac
  done
  if [ "$json" -eq 1 ]; then list_json; return; fi

  local app n=0 profile target data label status
  for app in "$APPS_DIR"/*.app; do
    [ -d "$app" ] || continue
    is_our_launcher "$app" || continue
    n=$((n+1))
    label=$(bundle_name "$app")
    profile=$(plist_get "$app" "$MARKER_KEY")
    target=$(plist_get "$app" "AIdentityTargetApp")
    data=$(plist_get "$app" "AIdentityDataDir")
    status=$(launcher_status "$app" "$target" "$data")
    case "$status" in
      running) status="${C_GREEN}running${C_RESET}" ;;
      "app missing") status="${C_YELLOW}app missing${C_RESET} — run: aidentity rebuild \"$label\"" ;;
    esac
    printf '%s%s%s\n' "$C_BOLD" "$label" "$C_RESET"
    printf '   app      %s\n' "$(bundle_name "$target")"
    printf '   profile  %s\n' "$profile"
    printf '   status   %s\n' "$status"
    if is_main_launcher "$app"; then
      printf '   data     %s\n' "$(dim "the app's own — your original account, never touched")"
    else
      printf '   data     %s\n' "$(dim "$data")"
    fi
    local ex sw envs
    ex=$(extras_of "$app/Contents/Info.plist")
    sw=$(extras_lines arg "$ex" | tr '\n' ' ')
    # Names only: a value may be a token or a password.
    envs=$(extras_lines env "$ex" | sed 's/=.*//' | tr '\n' ' ')
    [ -n "$sw" ] && printf '   flags    %s\n' "${sw% }"
    [ -n "$envs" ] && printf '   env      %s\n' "$(dim "${envs% } (values hidden)")"
    [ -n "$(extras_lines ext "$ex")" ] && printf '   ext      %s\n' "$(dim "its own extensions folder, inside the profile folder")"
    info ""
  done
  if [ "$n" -eq 0 ]; then
    info "No profiles yet."
    dim "  Create one with:  aidentity add"
  fi
}

# `list --json`: one JSON array, one object per launcher, for scripts and other
# front ends. The plain list is for people and may change its wording; these
# keys stay. Every object has every key, in this order:
#   name            launcher name, as `open`, `set` and `rm` take it
#   app, app_path   the app it opens: name and path (null if not recorded)
#   profile         profile name
#   data_dir        profile folder; null for a main launcher
#   main            true for a launcher that opens the app's own account
#   status          running, in use, signed out / new, app missing, not running
#   badge           badge character; null for the app's own icon
#   color           badge colour, six hex digits
#   built_by        the aidentity version that built it (null if not recorded)
#   args            launch switches
#   env             names of launch variables, never their values: a value
#                   may be a token or a password
#   own_extensions  true when a VS Code-style app has its own extensions folder
# Nothing else is written to stdout, so the output always parses: warnings go
# to stderr and there is no colour. No launchers prints [].
list_json() {
  local app n=0 profile target data label main ex obj
  for app in "$APPS_DIR"/*.app; do
    [ -d "$app" ] || continue
    is_our_launcher "$app" || continue
    label=$(bundle_name "$app")
    profile=$(plist_get "$app" "$MARKER_KEY")
    target=$(plist_get "$app" "AIdentityTargetApp")
    data=$(plist_get "$app" "AIdentityDataDir")
    main=false
    is_main_launcher "$app" && { main=true; data=""; }
    ex=$(extras_of "$app/Contents/Info.plist")
    obj="{\"name\":$(json_str "$label")"
    if [ -n "$target" ]; then
      obj="$obj,\"app\":$(json_str "$(bundle_name "$target")")"
    else
      obj="$obj,\"app\":null"
    fi
    obj="$obj,\"app_path\":$(json_str_or_null "$target")"
    obj="$obj,\"profile\":$(json_str "$profile")"
    obj="$obj,\"data_dir\":$(json_str_or_null "$data")"
    obj="$obj,\"main\":$main"
    obj="$obj,\"status\":$(json_str "$(launcher_status "$app" "$target" "$data")")"
    obj="$obj,\"badge\":$(json_str_or_null "$(launcher_badge "$app" "$target" "$profile")")"
    obj="$obj,\"color\":$(json_str "$(launcher_color "$app" "$label")")"
    obj="$obj,\"built_by\":$(json_str_or_null "$(plist_get "$app" CFBundleShortVersionString)")"
    obj="$obj,\"args\":$(json_lines "$(extras_lines arg "$ex")")"
    obj="$obj,\"env\":$(json_lines "$(extras_lines env "$ex" | sed 's/=.*//')")"
    if [ -n "$(extras_lines ext "$ex")" ]; then
      obj="$obj,\"own_extensions\":true}"
    else
      obj="$obj,\"own_extensions\":false}"
    fi
    if [ "$n" -eq 0 ]; then printf '[\n  %s' "$obj"; else printf ',\n  %s' "$obj"; fi
    n=$((n+1))
  done
  if [ "$n" -eq 0 ]; then printf '[]\n'; else printf '\n]\n'; fi
}

cmd_open() {
  local want="${1:-}"
  [ -n "$want" ] || die "Usage: aidentity open \"<profile>\""
  [ $# -le 1 ] || die "Unexpected argument: $2  (quote a name that has spaces)"
  local app="$APPS_DIR/$want.app"
  [ -d "$app" ] || die "No launcher named '$want'. Run 'aidentity list' to see what exists."
  assert_ours "$app"
  open "$app" || die "Could not open '$want'."
  # Braces are required here, not cosmetic. Bash folds a following multi-byte
  # character into the parameter name, so an unbraced name directly before the
  # ellipsis is read as part of the name and dies under `set -u`. A CI guard
  # enforces this, which is why the bad form is described rather than written.
  ok "Opening ${want}…"
}

cmd_rm() {
  local want="" purge=0 yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --purge) purge=1; shift ;;
      -y|--yes) yes=1; shift ;;
      -*) die "Unknown option for rm: $1" ;;
      # One name only. Taking the last of several made `rm A B --purge -y`
      # delete B and silently ignore A.
      *) [ -z "$want" ] && want="$1" || die "Unexpected argument: $1  (one profile at a time; quote a name that has spaces)"; shift ;;
    esac
  done
  [ -n "$want" ] || die "Usage: aidentity rm \"<profile>\" [--purge]"

  local app="$APPS_DIR/$want.app"
  [ -d "$app" ] || die "No launcher named '$want'. Run 'aidentity list' to see what exists."
  assert_ours "$app"

  # Read everything needed afterwards now — the launcher is about to go.
  local data target profile main=0
  data=$(plist_get "$app" "AIdentityDataDir")
  target=$(plist_get "$app" "AIdentityTargetApp")
  profile=$(plist_get "$app" "$MARKER_KEY")
  is_main_launcher "$app" && main=1

  if [ "$main" -eq 1 ] && [ "$purge" -eq 1 ]; then
    warn "'$want' opens $(bundle_name "$target")'s own account. aidentity never deletes that
    data, so --purge does nothing here; only the launcher is removed."
    purge=0
  fi

  if [ "$main" -eq 0 ] && running_on_profile "$data"; then
    die "'$want' is running right now. Quit it first, then re-run."
  fi

  if [ "$yes" -eq 0 ]; then
    if [ "$purge" -eq 1 ]; then
      printf 'Remove launcher "%s" AND permanently delete its data?\n  %s\n' "$want" "$data"
    elif [ "$main" -eq 1 ]; then
      printf 'Remove launcher "%s"? Your original account is not affected.\n' "$want"
    else
      printf 'Remove launcher "%s"? Its data is kept.\n' "$want"
    fi
    local reply; reply=$(ask 'Type yes to confirm: ')
    [ "$reply" = "yes" ] || die "Cancelled."
  fi

  # Launchers built before restore records existed get one now, while the
  # launcher still says what it was — so the hint below always works.
  if [ "$main" -eq 0 ] && [ "$purge" -eq 0 ] && [ -d "$data" ] && data_is_ours "$data" \
     && [ ! -f "$data/$RESTORE_RECORD" ]; then
    write_restore_record "$data" "$profile" "$target" \
      "$(launcher_badge "$app" "$target" "$profile")" "$(launcher_color "$app" "$want")" \
      "$(extras_of "$app/Contents/Info.plist")" || true
  fi

  # Move it aside first, delete it second. A locked bundle (or one owned by
  # someone else) survived rm -rf with its Info.plist gone — no longer
  # recognisable as ours, so its data then looked orphaned — and this still
  # printed "Removed" and went on to delete the data. A locked bundle cannot be
  # moved, so now it is refused whole, with nothing touched.
  BUILD_STAGE=$(mktemp -d "$APPS_DIR/.aidentity-rm.XXXXXX" 2>/dev/null) \
    || { BUILD_STAGE=""; die "Could not write to $APPS_DIR. Nothing was changed."; }
  if ! mv "$app" "$BUILD_STAGE/" 2>/dev/null; then
    _cleanup_stage
    die "Could not remove $app — it may be locked (Finder → Get Info) or
    owned by another user. Nothing was changed."
  fi
  local trash="$BUILD_STAGE"
  _cleanup_stage || warn "Part of the old launcher could not be deleted (a locked file?).
    It is out of the way, in: $trash"
  ok "Removed launcher '$want'."
  [ "$main" -eq 1 ] && return 0

  if [ "$purge" -eq 1 ]; then
    # Only delete inside our own data root — never an arbitrary recorded path.
    if ! data_is_ours "$data"; then
      warn "Profile data is outside the aidentity data directory; left in place:"
      dim "  $data"
      return 0
    fi
    # Launchers from 1.0.0 could share one directory. Deleting it would sign
    # the other launcher out too.
    local others; others=$(launchers_sharing "$data")
    if [ -n "$others" ]; then
      warn "Profile data kept — another launcher uses the same directory: $others"
      dim "  $data"
      return 0
    fi
    # Checked again: the confirmation above can sit for minutes, and the app
    # may have been opened in the meantime.
    if running_on_profile "$data"; then
      die "The profile was opened while waiting for confirmation. The launcher is
    gone, but its data was kept: $data"
    fi
    rm -rf "$data" 2>/dev/null
    if [ -e "$data" ]; then warn "Could not delete all of $data"; return 1; fi
    ok "Deleted profile data."
  else
    # `aidentity rm NAME --purge` cannot work any more — that launcher is gone,
    # which is what this used to suggest. These two do.
    dim "  Profile data kept at: $data"
    if [ -f "$data/$RESTORE_RECORD" ]; then
      dim "  To use this account again:  aidentity restore \"$want\""
    else
      local app_ref; app_ref=$(bundle_name "$target")
      [ "$(resolve_app "$app_ref" 2>/dev/null)" = "$target" ] || app_ref="$target"
      dim "  To use this account again:  aidentity add \"$app_ref\" --profile \"$profile\""
    fi
    dim "  To delete the data:         aidentity prune"
  fi
}

# Other launchers in the launcher directory that point at the same data
# directory as $1, however it is spelled. Prints their names, comma-separated.
launchers_sharing() { # data dir, [a launcher to leave out]
  local id app d names=""
  id=$(dir_id "$1") || return 0
  for app in "$APPS_DIR"/*.app; do
    [ -d "$app" ] || continue
    [ -n "${2:-}" ] && [ "$app" -ef "$2" ] && continue
    is_our_launcher "$app" || continue
    d=$(plist_get "$app" "AIdentityDataDir")
    [ "$(dir_id "$d")" = "$id" ] && names="${names:+$names, }$(bundle_name "$app")"
  done
  printf '%s' "$names"
}

# Find a moved app again by its name, accepting only a real Chromium or
# Electron .app that is not one of our launchers. resolve_app alone also
# returns plain folders — and given an empty name, an app folder itself — so a
# launcher with a damaged plist was "fixed" into opening /Applications.
refind_app() {
  local name found
  [ -n "$1" ] || return 1
  name=$(bundle_name "$1")
  [ -n "$name" ] || return 1
  found=$(resolve_app "$name" 2>/dev/null) || return 1
  case "$found" in *.app) ;; *) return 1 ;; esac
  is_our_launcher "$found" && return 1
  is_chromium_app_deep "$found" || return 1
  printf '%s' "$found"
}

# What is wrong with one launcher: one finding per line, "fix<TAB>message" for
# what `doctor --fix` repairs and "warn<TAB>message" for what needs a person.
launcher_findings() {
  local app="$1" label src data ver perms others tab n room fix
  tab=$(printf '\t')
  label=$(bundle_name "$app")
  src=$(plist_get "$app" AIdentityTargetApp)
  data=$(plist_get "$app" AIdentityDataDir)
  ver=$(plist_get "$app" CFBundleShortVersionString)
  if [ -z "$src" ]; then
    printf 'warn%sit records no app — remove it and add the profile again\n' "$tab"
  elif [ ! -d "$src" ]; then
    if [ -n "$(refind_app "$src")" ]; then
      printf 'fix%sits app moved; a rebuild finds it again\n' "$tab"
    else
      printf 'warn%sits app is gone: %s — reinstall it, then: aidentity rebuild "%s"\n' "$tab" "$src" "$label"
    fi
  elif ! is_chromium_app "$src"; then
    printf 'warn%s%s no longer looks like a Chromium or Electron app\n' "$tab" "$(bundle_name "$src")"
  fi
  if is_legacy_launcher "$app"; then
    printf 'fix%sbuilt by aidentity 1.0.0\n' "$tab"
  elif [ "$ver" != "$AIDENTITY_VERSION" ]; then
    printf 'fix%sbuilt by aidentity %s; a rebuild picks up %s\n' "$tab" "${ver:-(unknown)}" "$AIDENTITY_VERSION"
  fi
  [ -x "$app/Contents/MacOS/launcher" ] || printf 'fix%sits launcher script is missing\n' "$tab"
  is_main_launcher "$app" && return 0
  if [ -z "$data" ]; then
    printf 'warn%sit records no profile folder\n' "$tab"; return 0
  fi
  if ! data_is_ours "$data"; then
    printf 'warn%sits profile folder is outside the aidentity data folder: %s\n' "$tab" "$data"; return 0
  fi
  # Renaming is the fix, and the new name is the user's to choose.
  if is_vscode_family "$src"; then
    n=$(socket_path_bytes "$src" "$data")
    if [ "$n" -gt "$SOCKET_PATH_MAX" ]; then
      room=$(profile_name_room "$src")
      if [ "$room" -ge 1 ]; then
        fix="rename it to a name of at most $(count "$room" character): aidentity rename \"$label\" \"<new name>\""
      else
        fix="even a one-character name is too long in this data folder; remove it and add it again with a shorter AIDENTITY_DATA_ROOT"
      fi
      printf 'warn%s%s cannot open it: the socket path in its profile folder would be %s bytes, and macOS allows %s — %s\n' \
        "$tab" "$(bundle_name "$src")" "$n" "$SOCKET_PATH_MAX" "$fix"
    fi
  fi
  if [ ! -d "$data" ]; then
    printf 'warn%sits profile folder is gone, so it opens signed out\n' "$tab"; return 0
  fi
  [ -f "$data/$RESTORE_RECORD" ] || printf 'fix%sno restore record yet (made by an older aidentity)\n' "$tab"
  perms=$(/usr/bin/stat -f '%Lp' "$data" 2>/dev/null)
  [ "$perms" = "700" ] || printf 'fix%sother users can read its profile folder (mode %s)\n' "$tab" "$perms"
  others=$(launchers_sharing "$data" "$app")
  [ -z "$others" ] || printf 'warn%sshares its profile folder with: %s\n' "$tab" "$others"
  return 0
}

# Repair what launcher_findings marks "fix": a rebuild for anything about the
# launcher itself, chmod 700 for the profile folder's mode. Profile data inside
# the folder is never read or changed.
fix_launcher() {
  local app="$1" findings data rebuild=0 rc=0
  findings=$(launcher_findings "$app")
  case "$findings" in
    *"fix"$'\t'"its app moved"*|*"fix"$'\t'"built by"*|*"fix"$'\t'"its launcher script"*|*"fix"$'\t'"no restore record"*) rebuild=1 ;;
  esac
  data=$(plist_get "$app" AIdentityDataDir)
  case "$findings" in
    *"fix"$'\t'"other users can read"*)
      if data_is_ours "$data" && [ -d "$data" ]; then chmod 700 "$data" || rc=1; fi ;;
  esac
  # A launcher whose folder lies outside the data root needs a person: a
  # rebuild would recreate that folder wherever the plist says.
  if [ -n "$data" ] && ! data_is_ours "$data"; then rebuild=0; fi
  # Its notes (an app that moved, a 1.0.0 badge reset) are worth seeing.
  if [ "$rebuild" -eq 1 ]; then rebuild_one "$app" | sed 's/^/    /' || rc=1; fi
  return "$rc"
}

cmd_doctor() {
  local problems=0 fixable=0 fix=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --fix) fix=1; shift ;;
      -*) die "Unknown option for doctor: $1" ;;
      *) die "Unexpected argument: $1" ;;
    esac
  done

  info "${C_BOLD}aidentity doctor${C_RESET}"
  info ""
  printf '  macOS               %s\n' "$(sw_vers -productVersion 2>/dev/null || echo unknown)"
  printf '  aidentity           %s\n' "$AIDENTITY_VERSION"
  printf '  bash                %s\n' "${BASH_VERSION:-unknown}"

  if [ -d "$APPS_DIR" ] && [ -w "$APPS_DIR" ]; then
    printf '  launcher dir        %s\n' "$(printf '%sok%s %s' "$C_GREEN" "$C_RESET" "$APPS_DIR")"
  elif [ ! -d "$APPS_DIR" ]; then
    printf '  launcher dir        %s\n' "$(dim "will be created: $APPS_DIR")"
  else
    printf '  launcher dir        %sNOT WRITABLE%s %s\n' "$C_RED" "$C_RESET" "$APPS_DIR"; problems=$((problems+1))
  fi

  if xcode-select -p >/dev/null 2>&1; then
    printf '  codesign            %savailable%s (launchers will be signed)\n' "$C_GREEN" "$C_RESET"
  else
    printf '  codesign            %sabsent%s — launchers work, just unsigned\n' "$C_YELLOW" "$C_RESET"
    dim "                      install with: xcode-select --install"
  fi

  local n; n=$(list_compatible_apps | wc -l | tr -d ' ')
  printf '  compatible apps     %s found\n' "$n"
  [ "$n" -eq 0 ] && { warn "No Chromium/Electron apps detected."; problems=$((problems+1)); }

  local launchers=() app
  for app in "$APPS_DIR"/*.app; do
    [ -d "$app" ] || continue
    is_our_launcher "$app" && launchers+=("$app")
  done
  printf '  profiles            %s\n' "${#launchers[@]}"

  # One row per launcher. `--fix` repairs first, then the rows show what is left.
  if [ "${#launchers[@]}" -gt 0 ]; then
    info ""
    info "${C_BOLD}Profiles${C_RESET}"
    local findings kind msg failed=0
    for app in "${launchers[@]}"; do
      findings=$(launcher_findings "$app")
      if [ "$fix" -eq 1 ] && [ -n "$findings" ] && printf '%s\n' "$findings" | grep -q '^fix'; then
        if fix_launcher "$app"; then
          printf '  %s✓%s %s %s\n' "$C_GREEN" "$C_RESET" "$(bundle_name "$app")" "$(dim "— fixed")"
        else
          failed=$((failed+1))
        fi
        findings=$(launcher_findings "$app")
      fi
      if [ -z "$findings" ]; then
        [ "$fix" -eq 1 ] || printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$(bundle_name "$app")"
        continue
      fi
      while IFS="$(printf '\t')" read -r kind msg; do
        [ -n "$kind" ] || continue
        problems=$((problems+1))
        [ "$kind" = "fix" ] && fixable=$((fixable+1))
        printf '  %s!%s %s — %s\n' "$C_YELLOW" "$C_RESET" "$(bundle_name "$app")" "$msg"
      done <<EOF
$findings
EOF
    done
  fi

  local orphans; orphans=$(orphan_dirs | grep -c . || true)
  if [ "${orphans:-0}" -gt 0 ]; then
    info ""
    printf '  %s!%s %s profile folder(s) have no launcher — see: aidentity restore, aidentity prune\n' \
      "$C_YELLOW" "$C_RESET" "$orphans"
    problems=$((problems+1))
  fi

  info ""
  if [ "$problems" -eq 0 ]; then
    ok "No problems found."
  elif [ "$fixable" -gt 0 ]; then
    warn "$problems problem(s) found. $fixable can be fixed with: aidentity doctor --fix"
  else
    warn "$problems problem(s) found."
  fi
  # doctor reports; it does not fail. Only a --fix that could not fix
  # something exits non-zero.
  [ "$fix" -eq 1 ] && [ "${failed:-0}" -gt 0 ] && return 1
  return 0
}

cmd_add() {
  local app_arg="" profile="" badge="" color="" seed=0 no_badge=0 main=0 extras=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --profile|-p) need_value "$1" "${2:-}"; profile="$2"; shift 2 ;;
      --badge|-b)   need_value "$1" "${2:-}"; badge="$2";   shift 2 ;;
      --color|--colour|-c) need_value "$1" "${2:-}"; color="$2"; shift 2 ;;
      --no-badge)   no_badge=1; shift ;;
      --seed)       seed=1; shift ;;
      --main)       main=1; shift ;;
      --arg)        [ -n "${2:-}" ] || die "--arg needs a switch, e.g.  --arg --lang=de"
                    validate_switch "$2" || exit 1
                    extras="${extras:+$extras
}arg$TAB$2"; shift 2 ;;
      --env)        [ -n "${2:-}" ] || die "--env needs NAME=value"
                    validate_env "$2" || exit 1
                    extras="${extras:+$extras
}env$TAB$2"; shift 2 ;;
      --own-extensions) extras="${extras:+$extras
}ext${TAB}1"; shift ;;
      --)           shift; break ;;
      -*)           die "Unknown option for add: $1" ;;
      *)            [ -z "$app_arg" ] && app_arg="$1" || die "Unexpected argument: $1"; shift ;;
    esac
  done

  # ---- interactive wizard when arguments are missing ----
  if [ -z "$app_arg" ]; then
    have_tty || die "No app given. Usage: aidentity add \"<app>\" --profile \"<name>\""
    app_arg=$(pick_app) || exit 1
    info ""
  fi

  if [ "$main" -eq 1 ]; then
    [ -n "$profile" ] || profile="Main"
  elif [ -z "$profile" ]; then
    # Ask for the account name. 1.0.0 did; a refactor in 1.1.0 lost the prompt,
    # so `aidentity add` picked an app and then failed on the empty name. The
    # app is vetted first, so nobody names an account for an app that is then
    # refused.
    local src_app; src_app=$(resolve_target_app "$app_arg") || exit 1
    have_tty || die "No profile name given. Use --profile \"<name>\"."
    while :; do
      profile=$(ask 'Name this account (e.g. Work, Personal, Client): ') || exit 1
      validate_profile_name "$profile" && break
    done
    app_arg="$src_app"
  fi

  create_profile "$app_arg" "$profile" "$badge" "$color" "$seed" "$no_badge" "$main" "$extras" || exit 1
}

# Resolve and vet the app a launcher would open. Prints its bundle path, or
# warns and returns non-zero if it is missing, is one of our own launchers, or
# has no separate-profile switch.
resolve_target_app() {
  local app_arg="$1" src_app
  src_app=$(resolve_app "$app_arg") || {
    warn "Could not find an app called '$app_arg'. Run 'aidentity apps' to see what is available."
    return 1; }

  if is_our_launcher "$src_app"; then
    warn "'$app_arg' is an aidentity launcher, not an app. Pick the real app."
    return 1
  fi

  if ! is_chromium_app_deep "$src_app"; then
    warn "$(bundle_name "$src_app") is not a Chromium- or Electron-based app, so it has no
    separate-profile switch. aidentity cannot give it extra accounts yet.
    See: https://github.com/PiniShv/aidentity#which-apps-work"
    return 1
  fi
  printf '%s' "$src_app"
}

# The --main launcher already built for an app, if there is one.
main_launcher_for() {
  local app
  for app in "$APPS_DIR"/*.app; do
    [ -d "$app" ] || continue
    is_our_launcher "$app" || continue
    is_main_launcher "$app" || continue
    [ "$(plist_get "$app" "AIdentityTargetApp")" = "$1" ] && { printf '%s' "$app"; return 0; }
  done
  return 1
}

# Create one profile end to end. Returns non-zero on any failure instead of
# exiting, so the wizard can report it and carry on with the next account.
# cmd_add is the CLI wrapper; cmd_setup calls this directly.
# main=1 builds a launcher for the app's own, original account instead.
create_profile() {
  local app_arg="$1" profile="$2" badge="$3" color="$4" seed="$5" no_badge="${6:-0}" main="${7:-0}"
  local extras="${8:-}"

  local src_app
  src_app=$(resolve_target_app "$app_arg") || return 1

  validate_profile_name "$profile" || return 1

  local label; label="$(bundle_name "$src_app") $profile"
  local slug;  slug="$(slugify "$label")"
  local data_dir="" kind=""
  local dst="$APPS_DIR/$label.app"

  if [ "$main" -eq 1 ]; then
    kind="main"
    # One is enough. Two launchers for the same original account would only
    # be two names for one thing.
    local other; other=$(main_launcher_for "$src_app")
    if [ -n "$other" ] && [ "$other" != "$dst" ]; then
      warn "'$(bundle_name "$other")' already opens your original $(bundle_name "$src_app") account."
      return 1
    fi
  else
    data_dir="$DATA_ROOT/$slug"
    # slugify folds spaces, underscores and hyphens together and drops
    # non-ASCII, so "Work 2", "Work_2" and "Work-2" all produced ONE data
    # directory. Three launchers then shared a single profile — the opposite
    # of the tool's job.
    if [ -z "$slug" ]; then
      warn "Cannot derive a profile directory from '$label'.
    Use a name containing at least one letter or number."
      return 1
    fi
    local existing
    for existing in "$APPS_DIR"/*.app; do
      [ -d "$existing" ] || continue
      is_our_launcher "$existing" || continue
      [ "$(bundle_name "$existing")" = "$label" ] && continue
      local theirs; theirs=$(plist_get "$existing" "AIdentityDataDir")
      # Same text, or the same directory spelled another way.
      if [ "$theirs" = "$data_dir" ] || { [ -n "$(dir_id "$theirs")" ] &&
           [ "$(dir_id "$theirs")" = "$(dir_id "$data_dir")" ]; }; then
        warn "'$label' would share its profile directory with '$(bundle_name "$existing")':
      $data_dir
    Spaces, underscores, hyphens and capitals are treated the same. Pick a more distinct name."
        return 1
      fi
    done
  fi

  # Never turn a separate profile into a main launcher or back by re-adding
  # under the same name. The profile's data would be left with nothing pointing
  # at it — and that is exactly what `prune` deletes.
  if [ -e "$dst" ] && is_our_launcher "$dst"; then
    local was=""
    is_main_launcher "$dst" && was="main"
    if [ "$was" != "$kind" ]; then
      if [ "$was" = "main" ]; then
        warn "'$label' already opens your original account. Pick another profile name."
      else
        warn "'$label' is already a separate profile. Pick another name for the original account:
      aidentity add \"$(bundle_name "$src_app")\" --main --profile Original"
      fi
      return 1
    fi
  fi

  # Adding a profile that already exists rebuilds its launcher. It keeps the
  # badge and colour it has unless new ones are given; re-adding used to reset
  # a hand-picked colour to the default and call the result "Created".
  local existing_launcher=0
  [ -e "$dst" ] && is_our_launcher "$dst" && existing_launcher=1

  # An existing profile keeps the folder it records. Recomputing it from the
  # data root repointed the launcher at a new, empty folder whenever
  # AIDENTITY_DATA_ROOT differed from the shell it was made in — signed out,
  # with the real session left for prune.
  if [ "$existing_launcher" -eq 1 ] && [ "$kind" != "main" ]; then
    local recorded; recorded=$(plist_get "$dst" AIdentityDataDir)
    if [ -n "$recorded" ] && [ "$recorded" != "$data_dir" ]; then
      dim "  Keeping its profile folder: $recorded"
      data_dir="$recorded"
    fi
  fi

  if [ -n "$data_dir" ]; then
    local why=new
    [ "$existing_launcher" -eq 1 ] && why=existing
    socket_path_ok "$src_app" "$data_dir" "$label" "$why" || return 1
  fi

  if [ "$no_badge" -eq 1 ]; then
    badge=""
  elif [ -n "$badge" ]; then
    local wanted="$badge"
    badge=$(first_char "$badge")
    # Bytes that are not text (a Latin-1 é, say) cut to nothing, which would
    # quietly mean "no badge". Say so and use the default instead.
    if [ -z "$badge" ]; then
      badge=$(first_upper "$profile")
      warn "'$wanted' is not a character that can be drawn; using the badge $badge."
    fi
  elif [ "$existing_launcher" -eq 1 ]; then
    badge=$(launcher_badge "$dst" "$src_app" "$profile")
  else
    badge=$(first_upper "$profile")
  fi

  local hex
  if [ -n "$color" ]; then
    hex=$(color_hex "$color") || {
      warn "Unknown colour '$color'. Try one of: $COLOR_NAMES, or a hex value like 2E7DF6."
      return 1; }
  elif [ "$existing_launcher" -eq 1 ]; then
    hex=$(launcher_color "$dst" "$label")
  else
    hex=$(color_hex "$(auto_color "$label")")
  fi

  # Launch settings an existing profile has are kept, new ones win, and a
  # setting given twice counts once.
  if [ "$existing_launcher" -eq 1 ]; then
    extras=$(extras_merge "$(filter_extras "$(extras_of "$dst/Contents/Info.plist")" "$src_app" "$kind")" "$extras")
  else
    extras=$(extras_merge "" "$extras")
  fi

  if [ -e "$APPS_DIR/$label.app" ] && ! is_our_launcher "$APPS_DIR/$label.app"; then
    warn "There is already something at $APPS_DIR/$label.app that aidentity did not create.
    Refusing to overwrite it. Pick a different profile name."
    return 1
  fi

  if [ -n "$data_dir" ] && running_on_profile "$data_dir"; then
    warn "'$label' is running right now. Quit it, then re-run."
    return 1
  fi

  # Called directly, NOT via $(…). In a command substitution the builder runs in
  # a subshell, so a failure there could not stop the caller printing
  # "✓ Created" after a failed build.
  local had_data=0
  [ -n "$data_dir" ] && [ -d "$data_dir" ] && had_data=1
  if ! build_launcher "$src_app" "$profile" "$data_dir" "$label" "$badge" "$hex" "$kind" "$extras"; then
    # Leave no empty directory behind for `prune` to report later.
    [ "$had_data" -eq 0 ] && [ -n "$data_dir" ] && rmdir "$data_dir" 2>/dev/null
    return 1
  fi

  if [ "$seed" -eq 1 ]; then
    local primary="$HOME/Library/Application Support/Claude/claude_desktop_config.json"
    if [ "$(bundle_id "$src_app")" != "com.anthropic.claudefordesktop" ]; then
      warn "--seed only applies to Claude Desktop; ignoring it for $(bundle_name "$src_app")."
    elif [ "$main" -eq 1 ]; then
      dim "  Nothing to seed — the original account already has your config."
    elif [ -f "$primary" ] && [ ! -f "$data_dir/claude_desktop_config.json" ]; then
      # Owner-only: MCP server entries often carry API keys in their env.
      cp "$primary" "$data_dir/claude_desktop_config.json" \
        && chmod 600 "$data_dir/claude_desktop_config.json" \
        && ok "Copied your MCP server config into the new profile."
    else
      dim "  Nothing to seed (no existing config, or the profile already has one)."
    fi
  fi

  local app_name; app_name=$(bundle_name "$src_app")
  info ""
  if [ "$existing_launcher" -eq 1 ] && [ "$main" -eq 1 ]; then
    ok "Updated ${C_BOLD}$label${C_RESET} — it already existed"
  elif [ "$existing_launcher" -eq 1 ]; then
    ok "Updated ${C_BOLD}$label${C_RESET} — it already existed; its profile data was not touched"
  else
    ok "Created ${C_BOLD}$label${C_RESET}"
  fi
  printf '   launcher  %s\n' "$dst"
  if [ "$main" -eq 1 ]; then
    printf '   opens     %s\n' "$(dim "your original $app_name account, with $app_name's own data")"
    info ""
    info "${C_BOLD}Next:${C_RESET}"
    printf '  Drag %s onto your Dock in place of %s.app.\n' "$(basename "$dst")" "$app_name"
    info ""
    dim "  While any profile is running, macOS treats it as $app_name itself, so"
    dim "  clicking $app_name.app only switches to that profile. This launcher always"
    dim "  opens your original account."
    return 0
  fi
  printf '   profile   %s\n' "$(dim "$data_dir")"
  info ""
  info "${C_BOLD}Next:${C_RESET}"
  printf '  1. Open it:      aidentity open "%s"\n' "$label"
  printf '  2. Sign in with the other account in the window that appears.\n'
  if app_running "$src_app"; then
    printf '     %s is open already: quit it for this first sign-in. A browser\n' "$app_name"
    printf '     sign-in goes back to the %s that started first, not to this one.\n' "$app_name"
  fi
  printf '  3. Keep it handy: drag %s from Finder onto your Dock.\n' "$(basename "$dst")"
  info ""
  dim "  Nothing to re-run when the app updates — the launcher holds no copy of it."
  return 0
}

# The guided walkthrough. This is what a first-time user sees, and what the
# installer offers to run at the end of a `curl | bash`.
cmd_setup() {
  have_tty || die "aidentity setup needs a terminal. Use 'aidentity add' with flags instead."

  info ""
  info "${C_BOLD}Welcome to aidentity.${C_RESET}"
  info ""
  info "macOS runs one copy of an app, so one account at a time. This sets up extra"
  info "copies of an app you already have, each signed into a different account, all"
  info "running together."
  info ""
  dim  "Your existing app and its current account are not touched."
  info ""

  local badge_style="badge"
  if ! confirm "Add a small coloured badge to each icon so you can tell them apart?" y; then
    badge_style="plain"
    dim "  Using the app's own icon with your chosen name."
  fi
  info ""

  local made=0 src_app profile main_declined="|"
  while :; do
    src_app=$(pick_app) || break
    info ""

    # validate_profile_name now prints the ACTUAL reason and returns a status,
    # so a bad name re-prompts with a message that matches why it was refused.
    while :; do
      profile=$(ask 'Name this account (e.g. Work, Personal, Client): ') || break 2
      validate_profile_name "$profile" && break
    done

    local seed=0
    if [ "$(bundle_id "$src_app")" = "com.anthropic.claudefordesktop" ] &&
       [ -f "$HOME/Library/Application Support/Claude/claude_desktop_config.json" ]; then
      confirm "Copy your existing MCP server config into this profile?" y && seed=1
    fi

    local nb=0
    [ "$badge_style" = "plain" ] && nb=1

    info ""
    # create_profile RETURNS a status. The old code called cmd_add, whose every
    # failure path was `exit 1`, so this else branch was unreachable and one bad
    # answer ended the whole walkthrough.
    if create_profile "$src_app" "$profile" "" "" "$seed" "$nb"; then
      made=$((made+1))
      offer_main_launcher "$src_app" "$nb"
    else
      info ""
      warn "That one did not work — nothing was created for it. Carrying on."
    fi

    info ""
    confirm "Set up another account?" y || break
    info ""
  done

  info ""
  if [ "$made" -eq 0 ]; then
    info "Nothing set up. Run ${C_BOLD}aidentity setup${C_RESET} again whenever you like."
    return 0
  fi

  ok "Done — $made profile(s) created."
  info ""
  info "${C_BOLD}To use them:${C_RESET}"
  info "  1. Open Finder → Go → Home → Applications."
  info "  2. Drag each new icon onto your Dock."
  info "  3. Click one, sign in with that account, and leave it signed in."
  info ""
  dim  "  See them any time with:  aidentity list"

  if confirm "Open the Applications folder now?" y; then
    open "$APPS_DIR" 2>/dev/null || true
  fi
}

# Offered in the walkthrough after an app's first new profile, until the app
# has a main launcher or the person says no. While any profile runs, macOS
# treats it as the app itself, so clicking the app switches to that profile
# instead of opening the original account. A --main launcher always opens the
# original. A "no" is remembered for the rest of the walkthrough in
# cmd_setup's main_declined (bash locals are visible to the functions a
# function calls).
offer_main_launcher() {
  local src_app="$1" nb="$2" name
  name=$(bundle_name "$src_app")
  main_launcher_for "$src_app" >/dev/null && return 0
  [ -e "$APPS_DIR/$name Main.app" ] && return 0
  case "${main_declined:-}" in *"|$src_app|"*) return 0 ;; esac
  info ""
  dim "  While a profile is running, clicking $name.app only switches to that profile."
  if confirm "Add a '$name Main' launcher that always opens your original account?" y; then
    info ""
    create_profile "$src_app" "Main" "" "" 0 "$nb" 1 \
      || warn "Skipped. Add it later with: aidentity add \"$name\" --main"
  else
    main_declined="${main_declined:-|}$src_app|"
  fi
  return 0
}

# Resolve a profile label to the launcher bundle that carries it, or explain.
# The path comes back spelled as it is on disk: the disk ignores case, and
# `set "claude work"` used to rebuild the launcher under the typed spelling.
launcher_for() {
  local want="$1" a
  local app="$APPS_DIR/$want.app"
  [ -n "$want" ] || { warn "Which profile? Run 'aidentity list' to see them."; return 1; }
  if [ ! -d "$app" ]; then
    warn "No profile named '$want'. Run 'aidentity list' to see what exists."
    return 1
  fi
  if ! is_our_launcher "$app"; then
    warn "'$want' was not created by aidentity — refusing to touch it."
    return 1
  fi
  # The real bundle, by name, ignoring case. Not by -ef: a symlink pointing
  # at the launcher matched too, and an alias sorting first was renamed or
  # rebuilt instead of the launcher itself.
  local want_lc; want_lc=$(lower "$want.app")
  for a in "$APPS_DIR"/*.app; do
    [ -L "$a" ] && continue
    [ "$(lower "$(basename "$a")")" = "$want_lc" ] && { app="$a"; break; }
  done
  printf '%s' "$app"
}

# Every aidentity launcher that can be found, one path per line: the launcher
# directory and folders inside it, the app search path, and whatever Spotlight
# knows. `prune` deletes data that no launcher claims, so a launcher it cannot
# see is a signed-in session it would delete. Looking only in the launcher
# directory deleted the data of any launcher moved somewhere else.
#
# find runs with -H so a symlinked launcher directory is followed, as the old
# "$APPS_DIR"/*.app glob was; without it a symlinked ~/Applications looked
# empty and prune deleted every profile behind it. Our own hidden .aidentity-*
# staging folders, and the Trash, hold launchers on their way out: they claim
# nothing, or a launcher deleted in Finder would keep its data from prune.
all_launchers() {
  local dir app
  {
    for app in "$APPS_DIR"/*.app; do [ -d "$app" ] && printf '%s\n' "$app"; done
    find -H "$APPS_DIR" -maxdepth 3 -type d -name '.aidentity-*' -prune \
      -o -type d -name '*.app' -print -prune 2>/dev/null
    while IFS= read -r dir; do
      [ -d "$dir" ] && find -H "$dir" -maxdepth 2 -type d -name '.aidentity-*' -prune \
        -o -type d -name '*.app' -print -prune 2>/dev/null
    done <<EOF
$(app_search_dirs)
EOF
    if command -v mdfind >/dev/null 2>&1; then
      mdfind "kMDItemCFBundleIdentifier == 'com.aidentity.*'" 2>/dev/null
    fi
  } | awk 'NF && !seen[$0]++' | while IFS= read -r dir; do
    case "$dir" in */.aidentity-*|*/.Trash/*|*/.Trashes/*) continue ;; esac
    is_our_launcher "$dir" && printf '%s\n' "$dir"
  done
}

# The identity of every data directory a launcher points at, space-separated.
claimed_dir_ids() {
  local app d id ids=" "
  while IFS= read -r app; do
    [ -n "$app" ] || continue
    d=$(plist_get "$app" "AIdentityDataDir")
    [ -n "$d" ] || continue
    id=$(dir_id "$d") && ids="$ids$id "
  done <<EOF
$(all_launchers)
EOF
  printf '%s' "$ids"
}

human_bytes() {
  [ -d "$1" ] || { printf '0B'; return 0; }
  du -sh "$1" 2>/dev/null | awk '{print $1}' || printf '?'
}

cmd_rename() {
  local from="" to=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) die "Unknown option for rename: $1" ;;
      *) if [ -z "$from" ]; then from="$1"; elif [ -z "$to" ]; then to="$1";
         else die "Usage: aidentity rename \"<profile>\" \"<new name>\""; fi; shift ;;
    esac
  done
  [ -n "$from" ] && [ -n "$to" ] || die "Usage: aidentity rename \"<profile>\" \"<new name>\""

  local app; app=$(launcher_for "$from") || exit 1
  validate_profile_name "$to" || exit 1
  from=$(bundle_name "$app")

  local src_app old_data profile badge hex kind=""
  src_app=$(plist_get "$app" "AIdentityTargetApp")
  old_data=$(plist_get "$app" "AIdentityDataDir")
  profile=$(plist_get "$app" "$MARKER_KEY")
  is_main_launcher "$app" && kind="main"
  badge=$(launcher_badge "$app" "$src_app" "$profile")
  hex=$(launcher_color "$app" "$from")

  [ -d "$src_app" ] || die "'$from' points at an app that is no longer there:
    $src_app
    Run 'aidentity rebuild' after reinstalling it, or remove the profile."

  # A badge that was only the old name's first letter follows the new name;
  # "Client" kept the "W" of "Work". A badge chosen by hand stays.
  if [ -n "$badge" ] && [ "$badge" = "$(first_upper "$profile")" ]; then
    badge=$(first_upper "$to")
  fi

  local new_label; new_label="$(bundle_name "$src_app") $to"
  local new_slug;  new_slug="$(slugify "$new_label")"
  local new_app="$APPS_DIR/$new_label.app"

  [ "$new_label" = "$from" ] && die "'$from' already has that name."

  # On a disk that ignores case, "Work" -> "work" names this very bundle. That
  # is a rename of this launcher, not a collision with another one.
  if [ -e "$new_app" ] && ! [ "$new_app" -ef "$app" ]; then
    die "There is already something at $new_app. Pick another name."
  fi

  local new_data="" moved=0
  if [ "$kind" != "main" ]; then
    [ -n "$new_slug" ] || die "Cannot derive a profile directory from '$new_label'."
    new_data="$DATA_ROOT/$new_slug"

    # Renaming while the app is open would move the directory out from under a
    # live Chromium instance.
    if running_on_profile "$old_data"; then
      die "'$from' is running right now. Quit it, then rename."
    fi

    # Names that differ only in case, or in spaces against hyphens, keep the
    # same directory. Nothing needs to move, and the old -e test refused them.
    if [ "$new_data" = "$old_data" ] || { [ -n "$(dir_id "$old_data")" ] &&
         [ "$(dir_id "$old_data")" = "$(dir_id "$new_data")" ]; }; then
      new_data="$old_data"
    elif [ -e "$new_data" ]; then
      die "A profile directory already exists at:
      $new_data
    Pick a name that does not collide with an existing profile."
    fi

    socket_path_ok "$src_app" "$new_data" "$new_label" new || exit 1

    # Move the data FIRST. If the rebuild then fails, it is moved back and
    # the old launcher, untouched, still points at it.
    if [ "$new_data" != "$old_data" ] && [ -d "$old_data" ]; then
      data_is_ours "$old_data" || die "'$from' records a profile directory outside the aidentity
    data root, so renaming it is not safe:
      $old_data"
      mv "$old_data" "$new_data" || die "Could not move the profile directory to $new_data"
      moved=1
      RENAME_UNDO="$new_data|$old_data"
    fi
  fi

  if ! build_launcher "$src_app" "$to" "$new_data" "$new_label" "$badge" "$hex" "$kind" \
       "$(filter_extras "$(extras_of "$app/Contents/Info.plist")" "$src_app" "$kind")"; then
    RENAME_UNDO=""
    if [ "$moved" -eq 1 ] && ! mv "$new_data" "$old_data" 2>/dev/null; then
      die "Could not build the renamed launcher, and could not move the profile back.
    The signed-in data is at: $new_data
    Move it back to $old_data by hand; '$from' still points there."
    fi
    die "Could not build the renamed launcher. Nothing was changed."
  fi

  # The new launcher is in place and points at the moved data: an interrupt
  # from here on must not move it back.
  RENAME_UNDO=""

  # After a case-only rename the old path IS the new launcher. Deleting it
  # would delete the launcher just built.
  if ! [ "$app" -ef "$new_app" ]; then
    rm -rf "$app" 2>/dev/null
    [ -e "$app" ] && warn "Could not remove the old launcher; delete it by hand: $app"
  fi
  ok "Renamed ${C_BOLD}$from${C_RESET} to ${C_BOLD}$new_label${C_RESET}"
  if [ "$kind" = "main" ]; then
    dim "  It still opens your original account."
  elif [ "$moved" -eq 1 ]; then
    printf '   profile   %s\n' "$(dim "$new_data")"
    dim "  The account stays signed in — only the name and directory moved."
  else
    printf '   profile   %s\n' "$(dim "$new_data")"
    dim "  The account stays signed in — only the name changed."
  fi
}

cmd_set() {
  local want="" badge="" color="" no_badge=0 changed=0 add_extras="" clear_args=0 clear_env=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --badge|-b) need_value "$1" "${2:-}"; badge="$2"; shift 2 ;;
      --color|--colour|-c) need_value "$1" "${2:-}"; color="$2"; shift 2 ;;
      --no-badge) no_badge=1; shift ;;
      --arg) [ -n "${2:-}" ] || die "--arg needs a switch, e.g.  --arg --lang=de"
             validate_switch "$2" || exit 1
             add_extras="${add_extras:+$add_extras
}arg$TAB$2"; shift 2 ;;
      --env) [ -n "${2:-}" ] || die "--env needs NAME=value"
             validate_env "$2" || exit 1
             add_extras="${add_extras:+$add_extras
}env$TAB$2"; shift 2 ;;
      --clear-args) clear_args=1; shift ;;
      --clear-env)  clear_env=1; shift ;;
      --own-extensions)    add_extras="${add_extras:+$add_extras
}ext${TAB}1"; shift ;;
      --shared-extensions) add_extras="${add_extras:+$add_extras
}noext"; shift ;;
      -*) die "Unknown option for set: $1" ;;
      *) [ -z "$want" ] && want="$1" || die "Unexpected argument: $1"; shift ;;
    esac
  done
  [ -n "$want" ] || die "Usage: aidentity set \"<profile>\" [--color NAME] [--badge X] [--no-badge]
    [--arg SWITCH] [--env NAME=value] [--clear-args] [--clear-env]
    [--own-extensions | --shared-extensions]"
  [ -n "$badge" ] || [ -n "$color" ] || [ "$no_badge" -eq 1 ] || [ -n "$add_extras" ] \
    || [ "$clear_args" -eq 1 ] || [ "$clear_env" -eq 1 ] \
    || die "Nothing to change. Pass --color, --badge, --no-badge, --arg, --env,
    --clear-args, --clear-env, --own-extensions or --shared-extensions."

  local app; app=$(launcher_for "$want") || exit 1
  want=$(bundle_name "$app")

  local src_app profile data_dir cur_badge cur_hex kind=""
  src_app=$(plist_get "$app" "AIdentityTargetApp")
  profile=$(plist_get "$app" "$MARKER_KEY")
  data_dir=$(plist_get "$app" "AIdentityDataDir")
  is_main_launcher "$app" && kind="main"
  cur_badge=$(launcher_badge "$app" "$src_app" "$profile")
  cur_hex=$(launcher_color "$app" "$want")

  [ -d "$src_app" ] || die "'$want' points at an app that is no longer there:
    $src_app"

  local new_badge="$cur_badge" new_hex="$cur_hex"
  if [ "$no_badge" -eq 1 ]; then
    new_badge=""; changed=1
  elif [ -n "$badge" ]; then
    new_badge=$(first_char "$badge"); changed=1
    [ -n "$new_badge" ] || die "'$badge' is not a character that can be drawn as a badge."
  fi
  if [ -n "$color" ]; then
    new_hex=$(color_hex "$color") \
      || die "Unknown colour '$color'. Try one of: $COLOR_NAMES, or a hex value like 2E7DF6."
    changed=1
    # Asking for a colour with no badge showing is almost certainly a mistake.
    [ -z "$new_badge" ] && [ "$no_badge" -eq 0 ] && {
      new_badge=$(first_upper "$profile")
      dim "  No badge was set, so --color added one: $new_badge"
    }
  fi
  local extras settings_changed=0
  extras=$(filter_extras "$(extras_of "$app/Contents/Info.plist")" "$src_app" "$kind")
  if [ "$clear_args" -eq 1 ]; then extras=$(printf '%s\n' "$extras" | /usr/bin/grep -v "^arg$TAB" || true); changed=1; settings_changed=1; fi
  if [ "$clear_env" -eq 1 ];  then extras=$(printf '%s\n' "$extras" | /usr/bin/grep -v "^env$TAB" || true); changed=1; settings_changed=1; fi
  if [ -n "$add_extras" ]; then extras=$(extras_merge "$extras" "$add_extras"); changed=1; settings_changed=1; fi
  [ "$changed" -eq 1 ] || die "Nothing to change."

  # Only the launcher bundle is rewritten; the profile directory is untouched,
  # so the account stays signed in even if the app is open right now.
  build_launcher "$src_app" "$profile" "$data_dir" "$want" "$new_badge" "$new_hex" "$kind" "$extras" || exit 1
  ok "Updated ${C_BOLD}$want${C_RESET}"
  if [ "$settings_changed" -eq 1 ]; then
    dim "  The signed-in account is untouched. New launch settings apply the next time"
    dim "  this profile opens; quit it first if it is open now."
  else
    dim "  The signed-in account is untouched — only the icon changed."
  fi
}

# Profile directories in the data root that no launcher points at, one per
# line. Compared by directory identity, not by spelling: a string match made a
# live profile look orphaned whenever its launcher recorded the root
# differently — a symlinked root, a trailing slash, /tmp against /private/tmp.
orphan_dirs() {
  local claimed d id
  [ -d "$DATA_ROOT" ] || return 0
  claimed=$(claimed_dir_ids)
  for d in "$DATA_ROOT"/*; do
    [ -d "$d" ] || continue
    id=$(dir_id "$d") || continue
    case "$claimed" in *" $id "*) continue ;; esac
    printf '%s\n' "$d"
  done
}

# The launcher name a profile directory's restore record would rebuild, e.g.
# "Claude Work". Fails when the directory has no readable record.
restore_label() {
  local profile src
  [ -f "$1/$RESTORE_RECORD" ] || return 1
  profile=$(record_get "$1" "$MARKER_KEY") || return 1
  src=$(record_get "$1" AIdentityTargetApp) || return 1
  [ -n "$profile" ] && [ -n "$src" ] || return 1
  # Printed to the terminal by restore and prune: a record carrying escape
  # sequences could rewrite what the prune prompt shows. Invalid records are
  # simply not offered.
  validate_profile_name "$profile" 2>/dev/null || return 1
  case "$src" in *[[:cntrl:]]*) return 1 ;; esac
  printf '%s %s' "$(bundle_name "$src")" "$profile"
}

# Rebuild the launcher for one orphaned profile directory from its restore
# record. Everything read from the record is checked as if typed on the
# command line: the profile name is validated, the app must be a real
# Chromium/Electron app and not one of our launchers, and the directory must
# sit inside the data root.
restore_one() {
  local dir="$1" profile src bid found label badge hex
  if ! data_is_ours "$dir"; then
    warn "Skipping $dir — it is outside the aidentity data folder."
    return 1
  fi
  profile=$(record_get "$dir" "$MARKER_KEY") || { warn "Cannot read the restore record in $dir"; return 1; }
  validate_profile_name "$profile" || return 1
  src=$(record_get "$dir" AIdentityTargetApp)
  bid=$(record_get "$dir" AIdentityTargetBundleID)
  case "$bid" in *[!A-Za-z0-9.-]*) bid="" ;; esac

  if [ ! -d "$src" ]; then
    # The app moved: look it up by name, then by bundle identifier — but only
    # inside the app folders. A Spotlight hit on a mounted installer or an
    # unpacked download would otherwise be handed this signed-in profile.
    found=$(refind_app "$src" || true)
    if [ -z "$found" ] && [ -n "$bid" ] && command -v mdfind >/dev/null 2>&1; then
      local hit dir
      while IFS= read -r hit; do
        [ -n "$hit" ] || continue
        while IFS= read -r dir; do
          case "$hit" in "${dir%/}"/*) found="$hit"; break ;; esac
        done <<EOF
$(app_search_dirs)
EOF
        [ -n "$found" ] && break
      done <<EOF
$(mdfind "kMDItemCFBundleIdentifier == '$bid'" 2>/dev/null)
EOF
    fi
    if [ -z "$found" ]; then
      warn "$(bundle_name "$src") is not installed any more. Reinstall it, then run this again."
      return 1
    fi
    info "  The app moved; using $found"
    src="$found"
  fi
  src=$(resolve_target_app "$src") || return 1

  label="$(bundle_name "$src") $profile"
  if [ -e "$APPS_DIR/$label.app" ]; then
    warn "There is already something at $APPS_DIR/$label.app — remove or rename it first."
    return 1
  fi
  socket_path_ok "$src" "$dir" "$label" restore || return 1

  badge=$(first_char "$(record_get "$dir" AIdentityBadge)")
  hex=$(color_hex "$(record_get "$dir" AIdentityColor)" 2>/dev/null) \
    || hex=$(color_hex "$(auto_color "$label")")

  # The record's launch settings go through build_launcher's checks like any.
  build_launcher "$src" "$profile" "$dir" "$label" "$badge" "$hex" "" \
    "$(filter_extras "$(extras_of "$dir/$RESTORE_RECORD")" "$src" "")" || return 1
  ok "Restored ${C_BOLD}$label${C_RESET} — it opens the same profile folder as before."
}

cmd_restore() {
  local want="" all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --all|-a) all=1; shift ;;
      -*) die "Unknown option for restore: $1" ;;
      *) [ -z "$want" ] && want="$1" || die "Unexpected argument: $1"; shift ;;
    esac
  done
  [ -n "$want" ] && [ "$all" -eq 1 ] && die "Give a name or --all, not both."

  local dirs=() labels=() d label
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    label=$(restore_label "$d") || continue
    dirs+=("$d"); labels+=("$label")
  done <<EOF
$(orphan_dirs)
EOF

  if [ "${#dirs[@]}" -eq 0 ]; then
    info "Nothing to restore — every profile with a restore record has a launcher."
    [ -z "$want" ] && [ "$all" -eq 0 ] && return 0
    return 1
  fi

  local i=0
  if [ -z "$want" ] && [ "$all" -eq 0 ]; then
    info "${C_BOLD}Profiles whose launcher is gone, and can be rebuilt:${C_RESET}"
    info ""
    while [ "$i" -lt "${#dirs[@]}" ]; do
      printf '  %-28s %s\n' "${labels[$i]}" "$(dim "${dirs[$i]}")"
      i=$((i+1))
    done
    info ""
    dim "  One:  aidentity restore \"${labels[0]}\"      All:  aidentity restore --all"
    return 0
  fi

  local matched=0 failed=0
  while [ "$i" -lt "${#dirs[@]}" ]; do
    if [ "$all" -eq 1 ] || [ "$(lower "${labels[$i]}")" = "$(lower "$want")" ]; then
      matched=$((matched+1))
      restore_one "${dirs[$i]}" || failed=$((failed+1))
    fi
    i=$((i+1))
  done
  [ "$matched" -gt 0 ] || die "No restorable profile named '$want'. Run 'aidentity restore' to see them."
  [ "$failed" -eq 0 ]
}

cmd_prune() {
  local yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) yes=1; shift ;;
      -*) die "Unknown option for prune: $1" ;;
      *) die "Unexpected argument: $1" ;;
    esac
  done

  [ -d "$DATA_ROOT" ] || { info "No profile data directory yet — nothing to prune."; return 0; }

  local orphans=() d n=0 label
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    orphans+=("$d"); n=$((n+1))
  done <<EOF
$(orphan_dirs)
EOF

  if [ "$n" -eq 0 ]; then
    ok "No orphaned profile data — every directory belongs to a launcher."
    return 0
  fi

  info "${C_BOLD}Profile data with no launcher pointing at it:${C_RESET}"
  info ""
  local restorable=0
  for d in "${orphans[@]}"; do
    printf '  %-10s %s\n' "$(human_bytes "$d")" "$(basename "$d")"
    dim "             $d"
    if label=$(restore_label "$d"); then
      dim "             can be restored: aidentity restore \"$label\""
      restorable=$((restorable+1))
    fi
  done
  info ""
  if [ "$restorable" -gt 0 ]; then
    info "To keep an account, restore it first — then it is no longer listed here."
    info ""
  fi
  dim "  This is what is left when a launcher is deleted in Finder, or removed with"
  dim "  'aidentity rm' without --purge. Launchers were looked for in $APPS_DIR"
  dim "  (and folders inside it), in the app folders and through Spotlight. If you"
  dim "  keep a launcher anywhere else, its account is listed here: do not delete it."
  info ""

  if [ "$yes" -eq 0 ]; then
    local reply; reply=$(ask "Delete $n orphaned profile(s)? Type yes to confirm: ") \
      || die "Nothing to confirm with."
    [ "$reply" = "yes" ] || die "Cancelled. Nothing was deleted."
  fi

  local removed=0
  for d in "${orphans[@]}"; do
    if running_on_profile "$d"; then
      warn "Skipping $(basename "$d") — something is running on it."
      continue
    fi
    if ! data_is_ours "$d"; then
      warn "Skipping $(basename "$d") — outside the aidentity data root."
      continue
    fi
    if rm -rf "$d"; then removed=$((removed+1)); else warn "Could not remove $d"; fi
  done
  ok "Removed $removed orphaned profile(s)."
}

# Rebuild one launcher from what its Info.plist records. Profile data is never
# touched. Returns non-zero, after saying why, if it could not be rebuilt.
# Shared by `rebuild` and `doctor --fix`.
rebuild_one() {
  local app="$1" label src_app profile data_dir badge hex kind="" found
  label=$(bundle_name "$app")
  src_app=$(plist_get "$app" "AIdentityTargetApp")
  profile=$(plist_get "$app" "$MARKER_KEY")
  data_dir=$(plist_get "$app" "AIdentityDataDir")
  is_main_launcher "$app" && kind="main"
  hex=$(launcher_color "$app" "$label")

  if [ ! -d "$src_app" ]; then
    # The app moved or was uninstalled. Try to find it again by name before
    # giving up, which covers the common /Applications -> ~/Applications move.
    found=$(refind_app "$src_app" || true)
    if [ -n "$found" ]; then
      info "  $label: target moved, now $found"
      src_app="$found"
    else
      warn "$label: target app is missing and could not be found again:"
      dim  "    $src_app"
      return 1
    fi
  fi

  # Only now, with the app found: a 1.0.0 launcher's badge is worked out by
  # comparing its icon with the app's, which fails against a path that moved.
  badge=$(launcher_badge "$app" "$src_app" "$profile")
  if is_legacy_launcher "$app"; then
    info "  $label: built by aidentity 1.0.0 — badge and colour restored to its defaults."
    dim  "    A colour or letter you picked yourself back then: aidentity set \"$label\" --color …"
  fi

  if ! build_launcher "$src_app" "$profile" "$data_dir" "$label" "$badge" "$hex" "$kind" \
       "$(filter_extras "$(extras_of "$app/Contents/Info.plist")" "$src_app" "$kind")"; then
    warn "$label: rebuild failed."
    return 1
  fi
  return 0
}

cmd_rebuild() {
  local want="" all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --all|-a) all=1; shift ;;
      -*) die "Unknown option for rebuild: $1" ;;
      *) [ -z "$want" ] && want="$1" || die "Unexpected argument: $1"; shift ;;
    esac
  done
  [ -n "$want" ] || [ "$all" -eq 1 ] \
    || die "Usage: aidentity rebuild \"<profile>\"   or   aidentity rebuild --all"

  local targets=() app
  if [ "$all" -eq 1 ]; then
    for app in "$APPS_DIR"/*.app; do
      [ -d "$app" ] || continue
      is_our_launcher "$app" && targets+=("$app")
    done
    [ "${#targets[@]}" -gt 0 ] || { info "No profiles to rebuild."; return 0; }
  else
    app=$(launcher_for "$want") || exit 1
    targets+=("$app")
  fi

  local done_n=0 failed=0
  for app in "${targets[@]}"; do
    if rebuild_one "$app"; then done_n=$((done_n+1)); else failed=$((failed+1)); fi
  done

  info ""
  [ "$done_n" -gt 0 ] && ok "Rebuilt $done_n launcher(s)."
  dim "  Profile data was not touched — every account stays signed in."
  # A failure is a failure: this printed a green tick and exited 0 even when
  # nothing could be rebuilt, so a script never noticed.
  if [ "$failed" -gt 0 ]; then
    warn "$failed launcher(s) could not be rebuilt."
    return 1
  fi
  return 0
}

# ---------------------------------------------------------------- update --
#
# `aidentity update` is the only code in this script that uses the network.
# It asks GitHub which release is the latest and, unless --check was given,
# downloads that release's bin/aidentity and SHA256SUMS and puts the new script
# in place of this one. Every check below must pass first; any failure leaves
# the old file exactly as it was. It never runs sudo and never downgrades.

# x.y.z, each part 1 to 9 digits. The cap keeps the compare below inside
# bash's 64-bit arithmetic, where a longer part wraps round to a small number.
# The case test goes first: it refuses a newline, which a regex might not.
is_version() {
  local re='^[0-9]{1,9}\.[0-9]{1,9}\.[0-9]{1,9}$'
  case "$1" in ''|*[!0-9.]*) return 1 ;; esac
  [[ $1 =~ $re ]]
}

# A release tag: v, then x.y.z, and nothing else. The tag arrives from the
# network, and it is checked before it goes into a URL or onto the screen: a
# "/" or ".." could steer the download elsewhere, and an escape sequence could
# rewrite the terminal.
is_release_tag() {
  case "$1" in v*) is_version "${1#v}" ;; *) return 1 ;; esac
}

version_newer() { # a, b (both x.y.z) -> true when a is newer than b
  local a b i
  IFS=. read -r -a a <<<"$1"
  IFS=. read -r -a b <<<"$2"
  # 10#: a part like "08" is not octal.
  for i in 0 1 2; do
    [ "$((10#${a[i]}))" -gt "$((10#${b[i]}))" ] && return 0
    [ "$((10#${a[i]}))" -lt "$((10#${b[i]}))" ] && return 1
  done
  return 1
}

# Where releases come from: the GitHub API for the latest tag, raw files for
# the download. AIDENTITY_UPDATE_URL replaces both, for tests only: the release
# is then read from "$it/releases/latest" and the files from "$it/<tag>/…". It
# must be HTTPS, and every run that uses it says so on screen.
update_sources() {
  local o="${AIDENTITY_UPDATE_URL:-}"
  UPDATE_API="https://api.github.com/repos/PiniShv/aidentity"
  UPDATE_RAW="https://raw.githubusercontent.com/PiniShv/aidentity"
  [ -n "$o" ] || return 0
  o="${o%/}"
  case "$o" in
    https://?*) ;;
    *) die "AIDENTITY_UPDATE_URL must start with https://. It is meant for tests only." ;;
  esac
  case "$o" in
    *..*|*[!A-Za-z0-9._~:/-]*)
      die "AIDENTITY_UPDATE_URL may hold only letters, numbers and . _ ~ : / -, and no \"..\"." ;;
  esac
  warn "Using AIDENTITY_UPDATE_URL ($o) instead of GitHub. It is meant for tests only."
  UPDATE_API="$o"; UPDATE_RAW="$o"
}

# One HTTPS download into a file. -q must stay the FIRST argument: it stops
# curl from reading the user's .curlrc, where a line like "insecure" would turn
# off certificate checks and "output" would send the file somewhere else. A
# proxy set in the environment (https_proxy) still works. -f makes an HTTP
# error a failure instead of a saved error page. --proto already holds every
# transfer, redirects included, to HTTPS; --proto-redir says the same for
# redirects in plain words, so the rule does not rest on curl's defaults.
# Into a file, never a pipe, so curl's own exit status is what gets checked.
# This is the only place the script runs curl; scripts/guards.sh checks that.
update_fetch() { # url, output file, max bytes, [extra curl options]
  local url="$1" out="$2" max="$3"
  shift 3
  curl -q -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 \
       --connect-timeout 10 --max-time 60 --retry 2 --max-filesize "$max" \
       "$@" -o "$out" "$url"
}

# The tag of the latest release, from the API's JSON. grep, because jq is not
# on a stock Mac. Text in the release notes cannot pose as this key: a quote
# inside a JSON string is always escaped, so it never matches '"tag_name"'.
latest_tag() { # json file
  local tag
  tag=$(grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' "$1" 2>/dev/null | head -n 1 \
        | sed 's/.*"\([^"]*\)"$/\1/')
  is_release_tag "$tag" || return 1
  printf '%s' "$tag"
}

# The real file behind this running copy: symlinks followed (a Homebrew link
# points into its Cellar) and its folder resolved with cd -P. Fails when there
# is no file — the script came in on stdin — or when the file found does not
# carry this copy's version line, so update never replaces anything else.
self_real_path() {
  local p="$SELF_PATH" link d n=0
  [ -n "$p" ] && [ -e "$p" ] || return 1
  while [ -L "$p" ]; do
    n=$((n+1)); [ "$n" -le 40 ] || return 1
    link=$(readlink "$p") || return 1
    case "$link" in /*) p="$link" ;; *) p="$(dirname "$p")/$link" ;; esac
  done
  [ -f "$p" ] || return 1
  d=$(command cd -P "$(dirname "$p")" 2>/dev/null && pwd -P) || return 1
  p="${d%/}/$(basename "$p")"
  [ -f "$p" ] && [ ! -L "$p" ] || return 1
  grep -qxF "AIDENTITY_VERSION=\"$AIDENTITY_VERSION\"" "$p" 2>/dev/null || return 1
  printf '%s' "$p"
}

# Homebrew keeps its own record of what it installed. Replacing its file
# behind its back makes that record wrong, so brew must do the update. Its
# files live in a Cellar, and everything under /opt/homebrew is brew's.
# /usr/local is skipped as a prefix: the installer puts copies there too, and
# brew's own files there are in /usr/local/Cellar, which the first test sees.
brew_owns() { # real path, path as started
  local p pre
  for p in "$1" "$2"; do
    case "$p" in */Cellar/*|/opt/homebrew/*) return 0 ;; esac
    for pre in "${HOMEBREW_PREFIX:-}" "${HOMEBREW_CELLAR:-}"; do
      pre="${pre%/}"
      case "$pre" in ''|/usr/local) continue ;; esac
      case "$p" in "$pre"/*) return 0 ;; esac
    done
  done
  return 1
}

# A copy inside the source code (bin/aidentity beside install.sh) belongs to
# git or to whoever unpacked it, not to this command. Prints the folder.
source_root() { # real path
  local bin root
  bin=$(dirname "$1"); root=$(dirname "$bin")
  [ "$(basename "$bin")" = "bin" ] && [ -f "$root/install.sh" ] \
    && [ -f "$root/uninstall.sh" ] && [ -f "$root/LICENSE" ] || return 1
  printf '%s' "$root"
}

# The version a copy of the script says it is: its first version line, read
# from the file and never by running it, as install.sh reads it.
file_version() {
  sed -n 's/^AIDENTITY_VERSION="\([^"]*\)"$/\1/p' "$1" 2>/dev/null | head -n 1
}

# A path as the user should type it: quoted only when it has to be.
typed_path() {
  case "$1" in *[!A-Za-z0-9/._+-]*) shquote "$1" ;; *) printf '%s' "$1" ;; esac
}

# Whether this user can replace the file: write access to its folder, and in a
# sticky folder (like /tmp) the file or the folder must be theirs too.
can_replace() { # file
  local dir; dir=$(dirname "$1")
  [ -w "$dir" ] || return 1
  [ ! -k "$dir" ] || [ -O "$1" ] || [ -O "$dir" ]
}

# Check a downloaded script before it may replace this one. The checksum is
# required: no checksum file, no line for bin/aidentity, or a mismatch, and
# nothing is installed. The rest are the installer's own checks.
#
# What it expects is fixed for every release to come, because copies already
# installed run this exact code: the files at <tag>/bin/aidentity and
# <tag>/SHA256SUMS, a "<64 hex>  bin/aidentity" line in SHA256SUMS, one
# AIDENTITY_VERSION="x.y.z" line, and main "$@" as the last line. A release
# that changes any of these can never be installed by `aidentity update`.
# scripts/guards.sh checks all of them.
update_verify() { # file, checksum file, version
  local f="$1" want got first ver last
  want=$(awk '$2 == "bin/aidentity" { print $1; exit }' "$2" 2>/dev/null)
  case "$want" in
    *[!0-9a-f]*|'') want="" ;;
  esac
  if [ "${#want}" -ne 64 ]; then
    warn "The checksum file has no valid line for bin/aidentity, so the download cannot be checked."
    return 1
  fi
  got=$(shasum -a 256 "$f" 2>/dev/null | awk '{print $1}')
  if [ "$got" != "$want" ]; then
    warn "Checksum mismatch: the download is not the published file.
    expected ${want}
    got      ${got:-(none)}"
    return 1
  fi
  first=$(head -n 1 "$f")
  case "$first" in
    '#!'*) ;;
    *) warn "The download is not a script (it does not start with #!)."; return 1 ;;
  esac
  ver=$(file_version "$f")
  if [ "$ver" != "$3" ]; then
    warn "The download does not say it is version $3."
    return 1
  fi
  "${BASH:-/bin/bash}" -n "$f" 2>/dev/null || { warn "The download is not valid shell."; return 1; }
  # A script cut short is often still valid shell; only its last line proves
  # the whole file arrived. The same line install.sh checks.
  last=$(awk 'NF { l = $0 } END { sub(/[ \t\r]+$/, "", l); print l }' "$f")
  # shellcheck disable=SC2016  # the literal text of the last line
  [ "$last" = 'main "$@"' ] || { warn "The download does not end with aidentity's last line, so it may be cut off."; return 1; }
  return 0
}

cmd_update() {
  local check=0 real="" how="" root="" hint tag new dir sum tmp
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check=1; shift ;;
      -*) die "Unknown option for update: $1" ;;
      *) die "Unexpected argument: $1" ;;
    esac
  done

  command -v curl >/dev/null 2>&1 || die "aidentity update needs curl, and it was not found."
  is_version "$AIDENTITY_VERSION" || die "This copy has no usable version number, so it cannot compare versions."

  # Who should update this copy. Settled before any network call, so a copy
  # that is not ours to replace is refused without contacting anything.
  real=$(self_real_path) || real=""
  if [ -n "$real" ] && brew_owns "$real" "$SELF_PATH"; then
    how="brew"; hint="brew upgrade aidentity"
  elif [ -n "$real" ] && root=$(source_root "$real"); then
    how="source"
    if [ -e "$root/.git" ]; then hint="git -C $(typed_path "$root") pull"
    else hint="download the new release from https://github.com/PiniShv/aidentity"; fi
  else
    hint="aidentity update"
  fi

  if [ "$check" -eq 0 ]; then
    case "$how" in
      brew) die "This copy of aidentity is managed by Homebrew, so Homebrew must update it:
    brew upgrade aidentity" ;;
      source) die "This copy runs from the aidentity source code in $root.
    Update the source code instead: $hint" ;;
    esac
    [ -n "$real" ] || die "Could not find the file this aidentity runs from, so there is nothing to replace.
    Run it by its full path, for example: /usr/local/bin/aidentity update"
  fi

  update_sources
  tmp="${TMPDIR:-/tmp}"
  UPDATE_TMP=$(mktemp -d "${tmp%/}/aidentity-update.XXXXXX" 2>/dev/null) \
    || { UPDATE_TMP=""; die "Could not create a temporary folder."; }

  info "Checking for the latest release of aidentity …"
  update_fetch "$UPDATE_API/releases/latest" "$UPDATE_TMP/release.json" 1048576 \
      -H 'Accept: application/vnd.github+json' \
    || die "Could not get the latest release from GitHub (curl's reason is above).
    Check your internet connection, or try again later. Nothing was changed."
  tag=$(latest_tag "$UPDATE_TMP/release.json") \
    || die "GitHub's answer did not name a valid release (a tag like v1.4.0). Nothing was changed."
  new="${tag#v}"

  if ! version_newer "$new" "$AIDENTITY_VERSION"; then
    if version_newer "$AIDENTITY_VERSION" "$new"; then
      # Never a downgrade: a build newer than the release stays as it is.
      ok "aidentity $AIDENTITY_VERSION is newer than the latest release ($new). Nothing to update."
    else
      ok "aidentity $AIDENTITY_VERSION is up to date."
    fi
    return 0
  fi

  if [ "$check" -eq 1 ]; then
    info "$AIDENTITY_VERSION → $new is available."
    dim "  What changed: https://github.com/PiniShv/aidentity/releases/tag/$tag"
    dim "  To update:    $hint"
    return 0
  fi

  # No sudo here, ever. Say what to run, and let the user decide.
  if ! can_replace "$real"; then
    die "$AIDENTITY_VERSION → $new is available, but you cannot replace $real.
    aidentity does not use sudo. To update, run this yourself:
      sudo $(typed_path "$real") update"
  fi

  info "Downloading aidentity $new …"
  update_fetch "$UPDATE_RAW/$tag/bin/aidentity" "$UPDATE_TMP/aidentity" 4194304 \
    || die "Could not download aidentity $new. Nothing was changed."
  update_fetch "$UPDATE_RAW/$tag/SHA256SUMS" "$UPDATE_TMP/SHA256SUMS" 65536 \
    || die "Could not download the checksum file for $new, so the download cannot be checked.
    Nothing was changed."
  update_verify "$UPDATE_TMP/aidentity" "$UPDATE_TMP/SHA256SUMS" "$new" \
    || die "Refusing to install it. Nothing was changed."
  sum=$(shasum -a 256 "$UPDATE_TMP/aidentity" | awk '{print $1}')
  dim "  checksum verified"

  # Write beside the old file, then move it into place in one step. mv swaps
  # the directory entry, so a half-written file is never seen as aidentity, and
  # the copy running now keeps reading its old file to the end. mktemp, not a
  # fixed name: in a shared folder a fixed name can be planted as a symlink.
  dir=$(dirname "$real")
  info "Installing to $real …"
  UPDATE_STAGED=$(mktemp "$dir/.aidentity-update.XXXXXX" 2>/dev/null) \
    || { UPDATE_STAGED=""; die "Could not write to $dir. Nothing was changed."; }
  cat "$UPDATE_TMP/aidentity" > "$UPDATE_STAGED" && chmod 755 "$UPDATE_STAGED" \
    || die "Could not write the new version to $dir. Nothing was changed."
  [ "$(shasum -a 256 "$UPDATE_STAGED" | awk '{print $1}')" = "$sum" ] \
    || die "The copy written to $dir does not match the download. Nothing was changed."
  # -h: never follow a link at the destination. /bin/mv by full path, because
  # -h is BSD-only and a GNU mv first on PATH rejects it.
  /bin/mv -fh "$UPDATE_STAGED" "$real" \
    || die "Could not replace $real. Nothing was changed."
  UPDATE_STAGED=""

  [ -f "$real" ] && [ ! -L "$real" ] && [ "$(file_version "$real")" = "$new" ] \
    || die "The update did not leave version $new at $real. Check that file, then run the installer again."

  ok "Updated $AIDENTITY_VERSION → $new"
  printf '   %s\n' "$real"
  info ""
  info "Your launchers keep working. To rebuild them with the new version, run:"
  info "  aidentity doctor --fix"
  return 0
}

# -------------------------------------------------------------------- ui --
#
# `aidentity ui` is a full-screen menu over the commands above. It decides
# nothing about changing a profile: every action calls the same command
# function the command line calls, so every safety check stays where it is.
# What follows is terminal handling and drawing.
#
# Three things about bash 3.2 shaped it. `read -t` takes whole seconds. On a
# timeout it returns 1, the same status as end of input, so the two are told
# apart by how long the read took. And a trap runs while `read` waits, which is
# why a resize can redraw at once.

UI_ESC=$'\033'
# The colours `set --color` takes by name, in the order the picker shows them.
UI_COLORS="blue green orange purple teal pink red yellow gray graphite"

UI_ACTIVE=0     # 1 while the menu owns the terminal: alternate screen, no echo
UI_BUSY=0       # 1 while a command runs for the menu
UI_HOLD=0       # 1 while rows or a frame are built: a resize must not draw then
UI_RESIZED=0
UI_STOPPED=0    # 1 after Ctrl-Z took the terminal back: it is entered again on resume
UI_SIG=""       # 143 or 129 once TERM or HUP arrived: the loop then ends
UI_DIRTY=1
UI_STTY=""      # the terminal settings to put back
UI_ROWS=24
UI_COLS=80
UI_HDR=2        # header lines, rule included
UI_LH=1         # list lines
UI_NH=1         # key hint lines
UI_NW=12        # width of the name column
UI_HL=()        # the key hint lines
UI_RULE=""
UI_SPACES=""
UI_FRAME=""
UI_KEY=""
UI_PEND=""      # keys read ahead of the one being handled
UI_ANS=""       # the answer to the last question asked
UI_MSG=""       # the footer message line: a result, or a question
UI_MSG_STYLE=""
UI_SWATCH=""    # a colour shown before the message, as a 256-colour number
UI_FLASH_AT=0
UI_LAST=0       # SECONDS at the last refresh
UI_WANT=""      # the launcher to select after the next load
UI_N=0
UI_SEL=0
UI_TOP=0
UI_RUNNING=0
UI_MAXNAME=0
UI_DIRSIG=""
UI_STATSIG=""
UI_L_APP=(); UI_L_NAME=(); UI_L_TARGET=(); UI_L_DATA=(); UI_L_MAIN=()
UI_L_BADGE=(); UI_L_IDX=(); UI_L_STATUS=()

# Escape sequences for the alternate screen and the cursor. tput knows them for
# this terminal; the xterm ones stand in when it does not.
ui_caps() {
  UI_SMCUP=""; UI_RMCUP=""; UI_CIVIS=""; UI_CNORM=""
  if command -v tput >/dev/null 2>&1; then
    UI_SMCUP=$(tput smcup 2>/dev/null) || UI_SMCUP=""
    UI_RMCUP=$(tput rmcup 2>/dev/null) || UI_RMCUP=""
    UI_CIVIS=$(tput civis 2>/dev/null) || UI_CIVIS=""
    UI_CNORM=$(tput cnorm 2>/dev/null) || UI_CNORM=""
  fi
  [ -n "$UI_SMCUP" ] || UI_SMCUP="${UI_ESC}[?1049h"
  [ -n "$UI_RMCUP" ] || UI_RMCUP="${UI_ESC}[?1049l"
  [ -n "$UI_CIVIS" ] || UI_CIVIS="${UI_ESC}[?25l"
  [ -n "$UI_CNORM" ] || UI_CNORM="${UI_ESC}[?25h"
  # Colour is on when the script's own colours are. With NO_COLOR nothing here
  # writes a colour or any other style: the arrow marks the selected row.
  if [ -n "$C_RESET" ]; then
    UI_REV="${UI_ESC}[7m"; UI_NOREV="${UI_ESC}[27m"; UI_GREY="${UI_ESC}[90m"
  else
    UI_REV=""; UI_NOREV=""; UI_GREY=""
  fi
}

# Take the terminal over. UI_ACTIVE goes up first, so a signal that lands half
# way through still puts everything back.
#
# Ctrl-Z is handled here in two ways, because the terminal sends its stop
# signal to every process of the job, not only to this one. While the menu is
# up, the key is turned into a plain byte (susp undef) that ui_key reads and
# acts on: no process gets a signal, so none can be stopped alone while this
# script waits for it. At a question or in a command's output the terminal is
# as the user had it, Ctrl-Z stops the whole job, and the TSTP handler must not
# be set (a question is asked in a subshell, which would stop alone). So the
# handler is set here and removed in ui_leave; it is left for a stop signal that
# is sent to the menu by hand.
ui_enter() {
  UI_ACTIVE=1
  trap 'ui_on_tstp' TSTP
  stty -echo susp undef 2>/dev/null
  printf '%s%s%s[2J%s[H' "$UI_SMCUP" "$UI_CIVIS" "$UI_ESC" "$UI_ESC"
}

# Give it back exactly as it was found. Safe to call twice, and from a trap.
ui_leave() {
  [ "$UI_ACTIVE" -eq 1 ] || return 0
  UI_ACTIVE=0
  printf '%s%s%s' "$C_RESET" "$UI_CNORM" "$UI_RMCUP"
  if [ -n "$UI_STTY" ]; then
    stty "$UI_STTY" 2>/dev/null || stty sane 2>/dev/null
  else
    stty sane 2>/dev/null
  fi
  trap - TSTP
  return 0
}

ui_size() {
  local out r c
  out=$(stty size 2>/dev/null) || out=""
  r=${out%% *}; c=${out##* }
  case "$r$c" in ''|*[!0-9]*) r=0; c=0 ;; esac
  # A terminal that reports no size (0 0) gets what terminfo says, then 24x80.
  if [ "$r" -lt 1 ] || [ "$c" -lt 1 ]; then
    r=$(tput lines 2>/dev/null) || r=24
    c=$(tput cols 2>/dev/null) || c=80
    case "$r$c" in ''|*[!0-9]*) r=24; c=80 ;; esac
  fi
  UI_ROWS=$r; UI_COLS=$c
}

# Six hex digits -> UI_IDX, the nearest colour of the 256-colour cube. Plain
# 256-colour codes, because Terminal.app does not draw 24-bit ones.
ui_idx256() {
  UI_IDX=""
  case "$1" in
    [0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]) ;;
    *) return 1 ;;
  esac
  local r g b
  r=$((16#${1:0:2})); g=$((16#${1:2:2})); b=$((16#${1:4:2}))
  UI_IDX=$((16 + 36 * ((r * 5 + 127) / 255) + 6 * ((g * 5 + 127) / 255) + (b * 5 + 127) / 255))
}

# $1 cut to $2 columns, with "…" where it was cut, and padded to exactly $2.
# Control characters become "?": a name comes off the disk, and an escape
# sequence in it must not reach the screen. Width is the character count, so it
# is exact for ASCII; a cut is made by cut(1) in a UTF-8 locale so it never
# splits a character.
ui_fit() { # text, width -> UI_FIT
  local s="$1" w="$2" n pad
  [ "$w" -ge 0 ] || w=0
  s=${s//[[:cntrl:]]/?}
  n=${#s}
  if [ "$n" -gt "$w" ]; then
    if [ "$w" -le 1 ]; then
      s=${s:0:$w}; n=${#s}
    else
      s=$(printf '%s' "$s" | LC_ALL=en_US.UTF-8 cut -c1-$((w - 1)) 2>/dev/null)
      s="${s}…"; n=$w
    fi
  fi
  pad=$((w - n)); [ "$pad" -ge 0 ] || pad=0
  UI_FIT="$s${UI_SPACES:0:$pad}"
}

# Append one screen line to the frame being built: move there, write, clear
# the rest of the line.
ui_put() { # row, text
  UI_FRAME="$UI_FRAME${UI_ESC}[$1;1H$2${UI_ESC}[K"
}

# The key hints, packed into as many lines as the width needs. A narrow
# window shows only the keys that matter; ? lists the rest.
ui_pack_hints() {
  local width=$((UI_COLS - 2)) line="" lw=0 key kw label iw
  UI_HL=()
  if [ "$UI_COLS" -lt 60 ]; then
    set -- "↑↓" 2 move Enter 5 open "?" 1 help q 1 quit
  else
    set -- "↑↓" 2 move Enter 5 open a 1 add r 1 rename c 1 colour b 1 badge \
      d 1 remove x 1 doctor "?" 1 help q 1 quit
  fi
  while [ $# -ge 3 ]; do
    key=$1; kw=$2; label=$3; shift 3
    iw=$((kw + 1 + ${#label}))
    if [ "$lw" -gt 0 ] && [ $((lw + 2 + iw)) -gt "$width" ]; then
      UI_HL[${#UI_HL[@]}]=$line; line=""; lw=0
    fi
    if [ "$lw" -gt 0 ]; then line="$line  "; lw=$((lw + 2)); fi
    line="$line${C_BOLD}${key}${C_RESET} ${C_DIM}${label}${C_RESET}"
    lw=$((lw + iw))
  done
  UI_HL[${#UI_HL[@]}]=$line
  UI_NH=${#UI_HL[@]}
}

# Work out the screen: header, list and footer sizes from the window size.
ui_layout() {
  local n=0 rule=""
  printf -v UI_SPACES '%*s' "$((UI_COLS + 4))" ''
  while [ "$n" -lt $((UI_COLS - 2)) ]; do rule="${rule}─"; n=$((n + 1)); done
  UI_RULE=" ${C_DIM}${rule}${C_RESET}"
  ui_pack_hints
  # The title and the counts share a line when they fit, else take two.
  if [ "$UI_COLS" -ge $((40 + ${#AIDENTITY_VERSION})) ]; then UI_HDR=2; else UI_HDR=3; fi
  UI_LH=$((UI_ROWS - UI_HDR - 1 - UI_NH))
}

ui_resize() { ui_size; ui_layout; UI_DIRTY=1; }

# Keep the selected row on screen.
ui_clamp() {
  local lh=$UI_LH
  [ "$lh" -ge 1 ] || lh=1
  [ "$UI_SEL" -lt "$UI_N" ] || UI_SEL=$((UI_N - 1))
  [ "$UI_SEL" -ge 0 ] || UI_SEL=0
  [ "$UI_SEL" -ge "$UI_TOP" ] || UI_TOP=$UI_SEL
  [ "$UI_SEL" -lt $((UI_TOP + lh)) ] || UI_TOP=$((UI_SEL - lh + 1))
  [ "$UI_TOP" -le $((UI_N - lh)) ] || UI_TOP=$((UI_N - lh))
  [ "$UI_TOP" -ge 0 ] || UI_TOP=0
}

# What every launcher is doing now. The process lists are read once for all the
# rows: reading them again for each row took longer than the time between two
# refreshes once there were a dozen profiles. The facts go to the same
# status_word that `list` uses. Warnings go nowhere: one on this screen would
# be written over the menu.
ui_status_rows() {
  local i=0 s sig="" pglist pgrc ids pslist="" ps_read=0 run has present
  UI_RUNNING=0
  pglist=$(pgrep -afl "user-data-dir=" 2>/dev/null); pgrc=$?
  ids="|"; [ "$pgrc" -gt 1 ] || ids=$(proc_dir_ids "$pglist")
  while [ "$i" -lt "$UI_N" ]; do
    run=0; has=0; present=0
    if [ "${UI_L_MAIN[$i]}" = "1" ]; then
      if [ "$ps_read" -eq 0 ]; then pslist=$(ps -axww -o command= 2>/dev/null) || pslist=""; ps_read=1; fi
      main_running "${UI_L_TARGET[$i]}" "$pslist" && run=1
    else
      profile_has_data "${UI_L_DATA[$i]}" && has=1
      running_in_list "${UI_L_DATA[$i]}" "$pgrc" "$pglist" "$ids" && run=1
    fi
    [ -d "${UI_L_TARGET[$i]}" ] && present=1
    s=$(status_word "${UI_L_MAIN[$i]}" "$present" "$run" "$has")
    UI_L_STATUS[i]=$s
    [ "$s" = "running" ] && UI_RUNNING=$((UI_RUNNING + 1))
    sig="$sig|$s"
    i=$((i + 1))
  done
  UI_STATSIG=$sig
}

# Read every launcher: what never changes while the menu is open (name, badge,
# colour, app, folder), then its status. The launcher that was selected stays
# selected, or UI_WANT if that is set.
ui_load() {
  local app label target data profile badge hex keep="" n=0 i=0
  UI_HOLD=1
  if [ -n "$UI_WANT" ]; then
    keep=$UI_WANT
  elif [ "$UI_N" -gt 0 ] && [ "$UI_SEL" -lt "$UI_N" ]; then
    keep=${UI_L_NAME[$UI_SEL]}
  fi
  UI_WANT=""; UI_DIRSIG=""; UI_MAXNAME=0
  UI_L_APP=(); UI_L_NAME=(); UI_L_TARGET=(); UI_L_DATA=(); UI_L_MAIN=()
  UI_L_BADGE=(); UI_L_IDX=(); UI_L_STATUS=()
  for app in "$APPS_DIR"/*.app; do
    UI_DIRSIG="$UI_DIRSIG|$app"
    [ -d "$app" ] || continue
    is_our_launcher "$app" || continue
    label=${app##*/}; label=${label%.app}
    target=$(plist_get "$app" AIdentityTargetApp)
    data=$(plist_get "$app" AIdentityDataDir)
    profile=$(plist_get "$app" "$MARKER_KEY")
    UI_L_MAIN[n]=0
    if is_main_launcher "$app"; then UI_L_MAIN[n]=1; data=""; fi
    badge=$(launcher_badge "$app" "$target" "$profile")
    [ "${#badge}" -le 1 ] || badge=$(first_char "$badge")
    hex=$(launcher_color "$app" "$label")
    ui_idx256 "$hex" || true
    UI_L_APP[n]=$app; UI_L_NAME[n]=$label; UI_L_TARGET[n]=$target
    UI_L_DATA[n]=$data; UI_L_BADGE[n]=${badge//[[:cntrl:]]/?}; UI_L_IDX[n]=$UI_IDX
    [ "${#label}" -le "$UI_MAXNAME" ] || UI_MAXNAME=${#label}
    n=$((n + 1))
  done
  UI_N=$n
  if [ -n "$keep" ]; then
    while [ "$i" -lt "$n" ]; do
      [ "${UI_L_NAME[$i]}" = "$keep" ] && { UI_SEL=$i; break; }
      i=$((i + 1))
    done
  fi
  ui_status_rows
  UI_HOLD=0
  UI_LAST=$SECONDS
  UI_DIRTY=1
}

# On a timer: load again if launchers came or went (a name list costs no
# process), else look at the statuses only.
ui_sync() {
  local sig="" a old=$UI_STATSIG
  for a in "$APPS_DIR"/*.app; do sig="$sig|$a"; done
  if [ "$sig" != "$UI_DIRSIG" ]; then ui_load; return 0; fi
  UI_HOLD=1; ui_status_rows; UI_HOLD=0
  [ "$UI_STATSIG" = "$old" ] || UI_DIRTY=1
  return 0
}

# One launcher's row, in UI_LINE. $2 is 1 for the selected row, which is
# marked with ▸ and shown in reverse video. Each coloured part ends by going
# back to that style, so the highlight is not cut in two.
ui_row() { # index, selected
  local i=$1 sel=$2 off="$C_RESET" mk=" " pre="" rev_off="" st nm bs ss dot dsty b used pad
  st=${UI_L_STATUS[$i]}
  if [ "$sel" -eq 1 ]; then off="$C_RESET$UI_REV"; mk="▸"; pre=$UI_REV; rev_off=$UI_NOREV; fi

  if [ "$st" = "running" ]; then dot="●"; dsty="$rev_off$C_GREEN"; else dot="○"; dsty="$rev_off$UI_GREY"; fi

  ui_fit "${UI_L_NAME[$i]}" "$UI_NW"; nm=$UI_FIT
  [ "$sel" -eq 1 ] && nm="${C_BOLD}${nm}${off}"

  case "$st" in
    running)       ss=$C_GREEN ;;
    "app missing") ss=$C_YELLOW ;;
    *)             ss=$C_DIM ;;
  esac
  if [ "$UI_COLS" -lt 60 ]; then
    [ "$st" = "signed out / new" ] && st="signed out"
    ui_fit "$st" 11; ss="${ss}${UI_FIT}${off}"
    UI_LINE="$pre $mk ${dsty}${dot}${off} ${nm}  $ss"
    used=$((18 + UI_NW))
  else
    ui_fit "$st" 16; ss="${ss}${UI_FIT}${off}"
    if [ "${UI_L_MAIN[$i]}" = "1" ]; then
      bs="original"
      [ -n "${UI_L_IDX[$i]}" ] && [ -n "$C_RESET" ] && bs="${rev_off}${UI_ESC}[38;5;${UI_L_IDX[$i]}moriginal${off}"
    elif [ -z "${UI_L_BADGE[$i]}" ]; then
      bs="${C_DIM}no badge${off}"
    else
      b=${UI_L_BADGE[$i]}
      if [ -n "${UI_L_IDX[$i]}" ] && [ -n "$C_RESET" ]; then
        bs="${rev_off}${UI_ESC}[48;5;${UI_L_IDX[$i]}m${UI_ESC}[1;97m ${b} ${off}     "
      else
        bs="[${b}]     "
      fi
    fi
    UI_LINE="$pre $mk ${dsty}${dot}${off} ${nm}  ${bs}  $ss"
    used=$((33 + UI_NW))
  fi
  # Fill a selected row to the edge, so the highlight is a bar.
  if [ "$sel" -eq 1 ]; then
    pad=$((UI_COLS - 1 - used)); [ "$pad" -ge 0 ] || pad=0
    UI_LINE="$UI_LINE${UI_SPACES:0:$pad}${C_RESET}"
  else
    UI_LINE="$UI_LINE${C_RESET}"
  fi
}

# Paint the whole screen in one write: no flicker, and a line is never
# cleared before it is rewritten. The window's last column is left empty so a
# full line cannot wrap.
ui_draw() {
  local title right pc rc rw gap r i end sel w nw mx below hint
  UI_HOLD=1
  # A resize that came while a frame was being built is taken up now.
  if [ "$UI_RESIZED" -eq 1 ]; then UI_RESIZED=0; ui_size; ui_layout; fi
  ui_clamp
  UI_FRAME=""
  if [ "$UI_COLS" -lt 22 ] || [ "$UI_LH" -lt 1 ]; then
    ui_fit "Window too small." $((UI_COLS - 1)); ui_put 1 "$UI_FIT"
    ui_fit "Press q to quit." $((UI_COLS - 1)); ui_put 2 "$UI_FIT"
    printf '%s%s[J' "$UI_FRAME" "$UI_ESC"
    UI_HOLD=0
    return 0
  fi
  w=$((UI_COLS - 1))

  title=" aidentity $AIDENTITY_VERSION"
  if [ "$UI_N" -eq 1 ]; then pc="1 profile"; else pc="$UI_N profiles"; fi
  rc="$UI_RUNNING running"
  right="$pc · $rc"                    # " · " is three columns
  if [ "$UI_HDR" -eq 2 ]; then
    rw=$((${#pc} + 3 + ${#rc}))
    gap=$((w - 1 - ${#title} - rw)); [ "$gap" -ge 1 ] || gap=1
    ui_put 1 "${C_BOLD}${title}${C_RESET}${UI_SPACES:0:$gap}${C_DIM}${right}${C_RESET}"
  else
    ui_put 1 "${C_BOLD}${title}${C_RESET}"
    ui_put 2 " ${C_DIM}${right}${C_RESET}"
  fi
  ui_put "$UI_HDR" "$UI_RULE"

  # The name column: as wide as the longest name, within what is left.
  if [ "$UI_COLS" -lt 60 ]; then mx=$((w - 18)); nw=4; else mx=$((w - 33)); nw=12; fi
  [ "$UI_MAXNAME" -le "$nw" ] || nw=$UI_MAXNAME
  [ "$nw" -le "$mx" ] || nw=$mx
  UI_NW=$nw

  r=$((UI_HDR + 1))
  if [ "$UI_N" -eq 0 ]; then
    ui_put "$r" " No profiles yet."
    ui_put $((r + 1)) " ${C_DIM}Press ${C_RESET}${C_BOLD}a${C_RESET}${C_DIM} to add one.${C_RESET}"
    r=$((r + 2))
  else
    i=$UI_TOP; end=$((UI_TOP + UI_LH)); [ "$end" -le "$UI_N" ] || end=$UI_N
    while [ "$i" -lt "$end" ]; do
      sel=0; [ "$i" -eq "$UI_SEL" ] && sel=1
      ui_row "$i" "$sel"; ui_put "$r" "$UI_LINE"
      r=$((r + 1)); i=$((i + 1))
    done
  fi
  while [ "$r" -le $((UI_HDR + UI_LH)) ]; do ui_put "$r" ""; r=$((r + 1)); done

  # The message line: a result or a question, else how much list is out of view.
  r=$((UI_HDR + UI_LH + 1))
  if [ -n "$UI_MSG" ]; then
    if [ -n "$UI_SWATCH" ] && [ -n "$C_RESET" ]; then
      ui_fit "$UI_MSG" $((w - 5)); ui_put "$r" " ${UI_ESC}[48;5;${UI_SWATCH}m   ${C_RESET} ${UI_MSG_STYLE}${UI_FIT}${C_RESET}"
    else
      ui_fit "$UI_MSG" $((w - 1)); ui_put "$r" " ${UI_MSG_STYLE}${UI_FIT}${C_RESET}"
    fi
  elif [ "$UI_TOP" -gt 0 ] || [ $((UI_TOP + UI_LH)) -lt "$UI_N" ]; then
    below=$((UI_N - UI_TOP - UI_LH)); [ "$below" -ge 0 ] || below=0
    hint=""
    [ "$UI_TOP" -eq 0 ] || hint="$UI_TOP more above"
    [ "$below" -eq 0 ] || hint="${hint:+$hint, }$below more below"
    ui_fit "$hint" $((w - 1))
    ui_put "$r" " ${C_DIM}${UI_FIT}${C_RESET}"
  else
    ui_put "$r" ""
  fi
  i=0
  while [ "$i" -lt "$UI_NH" ]; do
    r=$((r + 1)); ui_put "$r" " ${UI_HL[$i]}"; i=$((i + 1))
  done
  printf '%s' "$UI_FRAME"
  UI_HOLD=0
}

# Redraw from a signal handler, when it is safe to: not while a frame or the
# rows are being built, and not while a command has the terminal.
ui_redraw_now() {
  ui_resize
  [ "$UI_ACTIVE" -eq 1 ] && [ "$UI_HOLD" -eq 0 ] && [ "$UI_BUSY" -eq 0 ] || return 0
  UI_DIRTY=0
  ui_draw
}

ui_on_winch() {
  UI_RESIZED=1
  if [ "$UI_ACTIVE" -eq 1 ] && [ "$UI_HOLD" -eq 0 ] && [ "$UI_BUSY" -eq 0 ]; then
    UI_RESIZED=0
    ui_redraw_now
  fi
  return 0
}

# Ctrl-C quits the menu. While a command runs it only ends that command, which
# has stopped itself: back to the menu, not out of it.
ui_on_int() {
  [ "$UI_BUSY" -eq 1 ] && return 0
  ui_leave; _on_exit; exit 130
}

# Hand the terminal back and stop (the Ctrl-Z key, or a stop signal sent to the
# menu). Taking it again on `fg` is done by ui_resume, from ui_key, not here: a
# `read -t` that ran out while we were stopped jumps out of this handler as
# soon as it is continued, so nothing after the kill would run.
ui_on_tstp() {
  UI_STOPPED=$UI_ACTIVE
  ui_leave
  trap - TSTP
  kill -STOP $$
}

ui_resume() {
  [ "$UI_STOPPED" -eq 1 ] || return 0
  UI_STOPPED=0
  ui_enter
  ui_redraw_now
}

# Wait up to 2 seconds for a key. UI_KEY becomes UP, DOWN, LEFT, RIGHT, ENTER,
# ESC, EOF or TICK (nothing typed), or the character typed. An arrow key starts
# with the same byte as Esc, so after one the next two bytes are read too, one
# at a time (bash 3.2 drops a half-read pair on a timeout). It cannot wait for
# less than a second, so Esc on its own is slow. If what follows is not an
# arrow, it was a separate key; it is kept in UI_PEND.
ui_key() {
  local k="" b1="" b2="" rc=0 t0=$SECONDS
  if [ -n "$UI_PEND" ]; then
    k=${UI_PEND:0:1}; UI_PEND=${UI_PEND:1}
  else
    IFS= read -rsn1 -t 2 k || rc=$?
    [ "$UI_STOPPED" -eq 0 ] || ui_resume
    if [ "$rc" -ne 0 ]; then
      if [ "$rc" -gt 128 ] || [ $((SECONDS - t0)) -ge 2 ]; then UI_KEY=TICK; else UI_KEY=EOF; fi
      return 0
    fi
  fi
  case "$k" in
    ''|$'\r') UI_KEY=ENTER ;;
    $'\004')  UI_KEY=EOF ;;
    $'\032')  # Ctrl-Z, as a byte (see ui_enter). Stop; it is nothing typed.
      if [ "$UI_ACTIVE" -eq 1 ]; then ui_on_tstp; ui_resume; UI_KEY=TICK; else UI_KEY=$k; fi ;;
    "$UI_ESC")
      IFS= read -rsn1 -t 1 b1 || b1=""
      case "$b1" in
        '['|O)
          IFS= read -rsn1 -t 1 b2 || b2=""
          case "$b1$b2" in
            '[A'|OA) UI_KEY=UP ;;
            '[B'|OB) UI_KEY=DOWN ;;
            '[C'|OC) UI_KEY=RIGHT ;;
            '[D'|OD) UI_KEY=LEFT ;;
            *)       UI_KEY=OTHER ;;
          esac ;;
        '') UI_KEY=ESC ;;
        *)  UI_KEY=ESC; UI_PEND=$b1 ;;
      esac ;;
    *) UI_KEY=$k ;;
  esac
  return 0
}

ui_wait_key() { # until a key is typed
  while :; do ui_key; [ "$UI_KEY" = "TICK" ] || break; done
}

ui_pause() {
  printf '\n%sPress any key to return.%s' "$C_DIM" "$C_RESET"
  ui_wait_key
  printf '\n'
}

# Run a command function for the menu, as the command line would. In a
# subshell, so a `die` ends the command and not the menu; the script's own
# traps are set again inside it, so an interrupted rename still moves its data
# back and an unfinished build still removes its staging folder.
ui_run() {
  UI_BUSY=1
  (
    trap '_on_exit' EXIT
    trap '_on_exit; exit 130' INT
    trap '_on_exit; exit 143' TERM
    trap '_on_exit; exit 129' HUP
    "$@"
  )
  UI_BUSY=0
  return 0
}

# Leave the menu, run a command with its output and questions on the normal
# screen, wait for a key, and come back to a menu read again from disk.
ui_screen() { # command and its arguments
  ui_leave
  ui_run "$@"
  ui_pause
  ui_enter
  ui_load
}

# Ask a question on the normal screen. The answer is in UI_ANS, empty when
# nothing was typed, at end of input, or after Ctrl-C, which only cancels the
# question: it is asked in a subshell, like a command.
ui_ask() { # prompt
  UI_BUSY=1
  UI_ANS=$(ui_run ask "$1") || UI_ANS=""
  UI_BUSY=0
  printf '\n'
}

ui_flash() { # ok or err, text
  case "$1" in err) UI_MSG_STYLE=$C_RED ;; *) UI_MSG_STYLE=$C_GREEN ;; esac
  UI_MSG=$2; UI_SWATCH=""; UI_FLASH_AT=$SECONDS; UI_DIRTY=1
}

ui_msg_clear() { UI_MSG=""; UI_MSG_STYLE=""; UI_SWATCH=""; }

ui_move() { # -1 or 1
  UI_SEL=$((UI_SEL + $1))
  [ "$UI_SEL" -lt "$UI_N" ] || UI_SEL=$((UI_N - 1))
  [ "$UI_SEL" -ge 0 ] || UI_SEL=0
  UI_DIRTY=1
}

# Whether a launcher is selected; says so in the footer when there is none.
ui_have_row() {
  [ "$UI_N" -gt 0 ] && return 0
  ui_flash err "There is no profile yet. Press a to add one."
  return 1
}

# Enter. One line of result, so it goes in the footer instead of a screen.
ui_do_open() {
  local out rc
  ui_have_row || return 0
  UI_BUSY=1
  out=$(ui_run cmd_open "${UI_L_NAME[$UI_SEL]}" 2>&1); rc=$?
  UI_BUSY=0
  out=$(printf '%s' "$out" | sed "s/${UI_ESC}\[[0-9;]*m//g")
  out=${out//$'\n'/ }
  if [ -z "$out" ]; then out="Opened ${UI_L_NAME[$UI_SEL]}."; fi
  if [ "$rc" -eq 0 ]; then ui_flash ok "$out"; else ui_flash err "$out"; fi
}

ui_do_add() {
  local before="|" i=0
  while [ "$i" -lt "$UI_N" ]; do before="$before${UI_L_NAME[$i]}|"; i=$((i + 1)); done
  ui_screen cmd_add
  i=0
  while [ "$i" -lt "$UI_N" ]; do
    case "$before" in *"|${UI_L_NAME[$i]}|"*) ;; *) UI_SEL=$i; break ;; esac
    i=$((i + 1))
  done
}

ui_do_rename() {
  local name new
  ui_have_row || return 0
  name=${UI_L_NAME[$UI_SEL]}
  ui_leave
  printf 'Rename %s%s%s. The account stays signed in.\n\n' "$C_BOLD" "${name//[[:cntrl:]]/?}" "$C_RESET"
  while :; do
    ui_ask 'New account name (e.g. Work, Personal, Client). Empty to cancel: '
    new=$UI_ANS
    [ -n "$new" ] || break
    validate_profile_name "$new" && break
  done
  if [ -z "$new" ]; then ui_enter; ui_load; return 0; fi
  UI_WANT="$(bundle_name "${UI_L_TARGET[$UI_SEL]}") $new"
  ui_run cmd_rename "$name" "$new"
  ui_pause
  ui_enter
  ui_load
}

ui_do_badge() {
  local name ch
  ui_have_row || return 0
  name=${UI_L_NAME[$UI_SEL]}
  ui_leave
  printf 'Badge for %s%s%s.\n\n' "$C_BOLD" "${name//[[:cntrl:]]/?}" "$C_RESET"
  ui_ask 'One character for the icon badge. Empty to cancel: '
  ch=$UI_ANS
  if [ -z "$ch" ]; then ui_enter; ui_load; return 0; fi
  ui_run cmd_set "$name" --badge "$ch"
  ui_pause
  ui_enter
  ui_load
}

# The inline colour picker: left and right choose, Enter applies, Esc cancels.
ui_do_color() {
  local name hex n=0 i=0 cur=0 pick="" c
  ui_have_row || return 0
  name=${UI_L_NAME[$UI_SEL]}
  hex=$(launcher_color "${UI_L_APP[$UI_SEL]}" "$name")
  hex=$(lower "$hex")
  # shellcheck disable=SC2086  # a fixed list of words, split on purpose
  set -- $UI_COLORS
  n=$#
  for c in "$@"; do
    [ "$(lower "$(color_hex "$c")")" = "$hex" ] && cur=$i
    i=$((i + 1))
  done
  while :; do
    i=0
    for c in "$@"; do [ "$i" -eq "$cur" ] && pick=$c; i=$((i + 1)); done
    ui_idx256 "$(color_hex "$pick")" || true
    UI_SWATCH=$UI_IDX; UI_MSG_STYLE=$C_BOLD
    UI_MSG="Colour  < ${pick} >   Left and Right choose, Enter applies, Esc cancels"
    ui_draw
    ui_wait_key
    case "$UI_KEY" in
      LEFT)  cur=$(( (cur + n - 1) % n )) ;;
      RIGHT) cur=$(( (cur + 1) % n )) ;;
      ENTER) break ;;
      *)     pick=""; break ;;
    esac
  done
  ui_msg_clear; UI_DIRTY=1
  [ -n "$pick" ] || return 0
  ui_screen cmd_set "$name" --color "$pick"
}

# d: k removes the launcher and keeps the data, p deletes the data as well.
# Both end in `rm`, which refuses a running profile and, for p, asks for yes.
# k needs no yes: the data stays, and `restore` brings the launcher back.
ui_do_remove() {
  local name short opts room main=${UI_L_MAIN[$UI_SEL]:-0}
  ui_have_row || return 0
  name=${UI_L_NAME[$UI_SEL]}
  # The name is cut first, so a narrow window still shows the keys.
  room=$((UI_COLS - 70)); [ "$room" -ge 8 ] || room=8
  ui_fit "$name" $((${#name} < room ? ${#name} : room)); short=$UI_FIT
  UI_MSG_STYLE=$C_BOLD; UI_SWATCH=""
  if [ "$main" = "1" ]; then
    opts="k  remove the launcher only   Esc  cancel"
  else
    opts="k  keep the data   p  delete the data too   Esc  cancel"
  fi
  if [ "$UI_COLS" -ge 80 ]; then UI_MSG="Remove ${short}?   $opts"; else UI_MSG="$opts   ($short)"; fi
  ui_draw
  ui_wait_key
  ui_msg_clear; UI_DIRTY=1
  case "$UI_KEY" in
    k) ui_screen cmd_rm "$name" -y ;;
    p) if [ "$main" = "1" ]; then
         ui_flash err "A main launcher never deletes the app's data. Press d, then k, to remove it."
       else
         ui_screen cmd_rm "$name" --purge
       fi ;;
  esac
}

# x: the doctor's report. f then runs doctor --fix.
ui_do_doctor() {
  ui_leave
  ui_run cmd_doctor
  printf '\n%sPress f to repair what can be repaired (doctor --fix). Any other key returns.%s' "$C_DIM" "$C_RESET"
  ui_wait_key
  printf '\n'
  if [ "$UI_KEY" = "f" ]; then
    printf '\n'
    ui_run cmd_doctor --fix
    ui_pause
  fi
  ui_enter
  ui_load
}

ui_help() {
  local row=1 line key desc
  UI_HOLD=1
  UI_FRAME="${UI_ESC}[2J"
  ui_put 1 " ${C_BOLD}aidentity ui${C_RESET}"
  row=3
  while IFS='|' read -r key desc; do
    [ -n "$key" ] || continue
    [ "$row" -lt "$UI_ROWS" ] || break
    ui_fit "$desc" $((UI_COLS - 19)); line=$UI_FIT
    ui_fit "$key" 16
    ui_put "$row" " ${C_BOLD}${UI_FIT}${C_RESET} ${line}"
    row=$((row + 1))
  done <<EOF
Up, Down, k, j|move
Enter|open the profile
a|add a profile: pick an app, then name the account
r|rename the account name (it stays signed in)
c|colour: arrows choose, Enter applies, Esc cancels
b|badge: one character on the icon
d|remove: k keeps the data, p deletes it too
x|doctor report; f then repairs what it can
?|this help
q, Esc|quit
EOF
  ui_put $((UI_ROWS)) " ${C_DIM}Press any key to return.${C_RESET}"
  printf '%s' "$UI_FRAME"
  UI_HOLD=0
  ui_wait_key
  UI_DIRTY=1
}

ui_loop() {
  while :; do
    [ -z "$UI_SIG" ] || return 0
    if [ "$UI_RESIZED" -eq 1 ]; then UI_RESIZED=0; ui_resize; fi
    if [ $((SECONDS - UI_LAST)) -ge 2 ]; then UI_LAST=$SECONDS; ui_sync; fi
    if [ -n "$UI_MSG" ] && [ $((SECONDS - UI_FLASH_AT)) -ge 6 ]; then ui_msg_clear; UI_DIRTY=1; fi
    if [ "$UI_DIRTY" -eq 1 ]; then UI_DIRTY=0; ui_draw; fi
    ui_key
    [ -z "$UI_SIG" ] || return 0
    if [ "$UI_KEY" != "TICK" ] && [ -n "$UI_MSG" ]; then ui_msg_clear; UI_DIRTY=1; fi
    case "$UI_KEY" in
      TICK) ;;
      q|Q|ESC|EOF) return 0 ;;
      UP|k)   ui_move -1 ;;
      DOWN|j) ui_move 1 ;;
      ENTER)  ui_do_open ;;
      a)      ui_do_add ;;
      r)      ui_do_rename ;;
      c)      ui_do_color ;;
      b)      ui_do_badge ;;
      d)      ui_do_remove ;;
      x)      ui_do_doctor ;;
      '?')    ui_help ;;
    esac
  done
}

cmd_ui() {
  [ $# -eq 0 ] || die "Unexpected argument: $1  (ui takes no arguments)"
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    die "aidentity ui needs a terminal. In a script, use: aidentity list --json"
  fi
  case "${TERM:-}" in
    ''|dumb|unknown) die "aidentity ui needs a terminal that can move the cursor. Your TERM is '${TERM:-not set}'." ;;
  esac

  ui_caps
  UI_STTY=$(stty -g 2>/dev/null) || UI_STTY=""
  # Whatever ends us, the terminal is given back first. TERM and HUP only
  # note the signal: the menu waits in `read -s`, and bash puts back the
  # terminal mode it saved when that read began AFTER a trap that exits from
  # inside it, so exiting there left the terminal with echo off. bash 3.2 does
  # not cut the read short for these signals either, so the loop sees UI_SIG
  # within the 2 seconds of one read and leaves through the normal path below.
  # (INT is different: bash restores the terminal before the INT trap runs.)
  UI_SIG=""
  trap 'ui_leave; _on_exit' EXIT
  trap 'ui_on_int' INT
  trap 'UI_SIG=143' TERM
  trap 'UI_SIG=129' HUP
  trap 'ui_on_winch' WINCH

  ui_enter
  ui_size; ui_layout
  UI_LAST=$SECONDS
  # The first read takes a moment when there are many profiles.
  printf ' Reading the profiles…\n'
  ui_load
  ui_loop
  ui_leave

  trap - WINCH TSTP
  trap '_on_exit' EXIT
  trap '_on_exit; exit 130' INT
  trap '_on_exit; exit 143' TERM
  trap '_on_exit; exit 129' HUP
  # Ended by TERM or HUP: same exit status as before, terminal already back.
  [ -z "$UI_SIG" ] || exit "$UI_SIG"
  return 0
}

cmd_version() { printf 'aidentity %s\n' "$AIDENTITY_VERSION"; }

# ---------------------------------------------------------- command table --

# The one place that says which names reach which command. Dispatch, the help
# for one command and the completion scripts all read it, so an alias added here
# works everywhere. COMMAND_WORDS must list every plain name in this case (not
# the dashed ones, which are options); a test compares the two.
canonical_command() {
  case "$1" in
    setup|init|wizard)       printf 'setup' ;;
    add)                     printf 'add' ;;
    rename|mv)               printf 'rename' ;;
    set|modify|edit)         printf 'set' ;;
    prune)                   printf 'prune' ;;
    restore)                 printf 'restore' ;;
    rebuild|repair)          printf 'rebuild' ;;
    list|ls)                 printf 'list' ;;
    open)                    printf 'open' ;;
    rm|remove|delete)        printf 'rm' ;;
    apps)                    printf 'apps' ;;
    doctor)                  printf 'doctor' ;;
    update)                  printf 'update' ;;
    ui)                      printf 'ui' ;;
    completion)              printf 'completion' ;;
    version|--version|-v)    printf 'version' ;;
    help|--help|-h)          printf 'help' ;;
    *) return 1 ;;
  esac
}
COMMAND_WORDS="setup init wizard add rename mv set modify edit prune restore rebuild repair list ls open rm remove delete apps doctor update ui completion version help"

# The options a command accepts, for completion. Short spellings and --colour
# are left out on purpose: they work, but listing both spellings is noise. Every
# word here must also appear in the command's help; a test checks it.
command_options() {
  case "$1" in
    add)  printf '%s' '--profile --badge --color --no-badge --seed --main --arg --env --own-extensions' ;;
    set)  printf '%s' '--badge --color --no-badge --arg --env --clear-args --clear-env --own-extensions --shared-extensions' ;;
    list) printf '%s' '--json' ;;
    rm)   printf '%s' '--purge --yes' ;;
    prune) printf '%s' '--yes' ;;
    restore|rebuild) printf '%s' '--all' ;;
    doctor) printf '%s' '--fix' ;;
    update) printf '%s' '--check' ;;
    *) ;;
  esac
}

# Options that take the next word as their value, in every spelling. A
# completion script skips the value when it counts the arguments typed so far.
VALUE_OPTIONS="--profile -p --badge -b --color --colour -c --arg --env"

command_summary() {
  case "$1" in
    setup)      printf 'Guided walkthrough that sets up accounts' ;;
    add)        printf 'Create a profile for an app' ;;
    rename)     printf 'Rename a profile and keep it signed in' ;;
    set)        printf 'Change how a profile looks or starts' ;;
    prune)      printf 'Remove profile data that no launcher uses' ;;
    restore)    printf 'Rebuild a launcher that was deleted' ;;
    rebuild)    printf 'Rebuild launchers after an app moved or updated' ;;
    list)       printf 'Show every profile and what is running' ;;
    open)       printf 'Open a profile' ;;
    rm)         printf 'Remove a launcher' ;;
    apps)       printf 'List apps that can have extra accounts' ;;
    doctor)     printf 'Check the setup and every profile' ;;
    update)     printf 'Install the latest release' ;;
    ui)         printf 'Full-screen menu over your profiles' ;;
    completion) printf 'Print a tab-completion script' ;;
    version)    printf 'Print the version' ;;
    help)       printf 'Show help for all commands or for one' ;;
  esac
}

# --------------------------------------------------------- command help --

# The help of one command, by its canonical name. Reached by `aidentity help
# <command>` and by -h / --help after a command.
command_help() {
  case "$1" in
    setup) cat <<EOF
${C_BOLD}aidentity setup${C_RESET} — $(command_summary setup)

${C_BOLD}USAGE${C_RESET}
  aidentity setup

Asks which app to use and what to call each account, then builds all the
launchers in one pass. It needs a terminal. Without one, use 'aidentity add'.

Also spelled: init, wizard

${C_BOLD}EXAMPLES${C_RESET}
  aidentity setup
EOF
    ;;
    add) cat <<EOF
${C_BOLD}aidentity add${C_RESET} — $(command_summary add)

${C_BOLD}USAGE${C_RESET}
  aidentity add [APP] [options]

APP is the name of an installed Chromium or Electron app, such as Claude, or the
path to its .app. Run 'aidentity apps' to see which apps work. With no APP or no
--profile, add asks for them. That needs a terminal.

${C_BOLD}OPTIONS${C_RESET}
  -p, --profile NAME   Name for this account, e.g. Work
  -b, --badge X        One character for the icon badge (default: first letter)
  -c, --color NAME     Badge colour: blue green orange purple teal pink red
                       yellow gray graphite, or a hex value like 2E7DF6
  --no-badge           Use the app's own icon, with your name
  --seed               Copy Claude Desktop's MCP server config into the profile
  --main               Build a launcher for your ORIGINAL account (name: Main)
  --arg SWITCH         Pass a switch on every launch: a proxy, language,
                       display scale or GPU switch. Repeat to add more.
  --env NAME=VALUE     Set a proxy variable, LANG, LC_ALL, LC_CTYPE, LC_MESSAGES
                       or TZ on every launch. Repeat to add more.
  --own-extensions     VS Code, Cursor, Kiro: a separate extensions folder
  -h, --help           Show this help

${C_BOLD}EXAMPLES${C_RESET}
  aidentity add Claude --profile Work
  aidentity add Claude --profile Work --color blue --seed
  aidentity add Claude --main
EOF
    ;;
    rename) cat <<EOF
${C_BOLD}aidentity rename${C_RESET} — $(command_summary rename)

${C_BOLD}USAGE${C_RESET}
  aidentity rename OLD NEW

OLD is the launcher name that 'aidentity list' shows. NEW is the new profile
name, without the app name. The profile's data folder moves with it, so the
account stays signed in. It stops if the profile is running.

Also spelled: mv

${C_BOLD}OPTIONS${C_RESET}
  -h, --help           Show this help

${C_BOLD}EXAMPLES${C_RESET}
  aidentity rename "Claude Work" Client
EOF
    ;;
    set) cat <<EOF
${C_BOLD}aidentity set${C_RESET} — $(command_summary set)

${C_BOLD}USAGE${C_RESET}
  aidentity set NAME [options]

NAME is the launcher name that 'aidentity list' shows. Give at least one option.
The account and its data are not touched.

Also spelled: modify, edit

${C_BOLD}OPTIONS${C_RESET}
  -c, --color NAME     New badge colour
  -b, --badge X        New badge character
  --no-badge           Use the app's own icon, unchanged
  --arg SWITCH         Add a launch switch, as on add (repeatable)
  --env NAME=VALUE     Add a launch variable, as on add (repeatable)
  --clear-args         Remove every launch switch
  --clear-env          Remove every launch variable
  --own-extensions     VS Code, Cursor, Kiro: a separate extensions folder
  --shared-extensions  Go back to the app's own extensions folder
  -h, --help           Show this help

${C_BOLD}EXAMPLES${C_RESET}
  aidentity set "Claude Work" --color purple
  aidentity set "Claude Work" --arg --lang=de
EOF
    ;;
    prune) cat <<EOF
${C_BOLD}aidentity prune${C_RESET} — $(command_summary prune)

${C_BOLD}USAGE${C_RESET}
  aidentity prune [options]

Finds profile folders that no launcher points at. They are left when a launcher
is deleted in Finder, or removed with 'rm' without --purge. It lists them and
asks before it deletes anything. Deleting cannot be undone. To get a launcher
back instead, use 'aidentity restore'.

${C_BOLD}OPTIONS${C_RESET}
  -y, --yes            Skip the confirmation prompt
  -h, --help           Show this help

${C_BOLD}EXAMPLES${C_RESET}
  aidentity prune
EOF
    ;;
    restore) cat <<EOF
${C_BOLD}aidentity restore${C_RESET} — $(command_summary restore)

${C_BOLD}USAGE${C_RESET}
  aidentity restore [NAME | --all]

Each profile folder keeps a small record of its launcher. restore reads it and
rebuilds the launcher, still signed in. With no NAME and no --all, it lists the
profiles that can be restored.

${C_BOLD}OPTIONS${C_RESET}
  -a, --all            Restore every one of them
  -h, --help           Show this help

${C_BOLD}EXAMPLES${C_RESET}
  aidentity restore
  aidentity restore "Claude Work"
  aidentity restore --all
EOF
    ;;
    rebuild) cat <<EOF
${C_BOLD}aidentity rebuild${C_RESET} — $(command_summary rebuild)

${C_BOLD}USAGE${C_RESET}
  aidentity rebuild NAME
  aidentity rebuild --all

Writes the launcher again from what it records. Profile data is not touched,
so every account stays signed in.

Also spelled: repair

${C_BOLD}OPTIONS${C_RESET}
  -a, --all            Rebuild every profile
  -h, --help           Show this help

${C_BOLD}EXAMPLES${C_RESET}
  aidentity rebuild "Claude Work"
  aidentity rebuild --all
EOF
    ;;
    list) cat <<EOF
${C_BOLD}aidentity list${C_RESET} — $(command_summary list)

${C_BOLD}USAGE${C_RESET}
  aidentity list [options]

For each profile it shows the app, the profile name, where its data lives and
its status: running, in use, signed out / new, app missing or not running.

Also spelled: ls

${C_BOLD}OPTIONS${C_RESET}
  --json               Print one JSON array instead, with an object for each
                       launcher, for scripts. Variables are listed by name,
                       never by value.
  -h, --help           Show this help

${C_BOLD}EXAMPLES${C_RESET}
  aidentity list
  aidentity ls --json
EOF
    ;;
    open) cat <<EOF
${C_BOLD}aidentity open${C_RESET} — $(command_summary open)

${C_BOLD}USAGE${C_RESET}
  aidentity open NAME

NAME is the launcher name that 'aidentity list' shows. Put it in quotes when it
has a space.

${C_BOLD}OPTIONS${C_RESET}
  -h, --help           Show this help

${C_BOLD}EXAMPLES${C_RESET}
  aidentity open "Claude Work"
EOF
    ;;
    rm) cat <<EOF
${C_BOLD}aidentity rm${C_RESET} — $(command_summary rm)

${C_BOLD}USAGE${C_RESET}
  aidentity rm NAME [options]

Removes the launcher and keeps its data, so 'aidentity restore' can bring it
back. It asks you to type yes first. It stops if the profile is running, and it
only removes launchers that aidentity built.

Also spelled: remove, delete

${C_BOLD}OPTIONS${C_RESET}
  --purge              Also delete the profile's data. This cannot be undone.
                       A main launcher has no profile data, so nothing more is
                       deleted for it.
  -y, --yes            Skip the confirmation prompt
  -h, --help           Show this help

${C_BOLD}EXAMPLES${C_RESET}
  aidentity rm "Claude Work"
  aidentity rm "Claude Work" --purge
EOF
    ;;
    apps) cat <<EOF
${C_BOLD}aidentity apps${C_RESET} — $(command_summary apps)

${C_BOLD}USAGE${C_RESET}
  aidentity apps

Lists the Chromium and Electron apps found in /Applications and ~/Applications.
Only these apps can run more than one account.

${C_BOLD}EXAMPLES${C_RESET}
  aidentity apps
EOF
    ;;
    doctor) cat <<EOF
${C_BOLD}aidentity doctor${C_RESET} — $(command_summary doctor)

${C_BOLD}USAGE${C_RESET}
  aidentity doctor [options]

Shows the macOS, aidentity and bash versions, whether the launcher folder can be
written, and any problem it finds in a profile. It only reports, unless you give
--fix.

${C_BOLD}OPTIONS${C_RESET}
  --fix                Repair what can be repaired: rebuild stale launchers
                       and make profile folders owner-only
  -h, --help           Show this help

${C_BOLD}EXAMPLES${C_RESET}
  aidentity doctor
  aidentity doctor --fix
EOF
    ;;
    update) cat <<EOF
${C_BOLD}aidentity update${C_RESET} — $(command_summary update)

${C_BOLD}USAGE${C_RESET}
  aidentity update [options]

Asks GitHub for the latest release. If it is newer, downloads it, checks it
against the release's checksum, and replaces this copy in one step. This is the
only command that uses the network, and only when you run it. It never uses
sudo. A copy installed with Homebrew is updated with: brew upgrade aidentity

${C_BOLD}OPTIONS${C_RESET}
  --check              Only say whether a newer release is out
  -h, --help           Show this help

${C_BOLD}EXAMPLES${C_RESET}
  aidentity update --check
  aidentity update
EOF
    ;;
    ui) cat <<EOF
${C_BOLD}aidentity ui${C_RESET} — $(command_summary ui)

${C_BOLD}USAGE${C_RESET}
  aidentity ui

A full-screen menu in Terminal: every profile, what is running, and keys to
open, add, rename, recolour, change the badge, remove, and run doctor. Each key
runs the same command you would type, with the same checks. It needs a
terminal; in a script, use the commands themselves or aidentity list --json.
Press ? in the menu for its keys, and q to leave.

${C_BOLD}OPTIONS${C_RESET}
  -h, --help           Show this help

${C_BOLD}EXAMPLES${C_RESET}
  aidentity ui
EOF
    ;;
    completion) cat <<EOF
${C_BOLD}aidentity completion${C_RESET} — $(command_summary completion)

${C_BOLD}USAGE${C_RESET}
  aidentity completion SHELL

SHELL is bash, zsh or fish. The script goes to standard output. It completes
commands, options, profile names, app names and colours. A name with a space
is quoted for you. Homebrew installs these scripts for you.

${C_BOLD}SET UP${C_RESET}
  bash   eval "\$(aidentity completion bash)"     in ~/.bashrc
  zsh    eval "\$(aidentity completion zsh)"      in ~/.zshrc, after compinit
  fish   aidentity completion fish | source      in ~/.config/fish/config.fish

${C_BOLD}EXAMPLES${C_RESET}
  aidentity completion zsh
EOF
    ;;
    version) cat <<EOF
${C_BOLD}aidentity version${C_RESET} — $(command_summary version)

${C_BOLD}USAGE${C_RESET}
  aidentity version

Also spelled: --version, -v

${C_BOLD}EXAMPLES${C_RESET}
  aidentity version
EOF
    ;;
    help) cat <<EOF
${C_BOLD}aidentity help${C_RESET} — $(command_summary help)

${C_BOLD}USAGE${C_RESET}
  aidentity help [COMMAND]
  aidentity COMMAND --help

With no COMMAND it shows every command. With one it shows that command's
options and examples. aidentity -h and aidentity --help show the same overview
as aidentity help, and ignore what comes after them. After a command, -h or
--help shows that command's help and does nothing else.

${C_BOLD}EXAMPLES${C_RESET}
  aidentity help
  aidentity help rm
  aidentity rm --help
EOF
    ;;
  esac
}

# aidentity help [command]
cmd_help_for() {
  [ $# -le 1 ] || die "Usage: aidentity help [command]"
  if [ $# -eq 0 ]; then cmd_help; return 0; fi
  local canon
  canon=$(canonical_command "$1") \
    || die "No help for '$1'. Run 'aidentity help' to see the commands."
  command_help "$canon"
}

# -------------------------------------------------------------- completion --

# `aidentity __complete WHAT` prints the candidates for one kind of word, one
# per line. The completion scripts call it on every Tab, so it prints nothing on
# stderr and always exits 0, whatever is wrong with the folders it reads.
cmd_complete() {
  ( complete_candidates "${1:-}" ) 2>/dev/null
  return 0
}

complete_candidates() {
  local app name dir label
  case "$1" in
    launchers)   # the names open, rm, set, rename and rebuild take
      for app in "$APPS_DIR"/*.app; do
        [ -d "$app" ] || continue
        is_our_launcher "$app" || continue
        name=$(bundle_name "$app")
        case "$name" in *[[:cntrl:]]*) continue ;; esac
        printf '%s\n' "$name"
      done ;;
    restorable)  # the names restore takes: profiles whose launcher is gone
      while IFS= read -r dir; do
        [ -n "$dir" ] || continue
        label=$(restore_label "$dir") || continue
        printf '%s\n' "$label"
      done <<EOF
$(orphan_dirs)
EOF
      ;;
    apps)        # the names add takes
      while IFS= read -r app; do
        [ -n "$app" ] || continue
        name=$(bundle_name "$app")
        case "$name" in *[[:cntrl:]]*) continue ;; esac
        printf '%s\n' "$name"
      done <<EOF | awk '!seen[$0]++'
$(list_compatible_apps)
EOF
      ;;
  esac
}

# The script goes to stdout. Names are embedded from the command table above,
# so a new command or alias reaches all three shells.
cmd_completion() {
  local shell=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -*) die "Unknown option for completion: $1" ;;
      *) [ -z "$shell" ] && shell="$1" || die "Unexpected argument: $1"; shift ;;
    esac
  done
  [ -n "$shell" ] || die "Usage: aidentity completion bash|zsh|fish"
  case "$shell" in
    bash) completion_bash ;;
    zsh)  completion_zsh ;;
    fish) completion_fish ;;
    *) die "Unknown shell '$shell'. Use bash, zsh or fish." ;;
  esac
}

# "<alias> <command>" for every alias, one per line.
command_aliases() {
  local w c
  for w in $COMMAND_WORDS; do
    c=$(canonical_command "$w")
    [ "$w" = "$c" ] || printf '%s %s\n' "$w" "$c"
  done
}

# The canonical command names, one per line.
command_names() {
  local w
  for w in $COMMAND_WORDS; do
    [ "$(canonical_command "$w")" = "$w" ] && printf '%s\n' "$w"
  done
}

# shellcheck disable=SC2016  # the generated script's $ signs are meant literally
completion_bash() {
  local w c o
  cat <<'EOF'
# bash completion for aidentity
#
#   eval "$(aidentity completion bash)"     # in ~/.bashrc
#
# It completes commands, options, profile names, app names and colours. The
# names come from 'aidentity __complete', which is not meant to be run by hand.

# _aidentity_escape QUOTE TEXT: set REPLY to TEXT as it can sit inside a QUOTE
# (" or ') the user has already opened. Inside double quotes ! cannot be
# escaped, so a name with one fails (return 1) and the caller leaves it out.
_aidentity_escape() {
  local q="$1" s="$2" c i=0
  REPLY=""
  while [ "$i" -lt "${#s}" ]; do
    c="${s:i:1}"
    if [ "$q" = "'" ]; then
      if [ "$c" = "'" ]; then c="'\\''"; fi
    else
      case "$c" in
        '!') REPLY=""; return 1 ;;
        '\'|'"'|'$'|'`') c="\\$c" ;;
      esac
    fi
    REPLY="$REPLY$c"
    i=$((i + 1))
  done
}

# _aidentity_unescape QUOTE TEXT: the reverse, for the part of the word that is
# typed already. Sets REPLY.
_aidentity_unescape() {
  local q="$1" s="$2" c i=0 n
  REPLY=""
  while [ "$i" -lt "${#s}" ]; do
    c="${s:i:1}"
    n=$((i + 1))
    if [ "$q" = "'" ]; then
      if [ "${s:i:4}" = "'\\''" ]; then c="'"; i=$((i + 3)); fi
    elif [ "$c" = '\' ]; then
      case "${s:n:1}" in
        '\'|'"'|'$'|'`') c="${s:n:1}"; i=$n ;;
        '') c="" ;;   # a backslash with nothing after it yet
      esac
    fi
    REPLY="$REPLY$c"
    i=$((i + 1))
  done
}

# _aidentity_reply WORD LIST: add every line of LIST that starts with WORD to
# COMPREPLY. A name is escaped for the shell. When WORD already starts with a
# quote, the name is escaped for that quote instead, so a $ or a quote mark in a
# folder name is never read by the shell as code.
_aidentity_reply() {
  local word="$1" line quote=""
  case "$word" in
    \"*) quote='"'; word="${word#\"}" ;;
    \'*) quote="'"; word="${word#\'}" ;;
    *)   word="${word//\\/}" ;;
  esac
  if [ -n "$quote" ]; then _aidentity_unescape "$quote" "$word"; word="$REPLY"; fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      "$word"*)
        if [ -z "$quote" ]; then
          COMPREPLY+=("$(printf '%q' "$line")")
        elif _aidentity_escape "$quote" "$line"; then
          COMPREPLY+=("$REPLY")
        fi ;;
    esac
  done <<< "$2"
}

_aidentity() {
  local IFS=$' \t\n'
  local cur="${COMP_WORDS[COMP_CWORD]}" cmd="" opts="" valopt="" w i npos=0
EOF
  printf '  local commands="%s"\n' "$COMMAND_WORDS"
  cat <<'EOF'
  COMPREPLY=()

  if [ "$COMP_CWORD" -le 1 ]; then
    case "$cur" in
      -*) COMPREPLY=($(compgen -W "-h --help -v --version" -- "$cur")) ;;
      *)  COMPREPLY=($(compgen -W "$commands" -- "$cur")) ;;
    esac
    return 0
  fi

  cmd="${COMP_WORDS[1]}"
  case "$cmd" in
EOF
  command_aliases | while read -r w c; do printf '    %s) cmd="%s" ;;\n' "$w" "$c"; done
  cat <<'EOF'
  esac

  # Count the arguments typed so far. An option's value is not an argument.
  i=2
  while [ "$i" -lt "$COMP_CWORD" ]; do
    w="${COMP_WORDS[i]}"
    case "$w" in
EOF
  printf '      %s)\n' "$(printf '%s' "$VALUE_OPTIONS" | tr ' ' '|')"
  cat <<'EOF'
        [ $((i + 1)) -eq "$COMP_CWORD" ] && valopt="$w"
        i=$((i + 1)) ;;
      -*) ;;
      *) npos=$((npos + 1)) ;;
    esac
    i=$((i + 1))
  done

  case "$valopt" in
    "") ;;
EOF
  printf '    --color|--colour|-c) COMPREPLY=($(compgen -W "%s" -- "$cur")) ;;\n' "$COLOR_NAMES"
  cat <<'EOF'
    *) ;;
  esac
  [ -z "$valopt" ] || return 0

  case "$cur" in
    -*)
      case "$cmd" in
EOF
  for c in $(command_names); do
    o=$(command_options "$c")
    [ -n "$o" ] && printf '        %s) opts="%s" ;;\n' "$c" "$o"
  done
  cat <<'EOF'
      esac
      COMPREPLY=($(compgen -W "$opts --help" -- "$cur"))
      return 0 ;;
  esac

  [ "$npos" -eq 0 ] || return 0
  case "$cmd" in
    add) _aidentity_reply "$cur" "$(aidentity __complete apps 2>/dev/null)" ;;
    open|rename|set|rebuild|rm) _aidentity_reply "$cur" "$(aidentity __complete launchers 2>/dev/null)" ;;
    restore) _aidentity_reply "$cur" "$(aidentity __complete restorable 2>/dev/null)" ;;
    completion) COMPREPLY=($(compgen -W "bash zsh fish" -- "$cur")) ;;
    help) COMPREPLY=($(compgen -W "$commands" -- "$cur")) ;;
  esac
  return 0
}

complete -F _aidentity aidentity
EOF
}

completion_zsh() {
  local w c o d
  cat <<'EOF'
#compdef aidentity
# zsh completion for aidentity
#
#   eval "$(aidentity completion zsh)"      # in ~/.zshrc, after compinit
#
# Or save the output as a file named _aidentity in a folder on your fpath.
# It completes commands, options, profile names, app names and colours. The
# names come from 'aidentity __complete', which is not meant to be run by hand.

_aidentity() {
  local cmd="" valopt="" i npos=0
  local -a names opts commands

  if (( CURRENT == 2 )); then
    if [[ $words[CURRENT] == -* ]]; then
      compadd -- -h --help -v --version
    else
      commands=(
EOF
  for c in $(command_names); do
    printf "        '%s:%s'\n" "$c" "$(command_summary "$c")"
  done
  command_aliases | while read -r w c; do printf "        '%s:Same as %s'\n" "$w" "$c"; done
  cat <<'EOF'
      )
      _describe -t commands 'aidentity command' commands
    fi
    return
  fi

  cmd=$words[2]
  case $cmd in
EOF
  command_aliases | while read -r w c; do printf '    %s) cmd="%s" ;;\n' "$w" "$c"; done
  cat <<'EOF'
  esac

  # Count the arguments typed so far. An option's value is not an argument.
  i=3
  while (( i < CURRENT )); do
    case $words[i] in
EOF
  printf '      %s)\n' "$(printf '%s' "$VALUE_OPTIONS" | tr ' ' '|')"
  cat <<'EOF'
        (( i + 1 == CURRENT )) && valopt=$words[i]
        i=$(( i + 1 )) ;;
      -*) ;;
      *) npos=$(( npos + 1 )) ;;
    esac
    i=$(( i + 1 ))
  done

  case $valopt in
    '') ;;
EOF
  printf '    --color|--colour|-c) compadd -- %s ;;\n' "$COLOR_NAMES"
  cat <<'EOF'
  esac
  [[ -z $valopt ]] || return

  if [[ $words[CURRENT] == -* ]]; then
    case $cmd in
EOF
  for c in $(command_names); do
    o=$(command_options "$c")
    [ -n "$o" ] && printf '      %s) opts=(%s) ;;\n' "$c" "$o"
  done
  cat <<'EOF'
    esac
    compadd -- $opts --help
    return
  fi

  (( npos == 0 )) || return
  case $cmd in
    add) names=("${(@f)$(command aidentity __complete apps 2>/dev/null)}") ;;
    open|rename|set|rebuild|rm) names=("${(@f)$(command aidentity __complete launchers 2>/dev/null)}") ;;
    restore) names=("${(@f)$(command aidentity __complete restorable 2>/dev/null)}") ;;
    completion) compadd -- bash zsh fish; return ;;
EOF
  printf '    help) compadd -- %s; return ;;\n' "$COMMAND_WORDS"
  cat <<'EOF'
    *) return ;;
  esac
  names=(${names:#})
  compadd -a names
}

if [[ $funcstack[1] == _aidentity ]]; then
  _aidentity "$@"
else
  compdef _aidentity aidentity
fi
EOF
}

completion_fish() {
  local w c o vo
  cat <<'EOF'
# fish completion for aidentity
#
#   aidentity completion fish | source      # in ~/.config/fish/config.fish
#
# Or save the output as ~/.config/fish/completions/aidentity.fish.
# It completes commands, options, profile names, app names and colours. The
# names come from 'aidentity __complete', which is not meant to be run by hand.

# The command typed so far, with an alias turned into the command it stands for.
function __aidentity_command
    set -l tokens (commandline -opc)
    test (count $tokens) -ge 2; or return 1
    switch $tokens[2]
EOF
  command_aliases | while read -r w c; do printf "        case %s\n            echo %s\n" "$w" "$c"; done
  cat <<'EOF'
        case '*'
            echo $tokens[2]
    end
end

function __aidentity_no_command
    test (count (commandline -opc)) -eq 1
end

function __aidentity_has_command
    test (count (commandline -opc)) -ge 2
end

# True when the command typed so far is one of the arguments.
function __aidentity_using
    set -l cmd (__aidentity_command)
    test -n "$cmd"; or return 1
    contains -- $cmd $argv
end

# True when no argument has been typed after the command yet. Options, and the
# value of an option that takes one, do not count.
function __aidentity_wants_name
    set -l tokens (commandline -opc)
    test (count $tokens) -ge 2; or return 1
    set -e tokens[1..2]
    set -l found 0
    set -l skip 0
    for t in $tokens
        if test $skip -eq 1
            set skip 0
            continue
        end
        switch $t
EOF
  vo=""
  for o in $VALUE_OPTIONS; do vo="$vo '$o'"; done
  printf '            case%s\n' "$vo"
  cat <<'EOF'
                set skip 1
            case '-*'
            case '*'
                set found 1
        end
    end
    test $found -eq 0
end

complete -c aidentity -f
EOF
  for c in $(command_names); do
    printf "complete -c aidentity -n __aidentity_no_command -a '%s' -d '%s'\n" "$c" "$(command_summary "$c")"
  done
  command_aliases | while read -r w c; do
    printf "complete -c aidentity -n __aidentity_no_command -a '%s' -d 'Same as %s'\n" "$w" "$c"
  done
  cat <<'EOF'
complete -c aidentity -n __aidentity_no_command -s h -l help -d 'Show help'
complete -c aidentity -n __aidentity_no_command -s v -l version -d 'Print the version'
complete -c aidentity -n __aidentity_has_command -l help -d 'Show help for this command'
EOF
  for c in $(command_names); do
    for o in $(command_options "$c"); do
      case "$o" in
        --color)   printf "complete -c aidentity -n '__aidentity_using %s' -s c -l color -x -a '%s'\n" "$c" "$COLOR_NAMES" ;;
        --profile) printf "complete -c aidentity -n '__aidentity_using %s' -s p -l profile -x\n" "$c" ;;
        --badge)   printf "complete -c aidentity -n '__aidentity_using %s' -s b -l badge -x\n" "$c" ;;
        --arg|--env) printf "complete -c aidentity -n '__aidentity_using %s' -l %s -x\n" "$c" "${o#--}" ;;
        *)         printf "complete -c aidentity -n '__aidentity_using %s' -l %s\n" "$c" "${o#--}" ;;
      esac
    done
  done
  cat <<'EOF'
complete -c aidentity -n '__aidentity_using add; and __aidentity_wants_name' -a '(aidentity __complete apps 2>/dev/null)'
complete -c aidentity -n '__aidentity_using open rename set rebuild rm; and __aidentity_wants_name' -a '(aidentity __complete launchers 2>/dev/null)'
complete -c aidentity -n '__aidentity_using restore; and __aidentity_wants_name' -a '(aidentity __complete restorable 2>/dev/null)'
complete -c aidentity -n '__aidentity_using completion; and __aidentity_wants_name' -a 'bash zsh fish'
EOF
  printf "complete -c aidentity -n '__aidentity_using help; and __aidentity_wants_name' -a '%s'\n" "$COMMAND_WORDS"
}

cmd_help() {
  cat <<EOF
${C_BOLD}aidentity${C_RESET} — run several accounts of the same Mac app at the same time.

${C_BOLD}USAGE${C_RESET}
  aidentity <command> [options]
  aidentity help <command>       Options and examples for one command.
                                 Same as: aidentity <command> --help

${C_BOLD}COMMANDS${C_RESET}
  setup                Guided walkthrough. Start here — it asks which app, what to
                       call each account, and sets them all up in one pass.

  ui                   Full-screen menu: every profile and what is running, with
                       a key to open, add, rename, recolour, badge or remove
                       each one. Needs a terminal. Press ? inside for the keys.

  add [app]            Create one profile directly.
      --profile NAME   Name for this account, e.g. Work
      --badge  X       Single character for the icon badge (default: first letter)
      --color  NAME    blue green orange purple teal pink red yellow gray graphite,
                       or a hex value like 2E7DF6
      --no-badge       Use the app's own icon unchanged, just with your name
      --seed           Copy Claude Desktop's MCP server config into the new profile
      --main           A launcher for your ORIGINAL account instead (name: Main).
                       While a profile runs, macOS treats it as the app itself,
                       so the app's own icon only switches to that profile.
      --arg SWITCH     Pass a switch every launch: --proxy-server=…, --lang=de,
                       --force-device-scale-factor=…, --disable-gpu (repeatable)
      --env NAME=VAL   Set a proxy variable, LANG, LC_ALL, LC_CTYPE, LC_MESSAGES
                       or TZ (repeatable)
      --own-extensions VS Code, Cursor, Kiro: a separate extensions folder

  list                 Show every profile, where its data lives, and what is running
                       Also spelled 'ls'.
      --json           Print one JSON array instead, an object per launcher, for
                       scripts. Variables are listed by name, never by value.
  open  NAME           Launch a profile

  rename OLD NEW       Rename a profile, moving its data so the account stays
                       signed in. Also spelled 'mv'.
  set   NAME           Change a profile's look without touching its account
      --color  NAME    New colour
      --badge  X       New badge character
      --no-badge       Use the app's own icon, unchanged
      --arg, --env, --own-extensions   As on add; --clear-args, --clear-env
                       and --shared-extensions undo them
  prune                Find profile data with no launcher pointing at it —
                       left when a launcher is deleted in Finder, or removed
                       with rm without --purge — and offer to remove it
      -y, --yes        Skip the confirmation prompt
  restore [NAME]       Rebuild the launcher of a profile whose launcher was
                       deleted, from the record kept in its data folder. With
                       no name, list the profiles that can be restored.
      --all            Restore every one of them
  rebuild NAME         Regenerate a launcher after the app moved or updated
      --all            Rebuild every profile
  rm    NAME           Remove a launcher (keeps its data). Also 'remove', 'delete'.
      --purge          Also delete the profile's data. Cannot be undone.
      -y, --yes        Skip the confirmation prompt
  apps                 List apps on this Mac that support extra accounts
  doctor               Check the setup and every profile, and report anything wrong
      --fix            Repair what can be repaired: rebuild stale launchers,
                       make profile folders owner-only
  completion SHELL     Print a tab-completion script for bash, zsh or fish
  update               Install the latest release from GitHub, after checking
                       its checksum. The only command that uses the network.
                       A Homebrew copy is updated with: brew upgrade aidentity
      --check          Only say whether a newer release is out
  version              Print the version
  help [COMMAND]       Show this help, or the help of one command

${C_BOLD}EXAMPLES${C_RESET}
  aidentity setup
  aidentity ui
  aidentity add Claude --profile Work --color blue --seed
  aidentity add ChatGPT --profile Personal
  aidentity add Claude --main
  aidentity list
  aidentity rename "Claude Work" Client
  aidentity set "Claude Work" --color purple
  aidentity rebuild --all
  aidentity doctor --fix
  aidentity restore "Claude Work"
  aidentity prune
  aidentity rm "Claude Work" --purge
  aidentity help rm
  aidentity completion zsh
  aidentity update --check

${C_BOLD}ENVIRONMENT${C_RESET}
  AIDENTITY_APPS_DIR    Where launchers are written (default: ~/Applications)
  AIDENTITY_DATA_ROOT   Where profile data lives (default:
                        ~/Library/Application Support/aidentity/profiles)
  AIDENTITY_APP_DIRS    Folders searched for apps, colon-separated
                        (default: /Applications:~/Applications)
  AIDENTITY_UPDATE_URL  For tests only: where update looks for releases
                        instead of GitHub. Must be https.

${C_BOLD}HOW IT WORKS${C_RESET}
  Chromium and Electron apps keep their single-instance lock inside their data
  directory. Point a second instance at a different directory and the two never
  see each other's lock, so both run at once — each signed into its own account.

  aidentity builds a small launcher app that does exactly that. Your real app is
  never copied, patched or re-signed, so its signature, keychain access and
  auto-update all keep working.

${C_BOLD}MORE${C_RESET}
  https://github.com/PiniShv/aidentity
EOF
}

# -------------------------------------------------------------- dispatch --

main() {
  local cmd="${1:-help}" canon a
  [ $# -gt 0 ] && shift
  # Hidden: the completion scripts call this on every Tab. It is not a command,
  # so it has no help and no unknown-command message, and it never fails.
  if [ "$cmd" = "__complete" ]; then cmd_complete "$@"; return 0; fi
  if ! canon=$(canonical_command "$cmd"); then
    printf '%sUnknown command: %s%s\n\n' "$C_RED" "$cmd" "$C_RESET" >&2; cmd_help >&2; exit 1
  fi
  # -h or --help anywhere after a command shows that command's help and runs
  # nothing else, whatever else was typed: `rm Work --help` removes nothing.
  # This runs before the command reads its arguments. A profile name cannot
  # start with a hyphen, so no real value is ever taken for it.
  if [ "$canon" != "help" ]; then
    for a in "$@"; do
      case "$a" in -h|--help) command_help "$canon"; return 0 ;; esac
    done
  fi
  case "$canon" in
    setup)   cmd_setup "$@" ;;
    add)     cmd_add "$@" ;;
    rename)  cmd_rename "$@" ;;
    set)     cmd_set "$@" ;;
    prune)   cmd_prune "$@" ;;
    restore) cmd_restore "$@" ;;
    rebuild) cmd_rebuild "$@" ;;
    list)    cmd_list "$@" ;;
    open)    cmd_open "$@" ;;
    rm)      cmd_rm "$@" ;;
    apps)    cmd_apps "$@" ;;
    doctor)  cmd_doctor "$@" ;;
    update)  cmd_update "$@" ;;
    ui)      cmd_ui "$@" ;;
    completion) cmd_completion "$@" ;;
    version) cmd_version ;;
    # `aidentity help [command]` names a command. A leading -h or --help is the
    # plain overview, as it always was, whatever follows it.
    help)    case "$cmd" in help) cmd_help_for "$@" ;; *) cmd_help ;; esac ;;
  esac
}

# Never change this line, and keep it last. install.sh and every installed
# copy's `aidentity update` refuse a download that does not end on it, and
# copies already out there keep their own fixed copy of it: a new last line
# would stop all of them from updating. scripts/guards.sh pins the exact text.
main "$@"
